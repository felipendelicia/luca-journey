# Conexión local (dev fuera de docker apunta al puerto host 5433 que publica
# shared-postgres con su override de dev; ver ../shared-postgres/README.md).
# Dentro de docker, la API usa el host `postgres` (alias en la red shared-db).
DATABASE_URL="postgres://luca:luca@localhost:5433/luca"
JWT_SECRET="cambiame-por-un-secreto-largo"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
FRONTEND_URL="http://localhost:4321/"
CORS_ORIGINS="http://localhost:4321"
PORT="3000"
