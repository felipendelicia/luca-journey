{
  "name": "pokedex-codex-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma web del curso Python con Pokémon (Astro)",
  "scripts": {
    "dev": "npm run prep && astro dev",
    "build": "node scripts/sync-ejercicios.mjs && node scripts/sync-proyectos.mjs && DEPLOY_BASE=/luca-journey astro build && rm -rf ../docs/astro",
    "preview": "astro preview",
    "prep": "node scripts/sync-ejercicios.mjs && node scripts/sync-proyectos.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-python": "^6.1.6",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.34.1",
    "astro": "^4.16.18",
    "codemirror": "^6.0.1",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
