---
import Base from '../layouts/Base.astro';
import pokemon from '../data/pokemon.json';
const nombres = Object.fromEntries(pokemon.map((p) => [p.id, p.nombre]));
---
<Base title="Amigos — Python con Pokémon" active="Amigos">
  <main class="wrap am-wrap">
    <h1>👥 Amigos</h1>

    <p class="social-login" id="am-login" hidden>Iniciá sesión (botón ☁️ arriba) y creá tu perfil en la <b>Liga</b> para usar amigos.</p>

    <div id="am-app" hidden>
      <p class="social-login" id="am-sinperfil" hidden>Primero elegí tu <b>@usuario</b> en la <a id="am-liga-link" href="#">Liga</a> para poder agregar y que te agreguen.</p>

      <section class="am-sec">
        <h2 class="liga-h">🔎 Buscar entrenadores</h2>
        <div class="social-row">
          <input id="am-q" placeholder="@usuario o nombre…" autocapitalize="off" />
          <button class="btn-sec" id="am-buscar" type="button">Buscar</button>
        </div>
        <div class="social-row" style="margin-top:.4rem">
          <span class="social-at">🎴</span>
          <input id="am-codigo" placeholder="CÓDIGO de amigo" maxlength="6" style="text-transform:uppercase" />
          <button class="btn-sec" id="am-add-codigo" type="button">Agregar por código</button>
        </div>
        <div class="am-lista" id="am-resultados"></div>
      </section>

      <section class="am-sec" id="am-solis-sec" hidden>
        <h2 class="liga-h">📨 Solicitudes <span class="reg-estado" id="am-solis-n"></span></h2>
        <div class="am-lista" id="am-solis"></div>
      </section>

      <section class="am-sec" id="am-ofertas-sec" hidden>
        <h2 class="liga-h">🔄 Intercambios pendientes</h2>
        <div class="am-lista" id="am-ofertas"></div>
      </section>

      <section class="am-sec">
        <h2 class="liga-h">🧑‍🤝‍🧑 Mis amigos <span class="reg-estado" id="am-amigos-n"></span></h2>
        <div class="am-lista" id="am-amigos"></div>
      </section>

      <section class="am-sec">
        <h2 class="liga-h">🏆 Ranking de entrenadores <span class="reg-estado" id="am-todos-n"></span></h2>
        <p class="liga-nota">Todos los entrenadores, ordenados por cantidad de Pokémon.</p>
        <div class="am-lista" id="am-todos"></div>
        <div class="am-pager" id="am-pager" hidden>
          <button class="btn-sec" id="am-prev" type="button">← Anterior</button>
          <span id="am-pag-info"></span>
          <button class="btn-sec" id="am-next" type="button">Siguiente →</button>
        </div>
      </section>
    </div>
    <p class="social-msg" id="am-msg"></p>
  </main>

  <script type="application/json" id="am-data" set:html={JSON.stringify({ nombres })}></script>
  <script>
    import { buscar, solicitar, responder, quitar, amigos, solicitudes, ofertas, responderOferta, cancelarOferta, listarPerfiles, misRelaciones, haySupabase } from '../lib/social.js';
    import { usuario, init as initNube, refrescarDesdeNube } from '../lib/nube.js';

    const D = JSON.parse(document.getElementById('am-data').textContent);
    const nombres = D.nombres;
    const $ = (id) => document.getElementById(id);
    const B = (window.__BASE || '/').replace(/\/$/, '');
    const sprite = (id, sh) => `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${sh ? 'shiny/' : ''}${id}.png`;
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const avSprite = (av) => av ? `<img src="${sprite(av)}" alt="" />` : '🎓';
    const msg = (t) => { $('am-msg').textContent = t; };
    const miHandle = () => (localStorage.getItem('liga:nombre') || '').toLowerCase();
    let relaciones = new Map();   // handle del otro -> estado (aceptada | pendiente)

    // Devuelve el nodo de acción para una fila: botón Agregar, o una etiqueta si ya hay
    // relación (o sos vos).
    function nodoAgregar(p) {
      const mio = miHandle();
      if (mio && p.handle === mio) { const s = document.createElement('span'); s.className = 'am-rel'; s.textContent = 'vos'; return s; }
      const est = relaciones.get(p.handle);
      if (est === 'aceptada') { const s = document.createElement('span'); s.className = 'am-rel amigo'; s.textContent = '✓ amigo'; return s; }
      if (est === 'pendiente') { const s = document.createElement('span'); s.className = 'am-rel'; s.textContent = '⏳ pendiente'; return s; }
      return btn('＋ Agregar', 'tr-aceptar', async (b) => {
        b.disabled = true;
        try { await solicitar({ handle: p.handle }); b.textContent = '✓ enviada'; }
        catch (e) { b.disabled = false; msg('⚠️ ' + (e.message || e)); }
      });
    }

    function fila(p, acciones) {
      const div = document.createElement('div');
      div.className = 'am-fila';
      div.innerHTML = `<div class="am-av">${avSprite(p.avatar)}</div>`
        + `<a class="am-info" href="${B}/u?h=${esc(p.handle)}"><b>${esc(p.nombre) || 'Entrenador/a'}</b><span>@${esc(p.handle)}</span></a>`;
      const acc = document.createElement('div'); acc.className = 'am-acc';
      acciones.forEach((a) => acc.appendChild(a));
      div.appendChild(acc);
      return div;
    }
    function btn(txt, cls, fn) {
      const b = document.createElement('button'); b.className = cls; b.textContent = txt; b.type = 'button';
      b.addEventListener('click', () => fn(b)); return b;
    }
    const nombreInst = (x) => (x.mote || nombres[x.id] || ('Nº ' + x.id)) + (x.shiny ? ' ✨' : '') + ' · Nv.' + (x.nivel ?? '?');
    const chips = (arr) => (arr && arr.length)
      ? arr.map((x) => `<span class="am-chip-i"><img class="am-chip" src="${sprite(x.id, x.shiny)}" alt="${esc(nombreInst(x))}" title="${esc(nombreInst(x))}" /><small>Nv.${x.nivel ?? '?'}${x.shiny ? ' ✨' : ''}</small></span>`).join('')
      : '<span class="tr-vacio">(nada)</span>';

    async function cargarResultados(lista) {
      const cont = $('am-resultados'); cont.innerHTML = '';
      if (!lista.length) { cont.innerHTML = '<p class="tr-colec-vacio">Sin resultados.</p>'; return; }
      lista.forEach((p) => cont.appendChild(fila(p, [nodoAgregar(p)])));
    }

    async function cargarSolicitudes() {
      let lista = [];
      try { lista = await solicitudes(); } catch {}
      $('am-solis-sec').hidden = lista.length === 0;
      $('am-solis-n').textContent = lista.length || '';
      const cont = $('am-solis'); cont.innerHTML = '';
      lista.forEach((p) => {
        const aceptar = btn('Aceptar', 'tr-aceptar', async () => { try { await responder(p.id, true); refrescarTodo(); } catch (e) { msg('⚠️ ' + e.message); } });
        const rechazar = btn('✕', 'tr-rechazar', async () => { try { await responder(p.id, false); refrescarTodo(); } catch (e) { msg('⚠️ ' + e.message); } });
        cont.appendChild(fila(p, [aceptar, rechazar]));
      });
    }

    async function cargarAmigos() {
      let lista = [];
      try { lista = await amigos(); } catch {}
      $('am-amigos-n').textContent = lista.length || '';
      const cont = $('am-amigos'); cont.innerHTML = '';
      if (!lista.length) { cont.innerHTML = '<p class="tr-colec-vacio">Todavía no tenés amigos. Buscá arriba. 👆</p>'; return; }
      lista.forEach((p) => {
        const ver = document.createElement('a'); ver.className = 'btn-sec'; ver.textContent = '🔄 Intercambiar'; ver.href = `${B}/u?h=${p.handle}`;
        const quita = btn('✕', 'tr-rechazar', async (b) => { b.disabled = true; try { await quitar(p.id); refrescarTodo(); } catch (e) { b.disabled = false; msg('⚠️ ' + e.message); } });
        cont.appendChild(fila(p, [ver, quita]));
      });
    }

    async function cargarOfertas() {
      let lista = [];
      try { lista = await ofertas(); } catch {}
      $('am-ofertas-sec').hidden = lista.length === 0;
      const cont = $('am-ofertas'); cont.innerHTML = '';
      lista.forEach((o) => {
        const div = document.createElement('div'); div.className = 'am-oferta';
        const quien = o.soy_de ? ('Le ofreciste a @' + esc(o.otro_handle)) : ('@' + esc(o.otro_handle) + ' te ofrece');
        // desde TU lado: das = (soy_de ? doy : pido) ; recibís = (soy_de ? pido : doy)
        const das = o.soy_de ? o.doy : o.pido;
        const recibis = o.soy_de ? o.pido : o.doy;
        div.innerHTML = `<div class="am-of-tit">${quien}</div>`
          + `<div class="am-of-trato"><div><span class="tr-lab">Das</span>${chips(das)}</div>`
          + `<div class="tr-vs">⇄</div><div><span class="tr-lab">Recibís</span>${chips(recibis)}</div></div>`;
        const acc = document.createElement('div'); acc.className = 'am-acc';
        if (o.soy_de) {
          acc.appendChild(btn('Cancelar', 'tr-rechazar', async (b) => { b.disabled = true; try { await cancelarOferta(o.id); refrescarTodo(); } catch (e) { b.disabled = false; msg('⚠️ ' + e.message); } }));
        } else {
          acc.appendChild(btn('Aceptar', 'tr-aceptar', async (b) => {
            b.disabled = true;
            try { await responderOferta(o.id, true); await refrescarDesdeNube(); msg('🎉 ¡Intercambio hecho! Tu colección se actualizó.'); refrescarTodo(); }
            catch (e) { b.disabled = false; msg('⚠️ ' + (e.message || e)); }
          }));
          acc.appendChild(btn('✕', 'tr-rechazar', async (b) => { b.disabled = true; try { await responderOferta(o.id, false); refrescarTodo(); } catch (e) { b.disabled = false; msg('⚠️ ' + e.message); } }));
        }
        div.appendChild(acc);
        cont.appendChild(div);
      });
    }

    const PAGE = 20; let pagU = 0;   // pager solo si hay > 20 entrenadores
    async function cargarTodos() {
      let lista = [];
      try { lista = await listarPerfiles(PAGE, pagU * PAGE); } catch {}
      const total = lista.length ? Number(lista[0].total) : 0;
      const cont = $('am-todos'); cont.innerHTML = '';
      $('am-todos-n').textContent = total || '';
      if (!lista.length) { cont.innerHTML = '<p class="tr-colec-vacio">No hay otros entrenadores todavía.</p>'; $('am-pager').hidden = true; return; }
      lista.forEach((p, i) => {
        const rank = pagU * PAGE + i + 1;
        const div = document.createElement('div'); div.className = 'am-fila';
        div.innerHTML = `<span class="am-rank">#${rank}</span><div class="am-av">${avSprite(p.avatar)}</div>`
          + `<a class="am-info" href="${B}/u?h=${esc(p.handle)}"><b>${esc(p.nombre) || '@' + esc(p.handle)}</b><span>@${esc(p.handle)} · 📕 ${p.pokes}</span></a>`;
        const acc = document.createElement('div'); acc.className = 'am-acc';
        acc.appendChild(nodoAgregar(p));
        div.appendChild(acc);
        cont.appendChild(div);
      });
      const paginas = Math.ceil(total / PAGE);
      $('am-pager').hidden = paginas <= 1;
      $('am-pag-info').textContent = (pagU + 1) + ' / ' + paginas;
      $('am-prev').disabled = pagU === 0;
      $('am-next').disabled = pagU >= paginas - 1;
    }
    $('am-prev').addEventListener('click', () => { if (pagU > 0) { pagU--; cargarTodos(); } });
    $('am-next').addEventListener('click', () => { pagU++; cargarTodos(); });

    async function refrescarTodo() {
      relaciones = await misRelaciones().catch(() => new Map());
      cargarSolicitudes(); cargarAmigos(); cargarOfertas(); cargarTodos();
    }

    $('am-buscar').addEventListener('click', async () => {
      const q = $('am-q').value.trim();
      if (q.length < 2) { msg('Escribí al menos 2 letras.'); return; }
      try { cargarResultados(await buscar(q)); } catch (e) { msg('⚠️ ' + e.message); }
    });
    $('am-q').addEventListener('keydown', (e) => { if (e.key === 'Enter') $('am-buscar').click(); });
    $('am-add-codigo').addEventListener('click', async () => {
      const codigo = $('am-codigo').value.trim().toUpperCase();
      if (codigo.length < 4) { msg('Código incompleto.'); return; }
      try { await solicitar({ codigo }); msg('✅ Solicitud enviada.'); $('am-codigo').value = ''; }
      catch (e) { msg('⚠️ ' + (e.message || e)); }
    });

    function estado() {
      if (!haySupabase) { $('am-login').hidden = false; return; }
      $('am-liga-link').href = B + '/liga';
      if (!usuario()) { $('am-login').hidden = false; $('am-app').hidden = true; return; }
      $('am-login').hidden = true; $('am-app').hidden = false;
      refrescarTodo();
    }
    if (haySupabase) initNube();
    window.addEventListener('nube:cambio', estado);
    estado();
  </script>
</Base>
