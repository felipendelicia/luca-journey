---
import Base from '../../layouts/Base.astro';
import datos from '../../data/ejercicios.json';
import proyectos from '../../data/proyectos.json';
import { u } from '../../lib/url.ts';

export function getStaticPaths() {
  return Object.values(proyectos).map((p) => ({
    params: { slug: p.slug },
    props: { proyecto: p },
  }));
}

const { proyecto } = Astro.props;
const temas = datos.map((w) => ({ slug: w.slug, region: w.region, ejercicios: w.ejercicios.map((e) => ({ id: e.id })) }));
---
<Base title={proyecto.titulo + ' — Proyectos'} active="Ejercicios">
  <div class="wrap">
    <main class="book ejer" style="max-width:820px; margin:0 auto;">
      <p class="ej-breadcrumb"><a href={u('/ejercicios')}>Ejercicios</a> · Líder de Gimnasio</p>
      <h1>🏟️ {proyecto.titulo}</h1>
      <p class="ej-prompt">{proyecto.intro}</p>

      <div id="proy-area"></div>

      <nav class="cap-nav" style="margin-top:2rem;">
        <a href={u('/ejercicios')}><span class="dir">← Volver</span><br />Todos los temas</a>
      </nav>
    </main>
  </div>

  <script type="application/json" id="proy-data" set:html={JSON.stringify({ proyecto, temas })}></script>
  <script is:inline src="https://cdn.jsdelivr.net/pyodide/v0.26.4/full/pyodide.js"></script>

  <script>
    import { editorPython } from '../../lib/editor.js';
    import runnerPy from '../../lib/runner.py?raw';
    import { sincronizar } from '../../lib/coleccion.js';
    import { sonarExito, sonarError } from '../../lib/sonidos.js';

    const D = JSON.parse(document.getElementById('proy-data').textContent);
    const { proyecto } = D;
    const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));

    // Claves de localStorage
    const KEY_PASO = (id) => 'proy:' + proyecto.slug + ':' + id;
    const KEY_PASO_OK = (id) => 'proy:' + proyecto.slug + ':' + id + ':ok';
    const KEY_PROY_OK = 'proy:' + proyecto.slug + ':ok';

    // Estado actual: primer paso sin :ok
    function pasoActualIdx() {
      for (let i = 0; i < proyecto.pasos.length; i++) {
        if (localStorage.getItem(KEY_PASO_OK(proyecto.pasos[i].id)) !== '1') return i;
      }
      return proyecto.pasos.length; // todos aprobados
    }

    // Construir código acumulado (preamble + pasos 0..N, el actual usa el editor)
    function codigoAcumulado(n, editorActual) {
      const partes = [proyecto.preamble];
      for (let i = 0; i <= n; i++) {
        const paso = proyecto.pasos[i];
        if (i === n) {
          partes.push(editorActual.state.doc.toString());
        } else {
          partes.push(localStorage.getItem(KEY_PASO(paso.id)) ?? paso.starter);
        }
      }
      return partes.join('\n\n');
    }

    // Pyodide singleton
    let pyReady = null, cargado = false;
    async function getPy() {
      if (!pyReady) {
        pyReady = (async () => {
          const py = await window.loadPyodide();
          const pkgs = proyecto.packages || [];
          if (pkgs.length) await py.loadPackage(['pytest', ...pkgs]);
          else await py.loadPackage(['pytest']);
          return py;
        })();
      }
      const py = await pyReady;
      if (!cargado) { await py.runPythonAsync(runnerPy); cargado = true; }
      return py;
    }

    // Render resultado de tests de un paso
    function renderResultado(box, tests, cargaError) {
      if (cargaError) {
        box.innerHTML = '<div class="ejer-err">⚠️ No se pudo ejecutar:<br><code>' + esc(cargaError) + '</code></div>';
        sonarError(); return false;
      }
      const tot = tests.length, ok = tests.filter((t) => t.ok).length, todo = tot > 0 && ok === tot;
      if (todo) sonarExito(); else sonarError();
      let h = '<div class="ejer-resumen ' + (todo ? 'win' : '') + '">' + ok + ' / ' + tot + ' tests' + (todo ? ' · ¡PASO APROBADO! ✅' : '') + '</div>';
      h += '<ul class="ejer-lista">';
      for (const t of tests) {
        h += '<li class="' + (t.ok ? 'ok' : 'no') + '"><span class="ic">' + (t.ok ? '✅' : '❌') + '</span><code>' + esc(t.name) + '</code>';
        if (t.msg) h += '<div class="m">' + esc(t.msg) + '</div>';
        h += '</li>';
      }
      box.innerHTML = h + '</ul>';
      return todo;
    }

    // Render completo de todos los pasos
    const editors = {};
    function renderPasos() {
      const actual = pasoActualIdx();
      const victoriaTotal = actual >= proyecto.pasos.length;
      const area = document.getElementById('proy-area');
      area.innerHTML = '';

      if (victoriaTotal && localStorage.getItem(KEY_PROY_OK) === '1') {
        area.innerHTML += '<div class="ejer-resumen win" style="margin-bottom:1.2rem;">🏅 ¡Venciste a ' + esc(proyecto.lider) + '! Medalla obtenida. +' + proyecto.premio + ' EXP</div>';
      }

      proyecto.pasos.forEach((paso, i) => {
        const aprobado = localStorage.getItem(KEY_PASO_OK(paso.id)) === '1';
        const esActual = i === actual;
        const bloqueado = i > actual;

        const div = document.createElement('div');
        div.className = 'proy-paso' + (aprobado ? ' ok' : '') + (bloqueado ? ' bloq' : '');
        div.id = 'paso-' + paso.id;

        let html = '<h3>' + (aprobado ? '✅ ' : bloqueado ? '🔒 ' : '') + esc(paso.titulo) + '</h3>';

        if (aprobado) {
          // Colapsado: mostrar código guardado
          const cod = localStorage.getItem(KEY_PASO(paso.id)) ?? paso.starter;
          html += '<details><summary style="cursor:pointer;color:var(--teal-deep);font-size:.9rem;">Ver código</summary><pre style="margin:.4rem 0 0;font-family:var(--font-mono);font-size:.85rem;background:var(--code-bg);color:#e8eaf2;border-radius:8px;padding:10px 14px;overflow:auto;">' + esc(cod) + '</pre></details>';
          div.innerHTML = html;
          area.appendChild(div);
          return;
        }

        if (bloqueado) {
          html += '<p style="color:var(--ink-mute);font-size:.9rem;margin:.3rem 0 0;">Completá el paso anterior para desbloquear.</p>';
          div.innerHTML = html;
          area.appendChild(div);
          return;
        }

        // Paso actual — interactivo
        html += '<p class="ej-prompt" style="margin:.3rem 0 .8rem;">' + esc(paso.consigna) + '</p>';
        html += '<div class="cw"><div class="cw-bar"><span class="dots"><i></i><i></i><i></i></span><span class="cw-lang">python</span><span class="cw-hint">✎ editable</span></div><div id="editor-' + paso.id + '"></div></div>';
        html += '<div class="ejer-acciones"><button class="btn-corregir" id="btn-' + paso.id + '" type="button">✅ Corregir paso</button><span class="ejer-estado" id="est-' + paso.id + '"></span></div>';
        html += '<div class="ejer-result" id="res-' + paso.id + '"></div>';
        div.innerHTML = html;
        area.appendChild(div);

        // Crear editor
        const guardado = localStorage.getItem(KEY_PASO(paso.id));
        const ed = editorPython({
          doc: guardado ?? paso.starter,
          parent: document.getElementById('editor-' + paso.id),
          onRun: () => corregirPaso(i, ed, paso),
          onChange: (txt) => {
            clearTimeout(ed._t);
            ed._t = setTimeout(() => localStorage.setItem(KEY_PASO(paso.id), txt), 500);
          },
        });
        editors[paso.id] = ed;

        // Botón corregir
        document.getElementById('btn-' + paso.id).addEventListener('click', () => corregirPaso(i, ed, paso));
      });
    }

    async function corregirPaso(n, ed, paso) {
      const btn = document.getElementById('btn-' + paso.id);
      const est = document.getElementById('est-' + paso.id);
      const res = document.getElementById('res-' + paso.id);
      btn.disabled = true; est.textContent = '⏳ Cargando Python (~20s la primera vez)…';
      try {
        const py = await getPy();
        est.textContent = 'Corrigiendo…';
        const codigo = codigoAcumulado(n, ed);
        // Guardar código actual antes de corregir
        localStorage.setItem(KEY_PASO(paso.id), ed.state.doc.toString());
        py.globals.set('_slug', proyecto.slug);
        py.globals.set('_ej', codigo);
        py.globals.set('_test', proyecto.test);
        py.globals.set('_extra', '{}');
        py.globals.set('_solo', JSON.stringify(paso.tests));
        const out = await py.runPythonAsync('correr(_slug, _ej, _test, _extra, _solo)');
        const parsed = JSON.parse(out);
        const byName = {};
        (parsed.tests || []).forEach((t) => (byName[t.name] = t));
        const testResults = paso.tests.map((nm) => byName[nm]).filter(Boolean);
        const aprobado = renderResultado(res, testResults, parsed.carga_error);
        if (aprobado) {
          localStorage.setItem(KEY_PASO_OK(paso.id), '1');
          // ¿Es el último paso?
          const esUltimo = n === proyecto.pasos.length - 1;
          if (esUltimo) {
            localStorage.setItem(KEY_PROY_OK, '1');
            sincronizar(D.temas);
          }
          // Re-render para avanzar
          renderPasos();
        }
      } catch (e) {
        res.innerHTML = '<div class="ejer-err">⚠️ ' + esc((e && e.message) || String(e)) + '</div>';
        sonarError();
      } finally {
        btn.disabled = false; est.textContent = '';
      }
    }

    renderPasos();
  </script>
</Base>
