---
import Base from '../../layouts/Base.astro';
import datos from '../../data/ejercicios.json';
import proyectos from '../../data/proyectos.json';
import { u } from '../../lib/url.ts';

export function getStaticPaths() {
  return Object.values(proyectos).map((p) => ({
    params: { slug: p.slug },
    props: { proyecto: p },
  }));
}

const { proyecto } = Astro.props;
const temas = datos.map((w) => ({ slug: w.slug, region: w.region, ejercicios: w.ejercicios.map((e) => ({ id: e.id })) }));
---
<Base title={proyecto.titulo + ' — Proyectos'} active="Ejercicios">
  <div class="wrap">
    <main class="book ejer" style="max-width:820px; margin:0 auto;">
      <p class="ej-breadcrumb"><a href={u('/ejercicios')}>Ejercicios</a> · Líder de Gimnasio</p>
      <h1>🏟️ {proyecto.titulo}</h1>
      <p class="ej-prompt">{proyecto.intro}</p>

      {proyecto.preamble && (
        <details class="proy-base" open>
          <summary>📦 Código base — ya está disponible, no lo escribís (lo podés usar en tus funciones)</summary>
          <pre class="proy-base-pre">{proyecto.preamble}</pre>
        </details>
      )}

      <div id="proy-area"></div>

      <nav class="cap-nav" style="margin-top:2rem;">
        <a href={u('/ejercicios')}><span class="dir">← Volver</span><br />Todos los temas</a>
      </nav>
    </main>
  </div>

  <script type="application/json" id="proy-data" set:html={JSON.stringify({ proyecto, temas })}></script>

  <script>
    import { editorPython } from '../../lib/editor.js';
    import runnerPy from '../../lib/runner.py?raw';
    import { sincronizar, INSIGNIAS, LEGENDARIOS, spriteUrl } from '../../lib/coleccion.js';
    import { sonarExito, sonarError } from '../../lib/sonidos.js';
    import { crearRunnerPytest } from '../../lib/runner-py.js';   // runner unificado (worker + timeout)
    import { bloqueError, listaTests, salidaEjecutar } from '../../lib/correr-ui.js';   // render compartido con ejercicios

    const D = JSON.parse(document.getElementById('proy-data').textContent);
    const { proyecto } = D;
    const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));

    // Claves de localStorage
    const KEY_PASO = (id) => 'proy:' + proyecto.slug + ':' + id;
    const KEY_PASO_OK = (id) => 'proy:' + proyecto.slug + ':' + id + ':ok';
    const KEY_PROY_OK = 'proy:' + proyecto.slug + ':ok';

    // Estado actual: primer paso sin :ok
    function pasoActualIdx() {
      for (let i = 0; i < proyecto.pasos.length; i++) {
        if (localStorage.getItem(KEY_PASO_OK(proyecto.pasos[i].id)) !== '1') return i;
      }
      return proyecto.pasos.length; // todos aprobados
    }

    // ¿Tenés los ejercicios necesarios para COMPLETAR el proyecto? (leer siempre se puede).
    // Líder: todos los ejercicios del tema. Integrador: todos los temas de la región.
    function puedeCompletar() {
      const temas = D.temas || [];
      const temaCompleto = (t) => t.ejercicios.length > 0 && t.ejercicios.every((ex) => localStorage.getItem('ej:' + t.slug + ':' + ex.id + ':ok') === '1');
      if (proyecto.tipo === 'integrador') return temas.filter((t) => t.region === proyecto.region).every(temaCompleto);
      const tema = temas.find((t) => t.slug === proyecto.tema);
      return !!tema && temaCompleto(tema);
    }

    // Construir código acumulado (preamble + pasos 0..N, el actual usa el editor)
    function codigoAcumulado(n, editorActual) {
      const partes = [proyecto.preamble];
      for (let i = 0; i <= n; i++) {
        const paso = proyecto.pasos[i];
        if (i === n) {
          partes.push(editorActual.state.doc.toString());
        } else {
          partes.push(localStorage.getItem(KEY_PASO(paso.id)) ?? paso.starter);
        }
      }
      return partes.join('\n\n');
    }

    // Runner unificado (worker + timeout). Mismo motor y render que los ejercicios.
    const R = crearRunnerPytest(runnerPy, proyecto.packages);

    // Render resultado de tests de un paso
    function renderResultado(box, tests, cargaError) {
      if (cargaError) { box.innerHTML = bloqueError(cargaError); sonarError(); return false; }
      const tot = tests.length, ok = tests.filter((t) => t.ok).length, todo = tot > 0 && ok === tot;
      if (todo) sonarExito(); else sonarError();
      const resumen = '<div class="ejer-resumen ' + (todo ? 'win' : '') + '">' + ok + ' / ' + tot + ' tests' + (todo ? ' · ¡PASO APROBADO! ✅' : '') + '</div>';
      box.innerHTML = resumen + listaTests(tests);
      return todo;
    }

    // Render completo de todos los pasos
    const editors = {};
    function renderPasos() {
      const completable = puedeCompletar();
      const actual = pasoActualIdx();
      const victoriaTotal = actual >= proyecto.pasos.length;
      const area = document.getElementById('proy-area');
      area.innerHTML = '';

      if (!completable) {
        const reqTxt = proyecto.tipo === 'integrador'
          ? 'completar <b>todos los temas de la región</b>'
          : 'completar <b>todos los ejercicios de este tema</b>';
        area.innerHTML += '<div class="proy-lectura">📖 <b>Modo lectura.</b> Podés leer los pasos y probar el código con ▶ Ejecutar, pero para <b>vencer al líder y ganar la medalla</b> necesitás ' + reqTxt + ' primero.</div>';
      }

      if (completable && victoriaTotal && localStorage.getItem(KEY_PROY_OK) === '1') {
        const recId = proyecto.tipo === 'integrador' ? LEGENDARIOS[proyecto.region] : INSIGNIAS[proyecto.tema];
        const premio = recId ? ' y el Pokémon insignia <img src="' + spriteUrl(recId) + '" alt="Pokémon insignia" style="height:46px;vertical-align:middle;image-rendering:pixelated;">' : '';
        area.innerHTML += '<div class="ejer-resumen win" style="margin-bottom:1.2rem;">🏅 ¡Venciste a ' + esc(proyecto.lider) + '! Conseguiste la <b>medalla</b>' + premio + '.</div>';
      }

      proyecto.pasos.forEach((paso, i) => {
        const aprobado = completable && localStorage.getItem(KEY_PASO_OK(paso.id)) === '1';
        const bloqueado = completable && i > actual;   // en modo lectura nada se bloquea: todo es legible

        const div = document.createElement('div');
        div.className = 'proy-paso' + (aprobado ? ' ok' : '') + (bloqueado ? ' bloq' : '');
        div.id = 'paso-' + paso.id;

        let html = '<h3>' + (aprobado ? '✅ ' : bloqueado ? '🔒 ' : '') + esc(paso.titulo) + '</h3>';

        if (aprobado) {
          // Colapsado: mostrar código guardado
          const cod = localStorage.getItem(KEY_PASO(paso.id)) ?? paso.starter;
          html += '<details><summary style="cursor:pointer;color:var(--teal-deep);font-size:.9rem;">Ver código</summary><pre style="margin:.4rem 0 0;font-family:var(--font-mono);font-size:.85rem;background:var(--code-bg);color:#e8eaf2;border-radius:8px;padding:10px 14px;overflow:auto;">' + esc(cod) + '</pre></details>';
          div.innerHTML = html;
          area.appendChild(div);
          return;
        }

        if (bloqueado) {
          html += '<p style="color:var(--ink-mute);font-size:.9rem;margin:.3rem 0 0;">Completá el paso anterior para desbloquear.</p>';
          div.innerHTML = html;
          area.appendChild(div);
          return;
        }

        // Paso interactivo (modo normal) o legible (modo lectura: Corregir bloqueado)
        html += '<p class="ej-prompt" style="margin:.3rem 0 .8rem; white-space:pre-wrap;">' + esc(paso.consigna) + '</p>';
        html += '<div class="cw"><div class="cw-bar"><span class="dots"><i></i><i></i><i></i></span><span class="cw-lang">python</span><span class="cw-hint">✎ editable</span></div><div id="editor-' + paso.id + '"></div></div>';
        const btnCorregir = completable
          ? '<button class="btn-corregir" id="btn-' + paso.id + '" type="button">✅ Corregir paso</button>'
          : '<button class="btn-corregir" id="btn-' + paso.id + '" type="button" disabled title="Completá los ejercicios del tema para vencer al líder">🔒 Corregir (bloqueado)</button>';
        html += '<div class="ejer-acciones"><button class="btn-sec" id="run-' + paso.id + '" type="button">▶ Ejecutar</button>' + btnCorregir + '<span class="ejer-estado" id="est-' + paso.id + '"></span></div>';
        html += '<div class="ejer-result" id="res-' + paso.id + '"></div>';
        div.innerHTML = html;
        area.appendChild(div);

        // Crear editor (Ctrl+Enter corrige si se puede, si no ejecuta)
        const guardado = localStorage.getItem(KEY_PASO(paso.id));
        const ed = editorPython({
          doc: guardado ?? paso.starter,
          parent: document.getElementById('editor-' + paso.id),
          onRun: () => (completable ? corregirPaso(i, ed, paso) : ejecutarPaso(i, ed, paso)),
          onChange: (txt) => {
            clearTimeout(ed._t);
            ed._t = setTimeout(() => localStorage.setItem(KEY_PASO(paso.id), txt), 500);
          },
        });
        editors[paso.id] = ed;

        // Botones
        if (completable) document.getElementById('btn-' + paso.id).addEventListener('click', () => corregirPaso(i, ed, paso));
        document.getElementById('run-' + paso.id).addEventListener('click', () => ejecutarPaso(i, ed, paso));
      });
    }

    // ▶ Ejecutar: corre el código acumulado y muestra prints (stdout) + lo que devuelve la
    // última expresión. Reusa runner.py `ejecutar`.
    async function ejecutarPaso(n, ed, paso) {
      const btn = document.getElementById('run-' + paso.id);
      const est = document.getElementById('est-' + paso.id);
      const res = document.getElementById('res-' + paso.id);
      btn.disabled = true; est.textContent = '⏳ Cargando Python (~20s la primera vez)…';
      try {
        est.textContent = 'Ejecutando…';
        const out = JSON.parse(await R.ejecutar(codigoAcumulado(n, ed)));
        res.innerHTML = salidaEjecutar(out);
      } catch (e) {
        res.innerHTML = '<div class="ejer-err">⚠️ ' + esc((e && e.message) || String(e)) + '</div>';
      } finally {
        btn.disabled = false; est.textContent = '';
      }
    }

    async function corregirPaso(n, ed, paso) {
      const btn = document.getElementById('btn-' + paso.id);
      const est = document.getElementById('est-' + paso.id);
      const res = document.getElementById('res-' + paso.id);
      btn.disabled = true; est.textContent = '⏳ Cargando Python (~20s la primera vez)…';
      try {
        est.textContent = 'Corrigiendo…';
        const codigo = codigoAcumulado(n, ed);
        // Guardar código actual antes de corregir
        localStorage.setItem(KEY_PASO(paso.id), ed.state.doc.toString());
        const out = await R.correr(proyecto.slug, codigo, proyecto.test, '{}', JSON.stringify(paso.tests));
        const parsed = JSON.parse(out);
        const byName = {};
        (parsed.tests || []).forEach((t) => (byName[t.name] = t));
        const testResults = paso.tests.map((nm) => byName[nm]).filter(Boolean);
        const aprobado = renderResultado(res, testResults, parsed.carga_error);
        if (aprobado) {
          localStorage.setItem(KEY_PASO_OK(paso.id), '1');
          // ¿Es el último paso?
          const esUltimo = n === proyecto.pasos.length - 1;
          if (esUltimo) {
            localStorage.setItem(KEY_PROY_OK, '1');
            sincronizar(D.temas);
          }
          // Re-render para avanzar
          renderPasos();
        }
      } catch (e) {
        res.innerHTML = '<div class="ejer-err">⚠️ ' + esc((e && e.message) || String(e)) + '</div>';
        sonarError();
      } finally {
        btn.disabled = false; est.textContent = '';
      }
    }

    renderPasos();

    // precalentar el worker en segundo plano: el primer ▶/Corregir ya está listo
    (window.requestIdleCallback || ((f) => setTimeout(f, 1800)))(() => { R.asegurar().catch(() => {}); });
  </script>
</Base>
