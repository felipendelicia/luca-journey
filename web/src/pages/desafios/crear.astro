---
import Base from '../../layouts/Base.astro';
import { u } from '../../lib/url.ts';
import { REGIONES as REGS } from '../../lib/regiones.mjs';
const REGIONES = [['libre', 'Libre'], ...REGS.map((r) => [r.id, `${r.nombre} · ${r.tema}`])];
---
<Base title="Crear desafío — Python con Pokémon" active="Desafíos">
  <main class="wrap">
    <h1>✍️ Crear un desafío</h1>
    <p>Definí una función a implementar, escribí tu solución de referencia y los casos de prueba. Al publicar, calculamos los resultados esperados (tu solución no se muestra a nadie).</p>
    <div class="df-form">
      <label>Título<input id="d-titulo" maxlength="80" placeholder="Sumar los pares de una lista" /></label>
      <label>Región<select id="d-region">{REGIONES.map(([v,t]) => <option value={v}>{t}</option>)}</select></label>
      <label>Dificultad (1-8)<input id="d-dif" type="number" min="1" max="8" value="3" /></label>
      <label>Consigna<textarea id="d-consigna" rows="3" placeholder="Devolvé la suma de los números pares de la lista."></textarea></label>
      <label>Nombre de la función<input id="d-func" placeholder="sumar_pares" /></label>
      <label>Código inicial (starter, opcional)<textarea id="d-starter" rows="2" placeholder="def sumar_pares(nums):\n    pass"></textarea></label>
      <label>Tu solución (no se publica)<div class="cw"><div class="cw-bar"><span class="cw-lang">python</span></div><div id="d-sol"></div></div></label>
      <div class="df-casos-bloque">
        <span class="df-casos-titulo">Casos de prueba</span>
        <p class="df-casos-ayuda">Escribí los argumentos como en Python. Ej: para <code>contar_vocales(texto)</code> poné <code>"murcielago"</code>. Para <code>sumar(a, b)</code> poné <code>2, 3</code>.</p>
        <ul id="d-filas" class="df-filas"></ul>
        <button class="btn-grande sec" id="d-agregar" type="button">+ Agregar caso</button>
      </div>
      <button class="btn-grande" id="d-publicar" type="button">✅ Validar y publicar</button>
      <p class="auth-msg err" id="d-err" hidden></p>
    </div>
  </main>
  <script>
    import { editorPython } from '../../lib/editor.js';
    import evalPy from '../../lib/desafios-eval.py?raw';
    import { crearDesafio } from '../../lib/desafios.js';
    import { usuario } from '../../lib/nube.js';
    import { run } from '../../lib/pyrun.js';   // worker con timeout: la solución del autor no congela
    const $ = (id) => document.getElementById(id);
    const B = (window.__BASE || '/').replace(/\/$/, '');
    const sol = editorPython({ doc: '', parent: $('d-sol') });
    const TIMEOUT = 10000;
    let listo = null;
    function asegurar() {   // worker cargado (Pyodide + evalPy) con timeout amplio en la 1ra carga
      if (!listo) listo = run(evalPy, [], 'construir_casos', ['[]'], 60000).catch((e) => { listo = null; throw e; });
      return listo;
    }

    // --- Constructor de filas de casos ---
    function crearFila() {
      const li = document.createElement('li');
      li.className = 'df-fila';
      li.innerHTML = `
        <span class="df-fila-prefijo" id="df-prefijo-${Date.now()}"></span>
        <input class="df-fila-expr" type="text" placeholder='ej: "hola"  ó  2, 3  ó  [1,2,3]' autocomplete="off" spellcheck="false" />
        <label class="df-fila-ej"><input type="checkbox" class="df-fila-check" /> ejemplo</label>
        <button class="df-fila-rm" type="button" title="Quitar fila">✕</button>`;
      li.querySelector('.df-fila-rm').addEventListener('click', () => { li.remove(); actualizarPrefijos(); });
      $('d-filas').appendChild(li);
      actualizarPrefijos();
      li.querySelector('.df-fila-expr').focus();
    }
    function actualizarPrefijos() {
      const func = ($('d-func').value.trim() || 'func');
      $('d-filas').querySelectorAll('.df-fila').forEach(li => {
        li.querySelector('.df-fila-prefijo').textContent = func + '(';
        // add closing paren hint in placeholder area via sibling span if needed
      });
    }
    $('d-func').addEventListener('input', actualizarPrefijos);
    $('d-agregar').addEventListener('click', crearFila);
    // Arranca con 2 filas
    crearFila(); crearFila();

    // --- Publicar ---
    $('d-publicar').addEventListener('click', async () => {
      const err = $('d-err'); err.hidden = true;
      if (!usuario()) { err.textContent = 'Iniciá sesión para crear desafíos.'; err.hidden = false; return; }
      const func = $('d-func').value.trim();
      if (!$('d-titulo').value.trim()) { err.textContent = 'Falta el título.'; err.hidden = false; return; }
      if (!func) { err.textContent = 'Falta el nombre de la función.'; err.hidden = false; return; }
      // Recolectar filas
      const filaEls = [...$('d-filas').querySelectorAll('.df-fila')];
      const filas = filaEls.map(li => ({
        expr: li.querySelector('.df-fila-expr').value.trim(),
        ejemplo: li.querySelector('.df-fila-check').checked,
      })).filter(f => f.expr !== '');
      if (!filas.length) { err.textContent = 'Agregá al menos un caso de prueba.'; err.hidden = false; return; }
      const b = $('d-publicar'); b.disabled = true; b.textContent = 'Validando…';
      try {
        await asegurar();
        // Paso 1: construir casos desde filas
        const r1 = JSON.parse(await run(evalPy, [], 'construir_casos', [JSON.stringify(filas)], TIMEOUT));
        if (r1.error) { err.textContent = '⚠️ ' + r1.error; err.hidden = false; return; }
        // Paso 2: computar esperados con la solución del autor (puede tener bucle infinito → timeout)
        const r2 = JSON.parse(await run(evalPy, [], 'computar_esperados',
          [sol.state.doc.toString(), func, JSON.stringify(r1.casos)], TIMEOUT));
        if (r2.error) { err.textContent = '⚠️ ' + r2.error; err.hidden = false; return; }
        const id = await crearDesafio({
          titulo: $('d-titulo').value, consigna: $('d-consigna').value, func,
          starter: $('d-starter').value, casos: r2.casos,
          dificultad: Number($('d-dif').value) || 3, region: $('d-region').value,
        });
        location.href = B + '/desafios/ver?id=' + id;
      } catch (e) { err.textContent = '⚠️ ' + (e.message || e); err.hidden = false; }
      finally { b.disabled = false; b.textContent = '✅ Validar y publicar'; }
    });

    // precalentar el worker en segundo plano: al publicar ya está listo
    (window.requestIdleCallback || ((f) => setTimeout(f, 1800)))(() => { asegurar().catch(() => {}); });
  </script>
</Base>
