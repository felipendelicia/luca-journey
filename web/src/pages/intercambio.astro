---
import Base from '../layouts/Base.astro';
import pokemon from '../data/pokemon.json';
import { u } from '../lib/url.ts';
const nombres = Object.fromEntries(pokemon.map((p) => [p.id, p.nombre]));
---
<Base title="Intercambio — Python con Pokémon" active="">
  <main class="wrap">
    <h1>🔄 Intercambio</h1>

    <p class="tr-login" id="tr-login" hidden>Necesitás <b>iniciar sesión</b> (botón ☁️ arriba) para intercambiar.</p>

    <section class="tr-pane" id="tr-inicio" hidden>
      <p>Creá una sala y pasale el código a la otra persona (por WhatsApp), o unite con un código. Los dos tienen que estar conectados al mismo tiempo.</p>
      <div class="tr-acciones">
        <button class="btn-grande" id="tr-crear">Crear sala</button>
        <form class="tr-unir" id="tr-unir-form">
          <input id="tr-codigo" placeholder="CÓDIGO" maxlength="6" />
          <button class="btn-grande sec" type="submit">Unirme</button>
        </form>
      </div>
      <div class="tr-amigos" id="tr-amigos" hidden>
        <h3>👥 Amigos en línea</h3>
        <p class="auth-fine">Están en esta página ahora. Invitalos a intercambiar sin pasar código.</p>
        <div id="tr-amigos-lista"></div>
      </div>
      <p class="auth-msg err" id="tr-err" hidden></p>
    </section>

    <section class="tr-pane" id="tr-espera" hidden>
      <p>Compartí este código (o el link) y esperá a que se una:</p>
      <div class="tr-codigo-box"><span id="tr-codigo-ver"></span><button class="btn-sec" id="tr-copiar">📋 copiar link</button></div>
      <p class="auth-fine">Esperando al otro entrenador… 🟡</p>
      <button class="btn-sec" id="tr-cancelar-espera">Cancelar</button>
    </section>

    <section class="tr-pane" id="tr-sala" hidden>
      <div class="tr-cab">
        <span>Vos · <span id="tr-estado-yo">sin confirmar</span></span>
        <span><b id="tr-nombre-otro">El otro</b> <span class="tr-pres" id="tr-pres-otro">🔴</span> · <span id="tr-estado-otro">sin confirmar</span></span>
      </div>

      <div class="tr-trato">
        <div class="tr-col">
          <div class="tr-lab">Vos das</div>
          <div class="tr-lote" id="tr-lote-yo"></div>
          <button class="btn-sec" id="tr-elegir">+ Ofrecer de lo mío</button>
        </div>
        <div class="tr-vs">⇄</div>
        <div class="tr-col">
          <div class="tr-lab">Recibís</div>
          <div class="tr-lote" id="tr-lote-otro"></div>
        </div>
      </div>

      <div class="tr-piden" id="tr-piden" hidden>
        <div class="tr-lab">📨 <span id="tr-piden-nom">El otro</span> te pide</div>
        <div id="tr-piden-lista"></div>
      </div>

      <div class="tr-colec">
        <button class="tr-colec-tog" id="tr-colec-tog" type="button">▾ Colección de <span id="tr-colec-nom">el otro</span></button>
        <div class="tr-colec-body" id="tr-colec-body">
          <input class="tr-colec-buscar" id="tr-colec-buscar" placeholder="Buscar Pokémon…" />
          <div class="tr-grid" id="tr-colec-grid"></div>
        </div>
      </div>

      <div class="tr-botones">
        <button class="btn-grande" id="tr-confirmar">✅ Confirmar</button>
        <button class="btn-sec" id="tr-cancelar">✕ Cancelar</button>
      </div>
    </section>

    <section class="tr-pane" id="tr-listo" hidden>
      <h2>🎉 ¡Intercambio listo!</h2>
      <p id="tr-resumen"></p>
      <a class="btn-grande" href={u('/pokedex')}>Ver mi Pokédex</a>
    </section>

    <div class="av-modal" id="tr-modal" hidden>
      <div class="av-card">
        <div class="av-head"><b>🎒 Elegí qué ofrecer</b><button class="av-x" id="tr-modal-x" type="button">✕</button></div>
        <p class="av-sub">Tocá <b>+</b> para sumar al lote. ✨ = ofrecé el shiny (si lo tenés).</p>
        <div class="av-grid" id="tr-grid"></div>
        <button class="btn-grande" id="tr-modal-ok" type="button">Listo</button>
      </div>
    </div>
  </main>

  <script type="application/json" id="tr-data" set:html={JSON.stringify({ nombres })}></script>
  <script>
    import { crear, unirse, ponerLote, ponerPedido, coleccionOtro, confirmar, cancelar, leerSala, suscribir, haySupabase } from '../lib/trades.js';
    import { usuario, init as initNube, refrescarDesdeNube } from '../lib/nube.js';
    import { amigos } from '../lib/social.js';
    import { pc } from '../lib/coleccion.js';
    import { onPresencia, invitar } from '../lib/presencia.js';

    const D = JSON.parse(document.getElementById('tr-data').textContent);
    const nombres = D.nombres;
    const sprite = (id, sh) => `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${sh ? 'shiny/' : ''}${id}.png`;
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const $ = (id) => document.getElementById(id);
    const panes = ['tr-login', 'tr-inicio', 'tr-espera', 'tr-sala', 'tr-listo'];
    const ver = (cual) => panes.forEach((p) => $(p).hidden = (p !== cual));

    // intercambio por INSTANCIA: mis Pokémon como {iid,id,nivel,shiny,mote}
    const misInst = () => pc().map((m) => ({ iid: m.iid, id: m.id, nivel: m.nivel, shiny: !!m.shiny, mote: m.mote || '' }));
    const tengoIid = (iid) => misInst().some((m) => m.iid === iid);

    let sala = null, salaId = null, miLote = [], miPedido = [], desuscribir = null, entrando = false, poll = null;
    let otroColeccion = null;            // { pc:[instancias] } del otro (cache)
    let amigosIniciado = false, misAmigos = [], presentes = new Set();   // amigos en línea (presencia global)
    const miHandle = () => localStorage.getItem('liga:nombre') || '';
    const ocultos = new Set();           // pedidos ocultados localmente (por iid)
    const soyCreador = () => sala && usuario() && sala.creador_id === usuario().id;
    const nombreInst = (x) => (x.mote || nombres[x.id] || ('Nº ' + x.id)) + (x.shiny ? ' ✨' : '') + ' · Nv.' + (x.nivel ?? '?');

    function chipInst(x, onQuitar) {
      const img = `<img src="${sprite(x.id, x.shiny)}" alt="${esc(nombreInst(x))}" title="${esc(nombreInst(x))}" />`;
      const b = document.createElement('span');
      b.className = 'tr-chip';
      b.innerHTML = `${img}<span class="tr-chip-nv">Nv.${x.nivel ?? '?'}${x.shiny ? ' ✨' : ''}</span>` + (onQuitar ? `<button class="tr-quitar" type="button">×</button>` : '');
      if (onQuitar) b.querySelector('.tr-quitar').addEventListener('click', onQuitar);
      return b;
    }
    function pintarLoteYo() {
      const el = $('tr-lote-yo'); el.innerHTML = '';
      if (!miLote.length) { el.innerHTML = '<span class="tr-vacio">(vacío)</span>'; return; }
      miLote.forEach((x, i) => el.appendChild(chipInst(x, async () => {
        miLote.splice(i, 1); pintarLoteYo();
        try { await ponerLote(salaId, miLote); } catch (e) { alert(e.message); }
      })));
    }
    function pintarLoteOtro(lote) {
      const el = $('tr-lote-otro'); el.innerHTML = '';
      if (!lote || !lote.length) { el.innerHTML = '<span class="tr-vacio">(vacío)</span>'; return; }
      lote.forEach((x) => el.appendChild(chipInst(x, null)));
    }
    const yaEnLote = (x) => miLote.some((y) => y.iid === x.iid);
    function pintarPiden(pedidoOtro) {
      // el otro pide INSTANCIAS mías (por iid). Mostramos cuáles y dejamos aceptarlas a tu lote.
      const visibles = (pedidoOtro || []).filter((x) => !ocultos.has(x.iid));
      $('tr-piden').hidden = visibles.length === 0;
      $('tr-piden-nom').textContent = (soyCreador() ? sala.invitado_nombre : sala.creador_nombre) || 'El otro';
      const cont = $('tr-piden-lista'); cont.innerHTML = '';
      visibles.forEach((x) => {
        const tengo = tengoIid(x.iid), enLote = yaEnLote(x);
        const row = document.createElement('div');
        row.className = 'tr-piden-row' + (enLote ? ' hecho' : '');
        row.innerHTML = `<img src="${sprite(x.id, x.shiny)}" alt="${esc(nombreInst(x))}" />
          <span class="nm">${esc(nombreInst(x))}${tengo ? '' : ' <small>(ya no lo tenés)</small>'}</span>`;
        const acc = document.createElement('button');
        if (enLote) { acc.className = 'tr-rechazar'; acc.textContent = '✓ en tu lote'; acc.disabled = true; }
        else if (!tengo) { acc.className = 'tr-rechazar'; acc.textContent = 'no lo tenés'; acc.disabled = true; }
        else {
          acc.className = 'tr-aceptar'; acc.textContent = 'Aceptar';
          acc.addEventListener('click', async () => {
            if (yaEnLote(x)) return;
            miLote.push({ iid: x.iid, id: x.id, nivel: x.nivel, shiny: !!x.shiny, mote: x.mote || '' }); pintarLoteYo();
            try { await ponerLote(salaId, miLote); } catch (e) { alert(e.message); }
            pintarPiden(pedidoOtro);
          });
        }
        const no = document.createElement('button');
        no.className = 'tr-rechazar'; no.textContent = '✕';
        no.title = 'ocultar'; no.addEventListener('click', () => { ocultos.add(x.iid); pintarPiden(pedidoOtro); });
        row.appendChild(acc); if (!enLote) row.appendChild(no);
        cont.appendChild(row);
      });
    }
    async function bajarColeccionOtro() {
      if (otroColeccion || !sala || !sala.invitado_id) return;
      try { otroColeccion = await coleccionOtro(salaId); } catch { otroColeccion = null; return; }
      $('tr-colec-body').hidden = miLote.length > 0;   // abierto si tu lote está vacío
      $('tr-colec-tog').firstChild.nodeValue = $('tr-colec-body').hidden ? '▸ ' : '▾ ';
      pintarColeccion();
    }
    function pintarColeccion() {
      const grid = $('tr-colec-grid'); if (!otroColeccion) return;
      const inst = otroColeccion.pc || [];
      const q = ($('tr-colec-buscar').value || '').trim().toLowerCase();
      const lista = inst
        .filter((m) => !q || (nombres[m.id] || '').toLowerCase().includes(q) || (m.mote || '').toLowerCase().includes(q))
        .sort((a, b) => (b.shiny - a.shiny) || (b.nivel - a.nivel) || (a.id - b.id));
      if (!lista.length) { grid.innerHTML = '<div class="tr-colec-vacio">Sin Pokémon para mostrar.</div>'; return; }
      grid.innerHTML = '';
      lista.forEach((m) => {
        const on = miPedido.some((p) => p.iid === m.iid);
        const cell = document.createElement('div'); cell.className = 'tr-cell' + (on ? ' on' : '');
        cell.innerHTML = `<img src="${sprite(m.id, m.shiny)}" alt="${esc(nombreInst(m))}" title="${esc(nombreInst(m))}" /><span class="tr-cnt">Nv.${m.nivel}${m.shiny ? ' ✨' : ''}</span>`;
        const btn = document.createElement('button');
        btn.className = 'tr-pedir' + (on ? ' on' : ''); btn.type = 'button'; btn.textContent = on ? '✓ pedido' : 'Pedir';
        btn.addEventListener('click', async () => {
          const i = miPedido.findIndex((p) => p.iid === m.iid);
          if (i >= 0) miPedido.splice(i, 1);
          else miPedido.push({ iid: m.iid, id: m.id, nivel: m.nivel, shiny: m.shiny, mote: m.mote });
          pintarColeccion();
          try { await ponerPedido(salaId, miPedido); } catch (e) { alert(e.message); }
        });
        cell.appendChild(btn);
        grid.appendChild(cell);
      });
    }
    function pintarSala() {
      if (!sala) return;
      const otroNombre = soyCreador() ? sala.invitado_nombre : sala.creador_nombre;
      const otroLote = soyCreador() ? sala.invitado_lote : sala.creador_lote;
      const otroPedido = soyCreador() ? sala.invitado_pedido : sala.creador_pedido; // lo que el otro me pide
      const yoOk = soyCreador() ? sala.creador_ok : sala.invitado_ok;
      const otroOk = soyCreador() ? sala.invitado_ok : sala.creador_ok;
      $('tr-nombre-otro').textContent = otroNombre || 'El otro';
      $('tr-colec-nom').textContent = otroNombre || 'el otro';
      pintarLoteYo();
      pintarLoteOtro(otroLote || []);
      pintarPiden(otroPedido || []);
      $('tr-estado-yo').textContent = yoOk ? '✅ confirmado' : 'sin confirmar';
      $('tr-estado-otro').textContent = otroOk ? '✅ confirmado' : 'sin confirmar';
    }

    async function onCambioSala(row) {
      sala = row;
      if (row.estado === 'completada') { await terminar(); return; }
      if (row.estado === 'cancelada') { alert('El intercambio se canceló.'); location.href = location.pathname; return; }
      if (row.invitado_id) { ver('tr-sala'); bajarColeccionOtro(); }
      pintarSala();
    }

    async function entrarSala(id) {
      salaId = id;
      sala = await leerSala(id);
      miLote = (soyCreador() ? sala.creador_lote : sala.invitado_lote) || [];
      miPedido = (soyCreador() ? sala.creador_pedido : sala.invitado_pedido) || [];
      $('tr-codigo-ver').textContent = sala.codigo;
      ver(sala.invitado_id ? 'tr-sala' : 'tr-espera');
      pintarSala();
      desuscribir = suscribir(id, usuario().id, {
        onCambio: onCambioSala,
        onPresencia: (hay) => { const o = $('tr-pres-otro'); if (o) o.textContent = hay ? '🟢' : '🔴'; },
      });
      // fallback: re-leer la sala cada 3s por si Realtime pierde algún evento
      poll = setInterval(async () => { try { const row = await leerSala(id); if (row) onCambioSala(row); } catch {} }, 3000);
      bajarColeccionOtro();
    }

    async function terminar() {
      if (poll) clearInterval(poll);
      if (desuscribir) desuscribir();
      await refrescarDesdeNube();
      $('tr-resumen').textContent = '¡Tu colección se actualizó!';
      ver('tr-listo');
    }

    function abrirPicker() {
      const inst = misInst().filter((m) => !yaEnLote(m))
        .sort((a, b) => (b.shiny - a.shiny) || (b.nivel - a.nivel) || (a.id - b.id));
      $('tr-grid').innerHTML = inst.length ? inst.map((m) =>
        `<div class="tr-pick">
          <img src="${sprite(m.id, m.shiny)}" alt="${esc(nombreInst(m))}" title="${esc(nombreInst(m))}" />
          <span class="tr-cnt">Nv.${m.nivel}${m.shiny ? ' ✨' : ''}</span>
          <button class="tr-add" data-iid="${m.iid}" type="button">+ ofrecer</button>
        </div>`).join('') : '<div class="tr-colec-vacio">No tenés Pokémon para ofrecer.</div>';
      $('tr-grid').querySelectorAll('.tr-add').forEach((b) => b.addEventListener('click', () => {
        const m = misInst().find((x) => x.iid === b.dataset.iid);
        if (!m || yaEnLote(m)) return;
        miLote.push({ iid: m.iid, id: m.id, nivel: m.nivel, shiny: m.shiny, mote: m.mote });
        pintarLoteYo();
        b.disabled = true; b.textContent = '✓ agregado';
      }));
      $('tr-modal').hidden = false;
    }

    const mostrarError = (e) => { const el = $('tr-err'); el.textContent = e.message || String(e); el.hidden = false; };

    async function iniciarAmigos() {
      if (amigosIniciado || !usuario()) return;
      amigosIniciado = true;
      try { misAmigos = await amigos(); } catch { misAmigos = []; }
      onPresencia((set) => { presentes = set; pintarAmigos(); });   // presencia global
    }
    function pintarAmigos() {
      const yo = usuario();
      const online = misAmigos.filter((a) => presentes.has(a.user_id) && (!yo || a.user_id !== yo.id));
      $('tr-amigos').hidden = online.length === 0;
      const cont = $('tr-amigos-lista'); cont.innerHTML = '';
      online.forEach((a) => {
        const row = document.createElement('div'); row.className = 'tr-amigo-row';
        row.innerHTML = `<span class="tr-amigo-pt">🟢</span><b>${esc(a.nombre) || ('@' + esc(a.handle))}</b> <span class="auth-fine">@${esc(a.handle)}</span>`;
        const b = document.createElement('button'); b.className = 'btn-sec'; b.textContent = '🔄 Invitar';
        b.addEventListener('click', () => invitarAmigo(a));
        row.appendChild(b); cont.appendChild(row);
      });
    }
    async function invitarAmigo(a) {
      try {
        const { id, codigo } = await crear();
        invitar(a.user_id, codigo, miHandle());   // le llega esté donde esté (aviso global)
        await entrarSala(id);
      } catch (e) { mostrarError(e); }
    }

    function arrancar() {
      if (!haySupabase) { ver('tr-login'); return; }
      initNube();
      const refrescarSesion = () => {
        if (salaId || entrando) return;
        if (!usuario()) { ver('tr-login'); return; }
        const codigoURL = new URLSearchParams(location.search).get('codigo');
        if (codigoURL) { entrando = true; unirse(codigoURL).then(entrarSala).catch((e) => { entrando = false; mostrarError(e); ver('tr-inicio'); }); }
        else { ver('tr-inicio'); iniciarAmigos(); }
      };
      window.addEventListener('nube:cambio', refrescarSesion);
      refrescarSesion();
    }

    $('tr-crear').addEventListener('click', async () => {
      try { const { id } = await crear(); await entrarSala(id); } catch (e) { mostrarError(e); }
    });
    $('tr-unir-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      try { const id = await unirse($('tr-codigo').value); await entrarSala(id); } catch (e2) { mostrarError(e2); }
    });
    $('tr-copiar').addEventListener('click', () => {
      const link = `${location.origin}${window.__BASE || ''}/intercambio?codigo=${sala.codigo}`;
      navigator.clipboard.writeText(link); $('tr-copiar').textContent = '✓ copiado';
    });
    $('tr-elegir').addEventListener('click', abrirPicker);
    $('tr-modal-x').addEventListener('click', () => { $('tr-modal').hidden = true; });
    $('tr-modal-ok').addEventListener('click', async () => { $('tr-modal').hidden = true; try { await ponerLote(salaId, miLote); } catch (e) { alert(e.message); } });
    $('tr-confirmar').addEventListener('click', async () => { try { await confirmar(salaId); } catch (e) { alert(e.message); } });
    $('tr-cancelar').addEventListener('click', async () => { await cancelar(salaId); location.href = location.pathname; });
    $('tr-cancelar-espera').addEventListener('click', async () => { await cancelar(salaId); location.href = location.pathname; });
    $('tr-colec-tog').addEventListener('click', () => {
      const b = $('tr-colec-body'); b.hidden = !b.hidden;
      $('tr-colec-tog').firstChild.nodeValue = b.hidden ? '▸ ' : '▾ ';
    });
    $('tr-colec-buscar').addEventListener('input', pintarColeccion);

    arrancar();
  </script>
</Base>
