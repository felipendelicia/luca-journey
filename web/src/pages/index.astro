---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url.ts';

const cards = [
  ['📖', 'El libro', 'Toda la teoría del curso (Linux + Python), con ejemplos ejecutables.', '/libro'],
  ['🎮', 'Playground', 'Escribí y ejecutá Python en el navegador, sin instalar nada.', '/playground'],
  ['🏋️', 'Ejercicios en vivo', 'Resolvé y corregí tus ejercicios con tests reales en el navegador.', '/ejercicios'],
  ['🏆', 'La Liga', 'Ganá EXP y medallas resolviendo ejercicios. Sé Campeón de Kanto.', '/liga'],
  ['📕', 'Pokédex', 'Coleccioná Pokémon: ganá Pokéballs y atrapalos en el Safari.', '/pokedex'],
  ['📚', 'Bibliografía', 'Libros, cursos (¡CS50!) y recursos recomendados, todos gratis.', '/recursos'],
  ['⭐', 'Repositorio', 'El código de toda la plataforma en GitHub.', 'https://github.com/felipendelicia/luca-journey'],
];
---
<Base title="Python con Pokémon — Plataforma" active="Inicio">
  <main class="wrap">
    <section class="hero-home">
      <p class="kick">La plataforma del curso</p>
      <h1>Python con Pokémon</h1>
      <p>Aprendé a programar desde cero — Linux, Python y mucha aventura — directo en tu navegador. 🏆</p>
      <div class="cta">
        <a class="btn-grande" href={u('/libro')}>📖 Empezar a leer</a>
        <a class="btn-grande sec" href={u('/playground')}>🎮 Probar Python ya</a>
        <a class="btn-grande sec" href={u('/safari')}>🎒 Atrapar Pokémon</a>
      </div>
    </section>

    <div class="cards">
      {cards.map(([ico, t, d, href]) => (
        <a class="card" href={href.startsWith('/') ? u(href) : href}>
          <div class="ico">{ico}</div>
          <h3>{t}</h3>
          <p>{d}</p>
        </a>
      ))}
    </div>
  </main>
</Base>
