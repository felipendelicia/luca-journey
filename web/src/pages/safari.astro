---
import Base from '../layouts/Base.astro';
import datos from '../data/ejercicios.json';
import pokemon from '../data/pokemon.json';
import { ballSvg } from '../lib/sprites.js';
import { u } from '../lib/url.ts';

const temas = datos.map((w) => ({ slug: w.slug, region: w.region, ejercicios: w.ejercicios.map((e) => ({ id: e.id })) }));
const total = pokemon.length;
---
<Base title="Safari — Python con Pokémon" active="Pokédex">
  <div class="wrap safari">
    <div class="safari-head">
      <h1>🎒 Safari Pokémon</h1>
      <button class="navlink btn-rarezas" id="btn-rarezas" type="button">✨ ¿Cómo funcionan las rarezas?</button>
      <a class="navlink" href={u('/tienda')}>🛒 Tienda</a>
      <a class="navlink" href={u('/pokedex')}>📕 Ver mi Pokédex</a>
    </div>
    <p>Tirá Pokéballs para atrapar Pokémon salvajes. Ganás Pokéballs <strong>resolviendo ejercicios</strong> (+2 c/u), <strong>ganando batallas</strong> (+5) y con el <strong>regalo cada 20 min</strong> (+8). ⚡</p>

    <div class="safari-barra">
      <div class="ss-item"><span class="ss-ico" set:html={ballSvg(0, 22)}></span><b id="balls">0</b><span class="ss-lbl">Pokéballs</span></div>
      <div class="ss-item"><span class="ss-ico">📕</span><b id="colN">0</b><span class="ss-lbl">de {total}</span></div>
      <button class="btn-regalo" id="regalo">🎁 Regalo (+8)</button>
    </div>
    <p class="safari-regiones" id="regiones"></p>

    <div class="safari-arena">
      <div class="arena-pasto" id="arena">
        <div class="arena-vacio" id="vacio">El pasto se mueve… 🌿<br /><small>Tirá una Pokéball para ver qué aparece.</small></div>
      </div>
      <button class="btn-tirar" id="tirar">¡Tirá la Pokéball! <Fragment set:html={ballSvg(0, 18)} /></button>
      <p class="safari-msg" id="msg"></p>
    </div>
  </div>

  <div class="rar-modal" id="rar-modal" hidden>
    <div class="rar-card">
      <button class="rar-x" id="rar-x" type="button" aria-label="Cerrar">✕</button>
      <h2>✨ Rarezas del Safari</h2>
      <p>Cada Pokémon tiene una <b>rareza</b>. Cuanto más raro, <b>menos aparece</b> y más épica es su captura (más temblor, brillo y sonido). El <b>🌟 shiny</b> (~1%) puede tocar sobre cualquier rareza.</p>
      <div class="rar-lista" id="rar-lista"></div>
    </div>
  </div>

  <script type="application/json" id="safari-data" set:html={JSON.stringify({ temas })}></script>
  <script>
    import { sincronizar, tirar as lanzar, estado, vistos, reclamarRegalo, regaloDisponible, regionesDesbloqueadas, spriteUrl } from '../lib/coleccion.js';
    import { sonarCaptura, sonarShiny, sonarEpico } from '../lib/sonidos.js';
    import { TIERS } from '../lib/rareza.js';
    import { ballSvg } from '../lib/sprites.js';
    import { REGIONES as REGS, etiqueta } from '../lib/regiones.mjs';
    import pokemon from '../data/pokemon.json';   // módulo → chunk /_astro cacheado (compartido con pokedex/liga)
    import pesos from '../data/aparicion.json';

    const meta = JSON.parse(document.getElementById('safari-data').textContent);
    const D = { pokemon, pesos, temas: meta.temas };
    const $ = (id) => document.getElementById(id);

    // modal explicativo de rarezas (poblado desde TIERS)
    (function rarezas() {
      const lista = $('rar-lista'), modal = $('rar-modal');
      if (!lista || !modal) return;
      const fila = (color, etiqueta, tasa) =>
        '<div class="rar-fila"><span class="cap-tier" style="--tier-color:' + color + '">' + etiqueta + '</span>'
        + '<span class="rar-tasa">' + tasa + '</span></div>';
      lista.innerHTML = TIERS.map((t) =>
        fila(t.color, (t.ico ? t.ico + ' ' : '') + t.nombre, '~' + (t.rate * 100).toFixed(t.rate < 0.01 ? 2 : 1) + '%')
      ).join('') + fila('#ffd23f', '🌟 Shiny', '~1% · sobre cualquiera');
      const cerrar = () => { modal.hidden = true; };
      $('btn-rarezas') && $('btn-rarezas').addEventListener('click', () => { modal.hidden = false; });
      $('rar-x') && $('rar-x').addEventListener('click', cerrar);
      modal.addEventListener('click', (e) => { if (e.target === modal) cerrar(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(); });
    })();

    function refrescar() {
      const e = estado();
      $('balls').textContent = e.balls;
      // “de 721” = especies VISTAS (igual que la Pokédex), no solo las que tenés ahora
      const v = vistos();
      $('colN').textContent = D.pokemon.filter((p) => v.has(p.id)).length;
      $('tirar').disabled = e.balls <= 0;
      $('regalo').style.display = regaloDisponible() ? '' : 'none';
      const d = regionesDesbloqueadas(D.temas);
      $('regiones').innerHTML = 'Aparecen: ' +
        REGS.map((r) => d.has(r.id) ? '<b>' + etiqueta(r) + '</b>' : '<span class="bloq">' + etiqueta(r) + ' 🔒</span>').join(' · ') +
        ' &nbsp;<small>(hacé ejercicios de una región para desbloquearla)</small>';
    }

    // otorga lo pendiente (balls por ejercicios, capturas por hitos)
    const nuevo = sincronizar(D.temas);
    if (nuevo.balls || nuevo.capturas.length) {
      const partes = [];
      if (nuevo.balls) partes.push('🔴 +' + nuevo.balls + ' Pokéballs');
      if (nuevo.capturas.length) partes.push('🎉 ' + nuevo.capturas.length + ' captura(s) por hitos');
      $('msg').textContent = partes.join('  ·  ');
    }
    refrescar();

    $('regalo').addEventListener('click', () => {
      const n = reclamarRegalo();
      if (n) $('msg').textContent = '🎁 ¡Regalo! +' + n + ' Pokéballs · volvé en 20 min';
      refrescar();
    });
    // el botón reaparece solo cuando se cumple el cooldown (sin recargar)
    setInterval(() => { if (regaloDisponible() && $('regalo').style.display === 'none') refrescar(); }, 20000);

    const esperar = (ms) => new Promise((res) => setTimeout(res, ms));
    function estrellas(escena, { n = 16, dorado = false, color = '#ffd23f' } = {}) {
      for (let i = 0; i < n; i++) {
        const s = document.createElement('span');
        s.className = 'estrella' + (dorado ? ' oro' : '');
        const ang = (Math.PI * 2 * i) / n, dist = 80 + Math.random() * 90;
        s.style.setProperty('--dx', Math.cos(ang) * dist + 'px');
        s.style.setProperty('--dy', Math.sin(ang) * dist + 'px');
        if (!dorado) s.style.color = color;
        s.textContent = dorado ? '✨' : '⭐';
        escena.appendChild(s);
        setTimeout(() => s.remove(), 1000);
      }
    }

    let animando = false;
    async function lanzarBall() {
      if (animando) return;
      const r = lanzar(D.pokemon, D.temas, D.pesos);
      if (r.error === 'sin-balls') { $('msg').textContent = 'Te quedaste sin Pokéballs. Resolvé ejercicios o esperá el regalo (cada 20 min). 💪'; return; }
      if (r.error) { $('msg').textContent = 'Hacé un ejercicio para desbloquear Pokémon salvajes. 💪'; return; }
      animando = true;
      const btn = $('tirar'); btn.disabled = true;
      const p = r.pokemon, arena = $('arena');
      $('msg').textContent = '¡Un Pokémon salvaje apareció!';
      arena.innerHTML =
        '<div class="escena">' +
        '<img class="wild silueta" src="' + spriteUrl(p.id, r.shiny) + '" alt="?" />' +
        '<div class="pokeball lanza" id="pb"></div></div>';
      const wild = arena.querySelector('.wild'), pb = $('pb');
      // rareza: el drama escala con el tier del Pokémon
      const escena = arena.querySelector('.escena');
      const t = r.tier || { nivel: 1, nombre: 'Común', color: '#7d8b79', ico: '' };
      escena.style.setProperty('--tier-color', t.color);
      escena.classList.add('tier-' + t.nivel);
      const tambaleos = t.nivel >= 9 ? 5 : t.nivel >= 7 ? 4 : t.nivel >= 4 ? 3 : 2;
      const nParticulas = t.nivel >= 9 ? 30 : t.nivel >= 7 ? 22 : t.nivel >= 4 ? 16 : 8;
      const epico = t.nivel >= 7, legendario = t.nivel >= 9;

      await esperar(650);                 // el salvaje salta en el pasto
      pb.classList.remove('lanza'); pb.classList.add('vuela');  // tirás la ball (arco)
      await esperar(480);
      pb.classList.remove('vuela'); pb.classList.add('piso');
      wild.classList.add('absorbido'); arena.classList.add('flash');  // lo absorbe
      await esperar(360); arena.classList.remove('flash');
      $('msg').textContent = '¿La atrapará?';
      for (let i = 0; i < tambaleos; i++) {   // tambaleos de suspenso (más en tiers altos)
        pb.classList.add('tambalea'); await esperar(560); pb.classList.remove('tambalea'); await esperar(150);
      }
      // ¡atrapado!
      pb.classList.add('abre');
      wild.classList.remove('silueta', 'absorbido');
      wild.classList.add('revelado'); if (r.shiny) wild.classList.add('shiny');
      if (epico) escena.classList.add('burst');                          // ráfaga (épico+)
      estrellas(escena, { n: nParticulas, dorado: r.shiny || legendario, color: t.color });
      if (legendario || r.shiny) {                                       // pantalla temblando
        document.body.classList.add('tier-shake');
        setTimeout(() => document.body.classList.remove('tier-shake'), 600);
      }
      if (r.shiny) { document.body.classList.add('shiny-flash'); setTimeout(() => document.body.classList.remove('shiny-flash'), 700); sonarShiny(); }
      else if (epico) sonarEpico();
      else sonarCaptura();

      const titulo = r.shiny
        ? '✨ ¡Un <b>' + p.nombre + '</b> SHINY! ✨'
        : (r.repetido ? '¡Otro <b>' + p.nombre + '</b>! Ya tenés <b>' + r.cantidad + '</b>' : '¡Atrapaste a <b>' + p.nombre + '</b>!');
      const ballTxt = r.ball === 2 ? ballSvg(2, 18) + ' <b>¡Ultra Ball!</b> ' : r.ball === 1 ? ballSvg(1, 18) + ' <b>¡Super Ball!</b> ' : '';
      const carGan = [3, 5, 8][r.ball] || 3;
      const txt = document.createElement('div');
      txt.className = 'captura-txt';
      txt.innerHTML = ballTxt + titulo + ' <span class="cap-n">Nº ' + p.id + ' · Nv.' + r.nivel + '</span>' +
        '<span class="cap-tier" style="--tier-color:' + t.color + '">' + (t.ico ? t.ico + ' ' : '') + t.nombre + '</span>' +
        '<span class="cap-prob">🎲 1 de cada <b>' + r.cadaCuantos + '</b> · 🍬 +' + carGan + ' caramelos</span>';
      escena.appendChild(txt);
      $('msg').textContent = r.shiny
        ? '🌟 ¡INCREÍBLE! Un shiny aparece 1 de cada 100 veces.'
        : (legendario ? '👑 ¡Un ' + t.nombre + '! Rarísimo de ver.' : '');
      animando = false; refrescar();
    }
    $('tirar').addEventListener('click', lanzarBall);
  </script>
</Base>
