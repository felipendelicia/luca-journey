---
import Base from '../layouts/Base.astro';
import datos from '../data/ejercicios.json';
import pokemon from '../data/pokemon.json';
import pesos from '../data/rarezas.json';
import { u } from '../lib/url.ts';

const temas = datos.map((w) => ({ slug: w.slug, region: w.region, ejercicios: w.ejercicios.map((e) => ({ id: e.id })) }));
const total = pokemon.length;
---
<Base title="Safari — Python con Pokémon" active="Pokédex">
  <div class="wrap safari">
    <div class="safari-head">
      <h1>🎒 Safari Pokémon</h1>
      <a class="navlink" href={u('/pokedex')}>📕 Ver mi Pokédex</a>
    </div>
    <p>Tirá Pokéballs para atrapar Pokémon salvajes. Ganás Pokéballs <strong>resolviendo ejercicios</strong> (+2 c/u) y con el <strong>regalo cada 20 min</strong> (+5). ⚡</p>

    <div class="safari-barra">
      <div class="ss-item"><span class="ss-ico">🔴</span><b id="balls">0</b><span class="ss-lbl">Pokéballs</span></div>
      <div class="ss-item"><span class="ss-ico">📕</span><b id="colN">0</b><span class="ss-lbl">de {total}</span></div>
      <button class="btn-regalo" id="regalo">🎁 Regalo (+5)</button>
    </div>
    <p class="safari-regiones" id="regiones"></p>

    <div class="safari-arena">
      <div class="arena-pasto" id="arena">
        <div class="arena-vacio" id="vacio">El pasto se mueve… 🌿<br /><small>Tirá una Pokéball para ver qué aparece.</small></div>
      </div>
      <button class="btn-tirar" id="tirar">¡Tirá la Pokéball! 🔴</button>
      <p class="safari-msg" id="msg"></p>
    </div>
  </div>

  <script type="application/json" id="safari-data" set:html={JSON.stringify({ pokemon, temas, pesos })}></script>
  <script>
    import { sincronizar, tirar as lanzar, estado, reclamarRegalo, regaloDisponible, regionesDesbloqueadas, spriteUrl } from '../lib/coleccion.js';
    import { sonarCaptura, sonarShiny } from '../lib/sonidos.js';

    const D = JSON.parse(document.getElementById('safari-data').textContent);
    const $ = (id) => document.getElementById(id);
    const REGN = { kanto: '🔴 Kanto', johto: '⚪ Johto', hoenn: '🟢 Hoenn', sinnoh: '🔵 Sinnoh', unova: '⚫ Unova', kalos: '🟠 Kalos' };

    function refrescar() {
      const e = estado();
      $('balls').textContent = e.balls;
      $('colN').textContent = e.unicos;
      $('tirar').disabled = e.balls <= 0;
      $('regalo').style.display = regaloDisponible() ? '' : 'none';
      const d = regionesDesbloqueadas(D.temas);
      $('regiones').innerHTML = 'Aparecen: ' +
        ['kanto', 'johto', 'hoenn', 'sinnoh', 'unova', 'kalos'].map((r) => d.has(r) ? '<b>' + REGN[r] + '</b>' : '<span class="bloq">' + REGN[r] + ' 🔒</span>').join(' · ') +
        ' &nbsp;<small>(hacé ejercicios de una región para desbloquearla)</small>';
    }

    // otorga lo pendiente (balls por ejercicios, capturas por hitos)
    const nuevo = sincronizar(D.temas);
    if (nuevo.balls || nuevo.capturas.length) {
      const partes = [];
      if (nuevo.balls) partes.push('🔴 +' + nuevo.balls + ' Pokéballs');
      if (nuevo.capturas.length) partes.push('🎉 ' + nuevo.capturas.length + ' captura(s) por hitos');
      $('msg').textContent = partes.join('  ·  ');
    }
    refrescar();

    $('regalo').addEventListener('click', () => {
      const n = reclamarRegalo();
      if (n) $('msg').textContent = '🎁 ¡Regalo! +' + n + ' Pokéballs · volvé en 20 min';
      refrescar();
    });
    // el botón reaparece solo cuando se cumple el cooldown (sin recargar)
    setInterval(() => { if (regaloDisponible() && $('regalo').style.display === 'none') refrescar(); }, 20000);

    const esperar = (ms) => new Promise((res) => setTimeout(res, ms));
    function estrellas(arena, dorado) {
      for (let i = 0; i < 16; i++) {
        const s = document.createElement('span');
        s.className = 'estrella' + (dorado ? ' oro' : '');
        const ang = (Math.PI * 2 * i) / 16, dist = 80 + Math.random() * 70;
        s.style.setProperty('--dx', Math.cos(ang) * dist + 'px');
        s.style.setProperty('--dy', Math.sin(ang) * dist + 'px');
        s.textContent = dorado ? '✨' : '⭐';
        arena.appendChild(s);
        setTimeout(() => s.remove(), 900);
      }
    }

    let animando = false;
    async function lanzarBall() {
      if (animando) return;
      const r = lanzar(D.pokemon, D.temas, D.pesos);
      if (r.error === 'sin-balls') { $('msg').textContent = 'Te quedaste sin Pokéballs. Resolvé ejercicios o esperá el regalo (cada 20 min). 💪'; return; }
      if (r.error) { $('msg').textContent = 'Hacé un ejercicio para desbloquear Pokémon salvajes. 💪'; return; }
      animando = true;
      const btn = $('tirar'); btn.disabled = true;
      const p = r.pokemon, arena = $('arena');
      $('msg').textContent = '¡Un Pokémon salvaje apareció!';
      arena.innerHTML =
        '<div class="escena">' +
        '<img class="wild silueta" src="' + spriteUrl(p.id, r.shiny) + '" alt="?" />' +
        '<div class="pokeball lanza" id="pb"></div></div>';
      const wild = arena.querySelector('.wild'), pb = $('pb');

      await esperar(650);                 // el salvaje salta en el pasto
      pb.classList.remove('lanza'); pb.classList.add('vuela');  // tirás la ball (arco)
      await esperar(480);
      pb.classList.remove('vuela'); pb.classList.add('piso');
      wild.classList.add('absorbido'); arena.classList.add('flash');  // lo absorbe
      await esperar(360); arena.classList.remove('flash');
      $('msg').textContent = '¿La atrapará?';
      for (let i = 0; i < 3; i++) {       // 3 tambaleos de suspenso
        pb.classList.add('tambalea'); await esperar(560); pb.classList.remove('tambalea'); await esperar(150);
      }
      // ¡atrapado!
      pb.classList.add('abre');
      wild.classList.remove('silueta', 'absorbido');
      wild.classList.add('revelado'); if (r.shiny) wild.classList.add('shiny');
      estrellas(arena.querySelector('.escena'), r.shiny);
      if (r.shiny) { document.body.classList.add('shiny-flash'); setTimeout(() => document.body.classList.remove('shiny-flash'), 700); sonarShiny(); }
      else sonarCaptura();

      const titulo = r.shiny
        ? '✨ ¡Un <b>' + p.nombre + '</b> SHINY! ✨'
        : (r.repetido ? '¡Otro <b>' + p.nombre + '</b>! Ya tenés <b>' + r.cantidad + '</b>' : '¡Atrapaste a <b>' + p.nombre + '</b>!');
      const pct = (r.prob * 100).toFixed(2);   // 0.00–100.00 (2 decimales)
      const txt = document.createElement('div');
      txt.className = 'captura-txt';
      txt.innerHTML = titulo + ' <span class="cap-n">Nº ' + p.id + '</span>' +
        '<span class="cap-prob">🎲 probabilidad de aparición: <b>' + pct + '%</b></span>';
      arena.querySelector('.escena').appendChild(txt);
      $('msg').textContent = r.shiny ? '🌟 ¡INCREÍBLE! Un shiny aparece 1 de cada 100 veces.' : '';
      animando = false; refrescar();
    }
    $('tirar').addEventListener('click', lanzarBall);
  </script>
</Base>
