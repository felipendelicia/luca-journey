---
import Base from '../layouts/Base.astro';
import datos from '../data/ejercicios.json';
import pokemon from '../data/pokemon.json';
import { ballSvg } from '../lib/sprites.js';
import { u } from '../lib/url.ts';

const temas = datos.map((w) => ({ slug: w.slug, region: w.region, ejercicios: w.ejercicios.map((e) => ({ id: e.id })) }));
const total = pokemon.length;
---
<Base title="Safari — Python con Pokémon" active="Pokédex">
  <div class="wrap safari">
    <div class="safari-head">
      <h1>🎒 Safari Pokémon</h1>
      <button class="navlink btn-rarezas" id="btn-rarezas" type="button">✨ ¿Cómo funcionan las rarezas?</button>
      <a class="navlink" href={u('/tienda')}>🛒 Tienda</a>
      <a class="navlink" href={u('/pokedex')}>📕 Ver mi Pokédex</a>
    </div>
    <p>Buscá en el pasto, elegí tu Ball y cerrá el <strong>anillo de captura</strong> en el momento justo. Ganás Pokéballs <strong>resolviendo ejercicios</strong> (+2 c/u), <strong>ganando batallas</strong> (+5) y con el <strong>regalo cada 20 min</strong> (+8). ⚡</p>

    <div class="safari-barra">
      <div class="ss-item"><span class="ss-ico" set:html={ballSvg(0, 22)}></span><b id="balls">0</b><span class="ss-lbl">Pokéballs</span></div>
      <div class="ss-item"><span class="ss-ico">📕</span><b id="colN">0</b><span class="ss-lbl">de {total}</span></div>
      <div class="ss-item ss-racha" id="ss-racha" hidden><span class="ss-ico">🔥</span><b id="rachaN">0</b><span class="ss-lbl">Racha</span></div>
      <button class="btn-regalo" id="regalo">🎁 Regalo (+8)</button>
    </div>
    <div class="safari-amb" id="amb"></div>
    <p class="safari-regiones" id="regiones"></p>

    <!-- compañero (Sincronía) -->
    <div class="comp-fila" id="comp-fila"></div>

    <div class="safari-arena">
      <div class="arena-pasto" id="arena">
        <div class="arena-vacio" id="vacio">El pasto se mueve… 🌿<br /><small>Buscá para ver qué aparece.</small></div>
      </div>
      <button class="btn-tirar" id="buscar">Buscar en el pasto 🌿</button>
      <p class="safari-msg" id="msg"></p>
    </div>
  </div>

  <div class="rar-modal" id="rar-modal" hidden>
    <div class="rar-card">
      <button class="rar-x" id="rar-x" type="button" aria-label="Cerrar">✕</button>
      <h2>✨ Rarezas del Safari</h2>
      <p>Cada Pokémon tiene una <b>rareza</b>. Cuanto más raro, <b>menos aparece</b> y más difícil es atraparlo. El <b>🌟 shiny</b> (~1%) y el <b>👑 alfa</b> (~4%) pueden tocar sobre cualquier rareza.</p>
      <div class="rar-lista" id="rar-lista"></div>
    </div>
  </div>

  <!-- picker de compañero -->
  <div class="rar-modal" id="comp-modal" hidden>
    <div class="rar-card comp-card">
      <button class="rar-x" id="comp-x" type="button" aria-label="Cerrar">✕</button>
      <h2>🤝 Elegí tu compañero</h2>
      <p>Te acompaña en el Safari. Si tiene <b>Sincronía</b>, fija la naturaleza de los salvajes que encontrás. ✨</p>
      <div class="comp-grid" id="comp-grid"></div>
    </div>
  </div>

  <!-- overlay del minijuego de anillo -->
  <div class="ring-overlay" id="ring-overlay" hidden>
    <div class="ring-stage">
      <div class="ring-wild" id="ring-wild"></div>
      <svg class="ring-svg" id="ring-svg" viewBox="0 0 200 200" aria-hidden="true">
        <circle class="ring-target" cx="100" cy="100" r="42"></circle>
        <circle class="ring-move" id="ring-move" cx="100" cy="100" r="96"></circle>
      </svg>
    </div>
    <div class="ring-label" id="ring-label"></div>
    <button class="ring-cta" id="ring-cta" type="button">¡Tirá! 🎯</button>
    <span class="ring-hint">Tocá la pantalla o el botón cuando el anillo entre al blanco</span>
  </div>

  <script type="application/json" id="safari-data" set:html={JSON.stringify({ temas })}></script>
  <script>
    import { sincronizar, encontrar, capturar, inventarioBalls, tieneBall, companero, setCompanero,
      identidadDe, naturalezaDe, habMeta, ivPct, ivEstrellas, estado, vistos, reclamarRegalo,
      regaloDisponible, regionesDesbloqueadas, spriteUrl, pc, renombrar, caramelosDe, CARAMELOS_POR_CAPTURA,
      racha, romperRacha } from '../lib/coleccion.js';
    import { biomaActual, esNoche } from '../lib/safari-core.js';
    import { sonarCaptura, sonarShiny, sonarEpico, sonarExito, sonarError, sonarClick, volumen } from '../lib/sonidos.js';
    import { TIERS } from '../lib/rareza.js';
    import { itemSvg } from '../lib/sprites.js';
    import { REGIONES as REGS, etiqueta } from '../lib/regiones.mjs';
    import pokemon from '../data/pokemon.json';   // módulo → chunk /_astro cacheado (compartido con pokedex/liga)
    import pesos from '../data/aparicion.json';

    const meta = JSON.parse(document.getElementById('safari-data').textContent);
    const D = { pokemon, pesos, temas: meta.temas };
    const $ = (id) => document.getElementById(id);
    const byId = (id) => D.pokemon.find((p) => p.id === id);
    const nombreDe = (id) => (byId(id) || {}).nombre || ('Nº ' + id);
    const esperar = (ms) => new Promise((res) => setTimeout(res, ms));

    // ── estado del encuentro ─────────────────────────────────────────────
    let enc = null, tiroN = 0, ballSel = null, animando = false;

    // grito (cry) del Pokémon — PokeAPI .ogg, igual que en /batalla
    const CRY_BASE = 'https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/';
    function cry(idp, vol = 0.5) { try { const a = new Audio(CRY_BASE + idp + '.ogg'); a.volume = Math.max(0, Math.min(1, vol * volumen())); a.play().catch(() => {}); } catch {} }

    // resumen de identidad de la captura: género · IVs% · naturaleza · habilidad. Una línea.
    function capIdentidad(inst) {
      if (!inst) return '';
      const idn = identidadDe(inst), nat = naturalezaDe(inst), hm = habMeta(idn.hab);
      const gen = idn.gen === 'm' ? '<i class="cap-gm">♂</i>' : idn.gen === 'f' ? '<i class="cap-gf">♀</i>' : '';
      const pct = ivPct(idn.ivs), pctCls = pct >= 90 ? ' cap-iv-top' : pct >= 75 ? ' cap-iv-good' : '';
      const partes = [gen, '<span class="cap-iv' + pctCls + '">IVs ' + pct + '%</span>', nat.nombre];
      if (hm) partes.push(hm.nombre);
      return '<span class="cap-id">✨ ' + partes.filter(Boolean).join(' <i class="cap-dot">·</i> ') + '</span>';
    }

    // estrellas de tasación: estrellas llenas vs vacías sobre 4
    const tasacion = (n) => '★★★★'.slice(0, n) + '☆☆☆☆'.slice(0, 4 - n);

    // modal explicativo de rarezas (poblado desde TIERS)
    (function rarezas() {
      const lista = $('rar-lista'), modal = $('rar-modal');
      if (!lista || !modal) return;
      const fila = (color, etiqueta, tasa) =>
        '<div class="rar-fila"><span class="cap-tier" style="--tier-color:' + color + '">' + etiqueta + '</span>'
        + '<span class="rar-tasa">' + tasa + '</span></div>';
      lista.innerHTML = TIERS.map((t) =>
        fila(t.color, (t.ico ? t.ico + ' ' : '') + t.nombre, '~' + (t.rate * 100).toFixed(t.rate < 0.01 ? 2 : 1) + '%')
      ).join('') + fila('#ffd23f', '🌟 Shiny', '~1%') + fila('#b06bff', '👑 Alfa', '~4%');
      const cerrar = () => { modal.hidden = true; };
      $('btn-rarezas') && $('btn-rarezas').addEventListener('click', () => { modal.hidden = false; });
      $('rar-x') && $('rar-x').addEventListener('click', cerrar);
      modal.addEventListener('click', (e) => { if (e.target === modal) cerrar(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(); });
    })();

    function refrescar() {
      const e = estado();
      $('balls').textContent = e.balls;
      const v = vistos();
      $('colN').textContent = D.pokemon.filter((p) => v.has(p.id)).length;
      const rN = racha();
      $('ss-racha').hidden = rN < 1;
      $('rachaN').textContent = rN;
      const bioma = biomaActual(), noche = esNoche();
      const BIOMAS = { hierba: '🌿 Hierba', agua: '💧 Agua', cueva: '🪨 Cueva' };
      $('amb').innerHTML = '<span class="amb-chip amb-' + bioma + '">' + BIOMAS[bioma] + '</span><span class="amb-chip amb-' + (noche ? 'noche' : 'dia') + '">' + (noche ? '🌙 Noche' : '☀️ Día') + '</span>';
      $('regalo').style.display = regaloDisponible() ? '' : 'none';
      const d = regionesDesbloqueadas(D.temas);
      $('regiones').innerHTML = 'Aparecen: ' +
        REGS.map((r) => d.has(r.id) ? '<b>' + etiqueta(r) + '</b>' : '<span class="bloq">' + etiqueta(r) + ' 🔒</span>').join(' · ') +
        ' &nbsp;<small>(hacé ejercicios de una región para desbloquearla)</small>';
      renderComp();
    }

    // otorga lo pendiente (balls por ejercicios, capturas por hitos)
    const nuevo = sincronizar(D.temas);
    if (nuevo.balls || nuevo.capturas.length) {
      const partes = [];
      if (nuevo.balls) partes.push('🔴 +' + nuevo.balls + ' Pokéballs');
      if (nuevo.capturas.length) partes.push('🎉 ' + nuevo.capturas.length + ' captura(s) por hitos');
      $('msg').textContent = partes.join('  ·  ');
    }
    refrescar();

    $('regalo').addEventListener('click', () => {
      const n = reclamarRegalo();
      if (n) $('msg').textContent = '🎁 ¡Regalo! +' + n + ' Pokéballs · volvé en 20 min';
      refrescar();
    });
    setInterval(() => { if (regaloDisponible() && $('regalo').style.display === 'none') refrescar(); }, 20000);
    // bioma/hora cambian solos según el reloj → refrescá la barra de ambiente periódicamente
    setInterval(refrescar, 30000);

    // ── FX (estrellas) ───────────────────────────────────────────────────
    function estrellas(escena, { n = 16, dorado = false, color = '#ffd23f' } = {}) {
      for (let i = 0; i < n; i++) {
        const s = document.createElement('span');
        s.className = 'estrella' + (dorado ? ' oro' : '');
        const ang = (Math.PI * 2 * i) / n, dist = 80 + Math.random() * 90;
        s.style.setProperty('--dx', Math.cos(ang) * dist + 'px');
        s.style.setProperty('--dy', Math.sin(ang) * dist + 'px');
        if (!dorado) s.style.color = color;
        s.textContent = dorado ? '✨' : '⭐';
        escena.appendChild(s);
        setTimeout(() => s.remove(), 1000);
      }
    }
    // confeti azul-oro Xeneize 💙💛
    function confetiXeneize(escena, n = 34) {
      for (let i = 0; i < n; i++) {
        const c = document.createElement('span');
        c.className = 'confeti';
        const ang = (Math.PI * 2 * i) / n + Math.random() * 0.4, dist = 90 + Math.random() * 120;
        c.style.setProperty('--dx', Math.cos(ang) * dist + 'px');
        c.style.setProperty('--dy', Math.sin(ang) * dist + 'px');
        c.style.setProperty('--rot', (Math.random() * 720 - 360) + 'deg');
        c.style.background = i % 2 ? '#2f6fcc' : '#ffcb05';
        c.style.animationDelay = (Math.random() * 0.12) + 's';
        escena.appendChild(c);
        setTimeout(() => c.remove(), 1200);
      }
    }

    // ── compañero ────────────────────────────────────────────────────────
    function renderComp() {
      const fila = $('comp-fila'); if (!fila) return;
      const comp = companero();
      let inner = '<span class="comp-tag">Compañero</span>';
      if (comp) {
        const sync = identidadDe(comp).hab === 'synchronize';
        inner += '<img class="comp-mini" src="' + spriteUrl(comp.id, comp.shiny) + '" alt="" />'
          + '<b class="comp-nom">' + (comp.mote || nombreDe(comp.id)) + '</b>'
          + (sync ? '<span class="comp-sync">🔗 Sincronía · fija la naturaleza</span>' : '');
      } else {
        inner += '<span class="comp-none">ninguno</span>';
      }
      inner += '<button class="comp-cambiar" id="comp-cambiar" type="button">' + (comp ? 'Cambiar' : 'Elegir') + '</button>';
      fila.innerHTML = inner;
      $('comp-cambiar').addEventListener('click', abrirComp);
    }
    function abrirComp() {
      const grid = $('comp-grid'), modal = $('comp-modal');
      const mios = pc();
      const compAct = companero();
      const cards = mios.map((m) => {
        const sync = identidadDe(m).hab === 'synchronize';
        const sel = compAct && compAct.iid === m.iid ? ' sel' : '';
        return '<button class="comp-pick' + sel + (sync ? ' es-sync' : '') + '" data-iid="' + m.iid + '" type="button">'
          + '<img src="' + spriteUrl(m.id, m.shiny) + '" alt="" />'
          + '<span class="comp-pick-nom">' + (m.mote || nombreDe(m.id)) + '</span>'
          + (sync ? '<span class="comp-pick-sync">🔗 Sincronía</span>' : '<span class="comp-pick-lvl">Nv ' + m.nivel + '</span>')
          + '</button>';
      }).join('');
      const ninguno = '<button class="comp-pick comp-pick-none' + (!compAct ? ' sel' : '') + '" data-iid="" type="button">'
        + '<span class="comp-pick-x">✕</span><span class="comp-pick-nom">Ninguno</span></button>';
      grid.innerHTML = ninguno + (cards || '<p class="comp-vacio">Todavía no tenés Pokémon. Atrapá uno primero. 🌿</p>');
      grid.querySelectorAll('.comp-pick').forEach((b) => b.addEventListener('click', () => {
        const iid = b.dataset.iid || null;
        setCompanero(iid); sonarClick(); modal.hidden = true; renderComp();
      }));
      modal.hidden = false;
    }
    (function compModal() {
      const modal = $('comp-modal');
      $('comp-x').addEventListener('click', () => { modal.hidden = true; });
      modal.addEventListener('click', (e) => { if (e.target === modal) modal.hidden = true; });
    })();

    // ── PASO 1: buscar y mostrar la carta de encuentro ───────────────────
    function tier(nivel) {
      return TIERS.find((t) => t.nivel === nivel) || { nivel: 1, nombre: 'Común', color: '#7d8b79', ico: '' };
    }
    function buscar() {
      if (animando) return;
      const r = encontrar(D.pokemon, D.temas, D.pesos);
      if (r.error === 'vacio') { $('msg').textContent = 'Hacé un ejercicio para desbloquear Pokémon salvajes. 💪'; return; }
      enc = r; tiroN = 0;
      const balls = inventarioBalls();
      ballSel = balls[0]?.key ?? null;
      // el pasto se sacude → emerge el salvaje (diorama)
      animando = true;
      $('arena').innerHTML = '<div class="arena-rustle" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>';
      sonarClick();
      $('msg').textContent = 'Algo se mueve en el pasto… 🌿';
      setTimeout(() => {
        animando = false;
        $('msg').textContent = '¡Un ' + nombreDe(enc.id) + ' salvaje apareció!';
        renderCarta();
        cry(enc.id, 0.55);
      }, 470);
    }

    function renderCarta() {
      if (!enc) { $('arena').innerHTML = '<div class="arena-vacio" id="vacio">El pasto se mueve… 🌿<br /><small>Buscá para ver qué aparece.</small></div>'; return; }
      const t = tier(enc.rarezaTier);
      const nombre = nombreDe(enc.id);
      const balls = inventarioBalls();
      const chips = balls.length
        ? balls.map((b) => '<button class="ball-chip' + (b.key === ballSel ? ' sel' : '') + '" data-key="' + b.key + '" type="button" title="' + b.nombre + '">'
            + '<span class="ball-chip-ico">' + itemSvg(b.sprite, 26) + '</span><span class="ball-chip-n">×' + b.n + '</span></button>').join('')
        : '<span class="ball-vacio">No tenés Pokéballs. Resolvé ejercicios o pasá por la Tienda. 💪</span>';
      $('arena').innerHTML =
        '<div class="enc-card escena tier-' + t.nivel + (enc.shiny ? ' es-shiny' : '') + (enc.alfa ? ' es-alfa' : '') + '" style="--tier-color:' + t.color + '">'
        + '<div class="enc-stage">'
          + (enc.alfa ? '<span class="enc-aura"></span>' : '')
          + '<span class="enc-sombra" aria-hidden="true"></span>'
          + '<img class="enc-sprite emerge' + (enc.shiny ? ' shiny' : '') + '" src="' + spriteUrl(enc.id, enc.shiny) + '" alt="' + nombre + '" />'
          + (enc.shiny ? '<span class="enc-badge enc-shiny">✨</span>' : '')
          + (enc.alfa ? '<span class="enc-badge enc-alfa">👑</span>' : '')
          + '<span class="enc-grass" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>'
        + '</div>'
        + '<div class="enc-panel">'
          + '<div class="enc-info">'
            + '<div class="enc-name">' + nombre + ' <span class="enc-lvl">Nv ' + enc.nivel + '</span></div>'
            + '<span class="cap-tier" style="--tier-color:' + t.color + '">' + (t.ico ? t.ico + ' ' : '') + t.nombre + '</span>'
            + '<div class="enc-tasa" title="Potencial genético: qué tan buenos son sus genes (IVs). Más estrellas = mejores stats al mismo nivel.">'
              + '<span class="enc-tasa-lbl">⭐ Potencial</span>'
              + '<span class="enc-stars s' + enc.estrellas + '">' + tasacion(enc.estrellas) + '</span>'
              + '<i class="enc-tasa-q" aria-hidden="true">?</i>'
            + '</div>'
            + '<div class="enc-nat">' + enc.naturalezaNombre + (enc.vistoYa ? ' <i class="enc-visto">· ya visto</i>' : '') + '</div>'
          + '</div>'
          + '<div class="ball-selector" id="ball-selector">' + chips + '</div>'
          + '<div class="enc-acciones">'
            + '<button class="enc-btn enc-huir" id="enc-huir" type="button">Huir</button>'
            + '<button class="enc-btn enc-tirar" id="enc-tirar" type="button"' + (ballSel ? '' : ' disabled') + '>Tirar Ball</button>'
          + '</div>'
        + '</div>'
        + '</div>';
      // listeners de la carta
      $('ball-selector').querySelectorAll('.ball-chip').forEach((c) => c.addEventListener('click', () => {
        ballSel = c.dataset.key; sonarClick();
        $('ball-selector').querySelectorAll('.ball-chip').forEach((x) => x.classList.toggle('sel', x.dataset.key === ballSel));
        $('enc-tirar').disabled = !ballSel;
      }));
      $('enc-huir').addEventListener('click', () => { romperRacha(); enc = null; $('msg').textContent = 'Te alejaste sin tirar. 🌿'; refrescar(); renderCarta(); });
      $('enc-tirar').addEventListener('click', tirar);
    }

    // ── PASO 2: minijuego de anillo + secuencia de captura ───────────────
    async function tirar() {
      if (animando || !enc || !ballSel) return;
      const calidad = await jugarAnillo();
      if (calidad == null) return;   // cancelado
      tiroN++;
      const rachaPrevia = racha();   // capturar() rompe la racha en `huyo`; guardamos la previa para el mensaje
      const r = capturar(enc, ballSel, calidad, { tiroN });
      if (r.error === 'sin-ball') {
        $('msg').textContent = 'No te quedan de esa ball. Elegí otra. 🔴';
        ballSel = inventarioBalls()[0]?.key ?? null;
        renderCarta(); return;
      }
      const ctx = await secuenciaBall(r);   // absorbe + sacude (3 si cae, 1-2 si falla) + abre/confirma
      if (r.ok) { await resumenCaptura(r, ctx); return; }
      if (r.huyo) {
        $('msg').textContent = rachaPrevia >= 2
          ? '¡' + nombreDe(enc.id) + ' se escapó! 🌿💔 Se cortó la racha.'
          : '¡' + nombreDe(enc.id) + ' se escapó! 🌿';
        sonarError();
        const sp = ctx && ctx.sp; if (sp) sp.classList.add('huye');
        await esperar(440);
        enc = null; animando = false; renderCarta(); refrescar();
        return;
      }
      // zafó → se queda; podés volver a tirar (otra oportunidad)
      $('msg').textContent = '¡Casi! Se soltó. Probá de nuevo. 🔁';
      animando = false;
      renderCarta();
    }

    // Absorbe al salvaje en la ball, la ball cae y SE SACUDE (3 si cae, 1-2 si falla).
    // Devuelve {escena, stage, sp, ball}. En éxito deja la ball quieta; en fallo la abre y saca al Pokémon.
    async function secuenciaBall(r) {
      animando = true;
      const escena = $('arena').querySelector('.enc-card');
      const stage = escena && escena.querySelector('.enc-stage');
      const sp = stage && stage.querySelector('.enc-sprite');
      if (!stage || !sp) { animando = false; return {}; }
      const panel = escena.querySelector('.enc-panel'); if (panel) panel.classList.add('resolviendo');
      const ballMeta = inventarioBalls().find((b) => b.key === r.ball);
      const ball = document.createElement('div');
      ball.className = 'enc-catchball';
      ball.innerHTML = itemSvg((ballMeta && ballMeta.sprite) || 'ball0', 48);
      stage.appendChild(ball);
      sonarClick();
      await esperar(120);
      sp.classList.add('absorbido'); ball.classList.add('abierta');     // haz de luz: absorbe
      await esperar(360);
      sp.style.visibility = 'hidden'; ball.classList.remove('abierta'); ball.classList.add('cae');
      await esperar(330);
      ball.classList.remove('cae'); ball.classList.add('posada');   // queda APOYADA: sacar .cae evita que la caída se re-dispare al togglear .sacude
      const nShakes = r.ok ? 3 : (r.huyo ? 1 : 2);
      for (let i = 0; i < nShakes; i++) {
        ball.classList.add('sacude'); sonarClick();
        await esperar(440);
        ball.classList.remove('sacude');
        await esperar(160);
      }
      if (r.ok) { ball.classList.add('atrapada'); sonarClick(); return { escena, stage, sp, ball }; }
      // falló: la ball se abre, el Pokémon vuelve a salir
      ball.classList.add('reabre'); await esperar(170);
      ball.remove();
      sp.style.visibility = ''; sp.classList.remove('absorbido'); sp.classList.add('reaparece');
      await esperar(380); sp.classList.remove('reaparece');
      return { escena, stage, sp };
    }

    // Tarjeta de RESUMEN tras una captura exitosa: badges, potencial ⭐+IV%, naturaleza/habilidad,
    // caramelos, "¡nuevo en la Pokédex!" y acciones (Buscar otro · Ver en Pokédex · Apodar).
    async function resumenCaptura(r, ctx) {
      animando = true;
      const escena = (ctx && ctx.escena) || $('arena').querySelector('.enc-card');
      const ball = ctx && ctx.ball, sp = ctx && ctx.sp;
      const t = tier(enc.rarezaTier);
      const especial = enc.shiny || enc.alfa;
      const nuevo = !enc.vistoYa;
      escena.classList.add('capturado');
      const nP = especial ? 30 : t.nivel >= 7 ? 24 : t.nivel >= 4 ? 18 : 12;
      estrellas(escena, { n: nP, dorado: especial, color: enc.shiny ? '#ffd23f' : enc.alfa ? '#b06bff' : t.color });
      if (r.ball === 'xeneize') confetiXeneize(escena, 38);
      if (especial) { document.body.classList.add('tier-shake'); setTimeout(() => document.body.classList.remove('tier-shake'), 600); }
      if (enc.shiny) { document.body.classList.add('shiny-flash'); setTimeout(() => document.body.classList.remove('shiny-flash'), 700); sonarShiny(); }
      else if (enc.alfa || t.nivel >= 7) sonarEpico(); else sonarCaptura();
      await esperar(340);
      if (ball) ball.remove();

      // tamaño/título del ejemplar: colosos (XL/XXL o alfa) y minis (XXS) escalan el sprite y ganan un título
      const tam = enc.tam || 'M';
      const colosal = tam === 'XL' || tam === 'XXL' || enc.alfa;
      const mini = tam === 'XXS';
      const tituloTam = colosal ? { ico: '👑', txt: 'Coloso', cls: 'cap-tam-xl' }
        : mini ? { ico: '🔬', txt: 'Mini', cls: 'cap-tam-xxs' } : null;
      const tamCls = tam === 'XXL' || (enc.alfa && tam === 'XL') ? 'tam-xxl'
        : (tam === 'XL' || enc.alfa) ? 'tam-xl' : mini ? 'tam-xxs' : '';

      if (sp) { sp.style.visibility = ''; sp.classList.remove('absorbido'); if (tamCls) sp.classList.add(tamCls); sp.classList.add('reaparece'); setTimeout(() => sp.classList.remove('reaparece'), 420); }

      const nombre = nombreDe(enc.id);
      const idn = identidadDe(r.inst), nat = naturalezaDe(r.inst), hm = habMeta(idn.hab);
      const pct = ivPct(idn.ivs), est = ivEstrellas(idn.ivs);
      const gen = idn.gen === 'm' ? '<span class="cap-gm">♂</span>' : idn.gen === 'f' ? '<span class="cap-gf">♀</span>' : '';
      const titulo = enc.shiny ? '✨ ¡<b>' + nombre + '</b> SHINY!' : enc.alfa ? '👑 ¡<b>' + nombre + '</b> ALFA!' : '¡Atrapaste a <b>' + nombre + '</b>!';
      const carTot = caramelosDe(enc.id);
      const calCls = { Excelente: 'cal-exc', Genial: 'cal-gen', Bien: 'cal-bien', Normal: 'cal-norm' }[r.calidad] || 'cal-norm';
      const hrefPokedex = (window.__BASE || '') + '/pokedex';
      // racha: ×N a partir de 2; intensidad escala con la racha (cap a 4 niveles)
      const rachaN = r.racha || 0;
      const rachaLvl = rachaN >= 15 ? 4 : rachaN >= 8 ? 3 : rachaN >= 4 ? 2 : 1;
      const rachaLinea = rachaN >= 2
        ? '<div class="cap-racha cap-racha-' + rachaLvl + '"><span class="cap-racha-fuego">🔥</span> Racha <b>×' + rachaN + '</b></div>'
        : '';
      const tituloLinea = tituloTam
        ? '<div class="cap-tam ' + tituloTam.cls + '">' + tituloTam.ico + ' ' + tituloTam.txt + '</div>'
        : '';
      const tamChip = tam !== 'M' ? '<span class="cap-b cap-b-tam">' + tam + '</span>' : '';
      const html =
        '<div class="cap-resumen">' +
          '<div class="cap-r-titulo">' + titulo + '</div>' +
          tituloLinea +
          (nuevo ? '<div class="cap-nuevo">📒 ¡Nuevo en la Pokédex!</div>' : '') +
          rachaLinea +
          '<div class="cap-r-linea"><span class="cap-r-nv">Nv ' + enc.nivel + '</span>' + gen +
            (enc.alfa ? '<span class="cap-b cap-b-alfa">👑 Alfa</span>' : '') +
            (enc.shiny ? '<span class="cap-b cap-b-shiny">✨ Shiny</span>' : '') +
            tamChip + '</div>' +
          '<div class="cap-pot" title="Potencial genético: qué tan buenos son sus IVs (genes)."><span class="cap-pot-lbl">⭐ Potencial</span>' +
            '<span class="enc-stars s' + est + '">' + tasacion(est) + '</span>' +
            '<span class="cap-iv' + (pct >= 90 ? ' cap-iv-top' : pct >= 75 ? ' cap-iv-good' : '') + '">IVs ' + pct + '%</span></div>' +
          '<div class="cap-r-meta"><span>' + nat.nombre + '</span>' + (hm ? '<i class="cap-dot">·</i><span>' + hm.nombre + '</span>' : '') +
            '<i class="cap-dot">·</i><span class="cap-car">🍬 +' + CARAMELOS_POR_CAPTURA + ' <small>(' + carTot + ')</small></span></div>' +
          '<div class="cap-cal ' + calCls + '">🎯 Tiro ' + r.calidad + '</div>' +
          '<div class="cap-acciones">' +
            '<button class="cap-act cap-act-main" id="cap-otro" type="button">🌿 Buscar otro</button>' +
            '<a class="cap-act" href="' + hrefPokedex + '">📒 Ver en Pokédex</a>' +
            '<button class="cap-act" id="cap-apodar" type="button">✏️ Apodar</button>' +
          '</div>' +
        '</div>';
      const panel = escena.querySelector('.enc-panel');
      if (panel) panel.outerHTML = html; else escena.insertAdjacentHTML('beforeend', html);
      $('msg').textContent = enc.shiny ? '🌟 ¡INCREÍBLE! Un shiny aparece 1 de cada 100.'
        : enc.alfa ? '👑 ¡Un alfa! Llega con 3 IVs perfectos garantizados.'
        : '🍬 ¡Capturado! Seguí buscando 🌿';
      const inst = r.inst;
      enc = null; animando = false; refrescar();
      const bo = $('cap-otro'); if (bo) bo.addEventListener('click', buscar);
      const ap = $('cap-apodar'); if (ap) ap.addEventListener('click', () => {
        const nv = prompt('Apodá a ' + nombre + ':', inst.mote || nombre);
        if (nv != null && nv.trim()) { renombrar(inst.iid, nv.trim()); ap.textContent = '✏️ ' + nv.trim(); ap.disabled = true; }
      });
    }

    // ── minijuego de anillo (overlay) ────────────────────────────────────
    // Devuelve una Promise<calidad|null>. El anillo se contrae de r=96 a r=18 en ~1.1s.
    function jugarAnillo() {
      return new Promise((resolve) => {
        const ov = $('ring-overlay'), move = $('ring-move'), label = $('ring-label'), wild = $('ring-wild');
        const TARGET = 42, R0 = 96, R1 = 18;
        // velocidad RANDOM por tiro: más rápido (más difícil) para raros/alfa, con variación para que no se memorice
        const baseDur = 1500 - enc.rarezaTier * 80;                                    // común ~1420 · legendario ~700
        const DUR = Math.max(560, Math.round(baseDur * (0.82 + Math.random() * 0.42) * (enc.alfa ? 0.8 : 1)));
        wild.innerHTML = '<img src="' + spriteUrl(enc.id, enc.shiny) + '" class="' + (enc.shiny ? 'shiny' : '') + '" alt="" />';
        label.textContent = ''; label.className = 'ring-label';
        ov.hidden = false; ov.classList.add('abierto');
        let done = false, start = performance.now(), raf = 0;

        const radioEn = (now) => {
          const f = Math.min(1, (now - start) / DUR);
          return R0 + (R1 - R0) * f;
        };
        const loop = (now) => {
          if (done) return;
          const r = radioEn(now);
          move.setAttribute('r', r.toFixed(1));
          if (now - start >= DUR) { resolverTiro(null); return; }   // se pasó: tiro tardío
          raf = requestAnimationFrame(loop);
        };

        function calificar(r) {
          if (r == null) return 'Normal';            // tardío / no tiró
          const d = Math.abs(r - TARGET);
          if (d <= 6) return 'Excelente';
          if (d <= 16) return 'Genial';
          if (d <= 30) return 'Bien';
          return 'Normal';
        }
        function resolverTiro(now) {
          if (done) return; done = true;
          cancelAnimationFrame(raf);
          const r = now == null ? null : radioEn(now);
          const cal = calificar(r);
          const cls = { Excelente: 'cal-exc', Genial: 'cal-gen', Bien: 'cal-bien', Normal: 'cal-norm' }[cal];
          label.textContent = '¡' + cal + '!'; label.className = 'ring-label show ' + cls;
          if (cal === 'Excelente') sonarShiny(); else if (cal === 'Genial') sonarExito(); else if (cal === 'Bien') sonarCaptura(); else sonarClick();
          ov.classList.remove('listo');
          setTimeout(() => { ov.hidden = true; ov.classList.remove('abierto'); limpiar(); resolve(cal); }, 620);
        }
        function tap(e) {
          if (done) return;
          e.preventDefault();
          resolverTiro(performance.now());
        }
        function onKey(e) { if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); resolverTiro(performance.now()); } }
        function limpiar() {
          ov.removeEventListener('pointerdown', tap);
          document.removeEventListener('keydown', onKey);
        }
        // tocar cualquier parte del overlay (incluido el botón "¡Tirá!") cuenta
        ov.addEventListener('pointerdown', tap);
        document.addEventListener('keydown', onKey);
        requestAnimationFrame(loop);
      });
    }

    $('buscar').addEventListener('click', buscar);
  </script>
