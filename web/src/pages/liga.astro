---
import Base from '../layouts/Base.astro';
import datos from '../data/ejercicios.json';
import { REGIONES } from '../lib/regiones.mjs';

const BADGES = {
  kanto: [['Roca', '🪨'], ['Cascada', '💧'], ['Trueno', '⚡'], ['Arcoíris', '🌈'], ['Alma', '💗'], ['Pantano', '🟣'], ['Volcán', '🔥'], ['Tierra', '🌍']],
  johto: [['Cifré', '🌀'], ['Colmena', '🐝'], ['Llanura', '🌾'], ['Niebla', '🌫️'], ['Tormenta', '⛈️'], ['Mineral', '⛏️'], ['Glaciar', '❄️'], ['Subida', '🐉']],
  hoenn: [['Piedra', '🗿'], ['Puño', '🥊'], ['Dínamo', '⚙️'], ['Calor', '🌋'], ['Equilibrio', '⚖️'], ['Pluma', '🪶'], ['Mente', '🧠'], ['Lluvia', '🌧️']],
  sinnoh: [['Carbón', '🌑'], ['Bosque', '🌲'], ['Adoquín', '🧱'], ['Pantano', '🐊'], ['Reliquia', '🏺'], ['Mina', '🛢️'], ['Carámbano', '🧊'], ['Faro', '🔦']],
  unova: [['Trío', '🔺'], ['Básica', '🔰'], ['Insecto', '🐛'], ['Rayo', '🔌'], ['Temblor', '🌐'], ['Jet', '🛩️'], ['Hielo', '🥶'], ['Leyenda', '🦾']],
  kalos: [['Insecto', '🐞'], ['Acantilado', '🧗'], ['Lucha', '🤜'], ['Planta', '🍃'], ['Voltaje', '🔋'], ['Hada', '🧚'], ['Psíquica', '🔮'], ['Iceberg', '🏔️']],
  alola: [['Script', '⚙️'], ['Archivo', '📁'], ['Lote', '🔁'], ['Consola', '🖥️'], ['Entorno', '🔑'], ['Reloj', '⏰'], ['Red', '🕸️'], ['Campeón', '🤖']],
  galar: [['Corrutina', '🌀'], ['Await', '⏳'], ['Tareas', '🧵'], ['Gather', '🪢'], ['Cola', '🎟️'], ['Hilos', '🕸️'], ['Límite', '🚦'], ['Campeón', '⚡']],
  paldea: [['Búsqueda', '🔎'], ['Orden', '🔢'], ['Pila', '🥞'], ['Cola', '🚶'], ['Recursión', '🔁'], ['Grafo', '🕸️'], ['Hash', '🗂️'], ['Campeón', '🏆']],
};
function temasDe(region) {
  return datos.filter((w) => (w.region || 'kanto') === region).map((w, i) => ({
    slug: w.slug, titulo: w.titulo, exIds: w.ejercicios.map((e) => e.id),
    gym: (BADGES[region][i] || ['?', '⭐'])[0], emoji: (BADGES[region][i] || ['?', '⭐'])[1],
  }));
}
const regiones = REGIONES.map((r) => ({ id: r.id, nombre: r.nombre, emoji: r.emoji, sub: r.tema, titulo: `Campeón de ${r.nombre}`, temas: temasDe(r.id) }));
const totalEj = regiones.reduce((a, r) => a + r.temas.reduce((b, t) => b + t.exIds.length, 0), 0);
---
<Base title="La Liga — Python con Pokémon" active="Liga">
  <div class="wrap liga">
    <section class="tarjeta">
      <div class="tarjeta-top">
        <div class="avatar" id="avatar" title="Elegí tu foto de perfil">🎓<span class="avatar-cam">📷</span></div>
        <div class="tarjeta-info">
          <label class="t-nombre-l">Tu usuario</label>
          <div class="t-user-row">
            <span class="social-at">@</span>
            <input class="t-nombre" id="nombre" placeholder="tu_usuario" maxlength="20" autocapitalize="off" autocomplete="off" />
            <button class="t-crear" id="social-guardar" type="button" hidden>Crear</button>
          </div>
          <div class="t-rango" id="rango">Novato</div>
          <div class="social-meta" id="social-meta" hidden>
            <span class="cod-chip" title="Tu código de amigo">🎴 <b id="social-codigo"></b></span>
            <a class="meta-btn" id="social-vermio" target="_blank" rel="noopener">👁️ Ver perfil</a>
          </div>
          <p class="social-msg" id="social-msg"></p>
        </div>
        <div class="t-nivel"><span class="t-nivel-n" id="nivel">1</span><span class="t-nivel-l">nivel</span></div>
      </div>
      <div class="t-exp">
        <div class="t-exp-bar"><span id="exp-fill"></span></div>
        <div class="t-exp-txt"><span id="exp-txt">0 EXP</span><span id="exp-next"></span></div>
      </div>
      <div class="t-stats">
        <div><b id="st-ej">0</b><span>ejercicios</span></div>
        <div><b id="st-med">0</b><span>medallas</span></div>
        <div><b id="st-reg">0</b><span>regiones</span></div>
      </div>
    </section>

    <nav class="reg-tabs liga-tabs" id="liga-tabs" role="tablist" aria-label="Secciones de la Liga">
      <button class="reg-tab" type="button" role="tab" data-tab="logros"><span class="rt-emoji">🏅</span><span class="rt-name">Logros</span><span class="rt-chip" id="tab-logros-n"></span></button>
      {regiones.map((r) => (
        <button class="reg-tab" type="button" role="tab" data-tab={r.id} data-region={r.id} title={r.sub}>
          <span class="rt-emoji">{r.emoji}</span><span class="rt-name">{r.nombre}</span>
          <span class="rt-chip" data-prog={r.id}></span><span class="rt-bar"><i data-bar={r.id}></i></span>
        </button>
      ))}
    </nav>

    <section class="liga-panel" data-tab="logros" role="tabpanel" hidden>
      <h2 class="liga-h">🏆 Logros <span class="reg-estado" id="logros-n"></span></h2>
      <div class="logros-grid" id="logros"></div>
    </section>
    {regiones.map((r) => (
      <section class="liga-panel region" data-region={r.id} data-tab={r.id} role="tabpanel" hidden>
        <h2 class="liga-h">{r.emoji} Región {r.nombre} <small>— {r.sub}</small> <span class="reg-estado" data-reg={r.id}></span> <button class="diploma-btn" type="button" data-diploma={r.id} hidden>📜 Diploma</button></h2>
        <div class="medallas" data-medallas={r.id}></div>
        <div class="progreso-temas" data-progreso={r.id}></div>
      </section>
    ))}

    <p class="liga-nota">Tu progreso se guarda en este navegador. Completá los 8 temas de una región para ser su Campeón. 🏆</p>

    <div class="av-modal" id="dip-modal" hidden>
      <div class="av-card dip-card" role="dialog" aria-modal="true" aria-label="Diploma de Campeón">
        <div class="av-head"><b>📜 Diploma de Campeón</b><button class="av-x" aria-label="Cerrar" id="dip-x" type="button">✕</button></div>
        <canvas id="dip-canvas" width="1200" height="630"></canvas>
        <div class="dip-actions">
          <button class="btn-grande" id="dip-download" type="button">⬇️ Descargar</button>
          <button class="btn-sec" id="dip-share" type="button" hidden>📤 Compartir</button>
        </div>
      </div>
    </div>

    <div class="av-modal" id="avatar-modal" hidden>
      <div class="av-card">
        <div class="av-head"><b>📷 Elegí tu foto de perfil</b><button class="av-x" aria-label="Cerrar" id="av-cerrar" type="button">✕</button></div>
        <p class="av-sub" id="av-sub"></p>
        <div class="av-grid" id="avatar-grid"></div>
        <button class="btn-sec" id="av-reset" type="button">↺ Usar emoji 🎓</button>
      </div>
    </div>
  </div>

  <style>
    /* barra de pestañas de la Liga (Logros + regiones), una sección a la vez */
    .reg-tabs { position: sticky; top: 56px; z-index: 40; display:flex; gap:4px; overflow-x:auto; scrollbar-width:none;
      padding: 8px 4px; margin: 18px -4px 22px; background: color-mix(in srgb, var(--paper) 88%, transparent);
      backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
    .reg-tabs::-webkit-scrollbar { display:none; }
    .reg-tab { position:relative; flex: 0 0 auto; display:flex; align-items:center; gap:7px; cursor:pointer;
      padding: 8px 14px 10px; border: 1px solid transparent; border-radius: 12px; background: transparent;
      color: var(--ink-soft); font: 700 .86rem var(--font-display); transition: background .15s, color .15s; white-space:nowrap; }
    .reg-tab:hover { background: var(--paper-2); color: var(--ink); }
    .reg-tab .rt-emoji { font-size: 1.05rem; filter: saturate(.5) opacity(.7); transition: filter .15s; }
    .reg-tab .rt-chip { font: 800 .64rem var(--font-mono); color: var(--ink-mute); background: var(--paper); border-radius: 6px; padding: 1px 5px; }
    .reg-tab .rt-bar { position:absolute; left: 12px; right: 12px; bottom: 3px; height: 3px; border-radius: 3px; background: var(--line); overflow:hidden; }
    .reg-tab .rt-bar i { display:block; height:100%; width:0; background: linear-gradient(90deg, var(--teal,#3fae7a), var(--teal-deep,#1f8f5f)); transition: width .4s ease; }
    .reg-tab.activo { background: var(--card); color: var(--ink); border-color: var(--line); box-shadow: 0 4px 14px -8px rgba(0,0,0,.5); }
    .reg-tab.activo .rt-emoji { filter:none; }
    .reg-tab.activo .rt-chip { background: var(--red); color:#fff; }
    .reg-tab.completa .rt-name::after { content:" ✓"; color: var(--teal-deep,#1f8f5f); }
    .liga-panel[hidden] { display:none; }
    .liga-panel .liga-h { margin-top: 4px; }
    .diploma-btn { font:800 .72rem var(--font-mono); color:#3a2a00; background:linear-gradient(180deg,#ffe066,#e0a400); border:none; border-radius:8px; padding:4px 11px; cursor:pointer; vertical-align:middle; box-shadow:0 2px 6px -2px rgba(224,164,0,.6); }
    .diploma-btn:hover { filter:brightness(1.06); transform:translateY(-1px); }
    .dip-card { max-width: 760px; }
    #dip-canvas { width:100%; height:auto; border-radius:12px; border:1px solid var(--line); display:block; margin:4px 0 14px; }
    .dip-actions { display:flex; gap:10px; flex-wrap:wrap; }
    @media (max-width: 600px) {
      .reg-tab .rt-name { display:none; }
      .reg-tab { padding: 8px 11px 10px; }
      .reg-tab .rt-bar { left:8px; right:8px; }
    }
  </style>

  <script>
    import { evaluar } from '../lib/logros.js';
    const D = JSON.parse(document.getElementById('liga-data').textContent);
    const temas = D.regiones.flatMap((r) => r.temas.map((t) => ({ slug: t.slug, region: r.id, ejercicios: t.exIds.map((id) => ({ id })) })));
    const logros = evaluar(temas);
    const hechos = logros.filter((l) => l.cumplido).length;
    document.getElementById('logros-n').textContent = hechos + ' / ' + logros.length;
    const tln = document.getElementById('tab-logros-n'); if (tln) tln.textContent = hechos + '/' + logros.length;
    document.getElementById('logros').innerHTML = logros.map((l) =>
      '<div class="logro ' + (l.cumplido ? 'hecho' : '') + '" title="' + l.desc + '">' +
      '<span class="logro-ico">' + l.ico + '</span>' +
      '<div class="logro-txt"><b>' + l.nombre + '</b><span>' + l.desc + '</span></div></div>'
    ).join('');
  </script>

  <script>
    import { miPerfil, guardarPerfil, actualizarSnapshot, snapshotPublico, haySupabase } from '../lib/social.js';
    import { usuario } from '../lib/nube.js';
    const LD = JSON.parse(document.getElementById('liga-data').textContent);
    const temas = LD.regiones.flatMap((r) => r.temas.map((t) => ({ slug: t.slug, region: r.id, ejercicios: t.exIds.map((id) => ({ id })) })));
    const B = (window.__BASE || '/').replace(/\/$/, '');
    const $ = (id) => document.getElementById(id);
    const nombre = $('nombre');
    const normHandle = (s) => (s || '').trim().toLowerCase().replace(/[^a-z0-9_]+/g, '_').replace(/^_+|_+$/g, '').slice(0, 20);
    let perfilActual = null;

    function bloquear(p) {
      perfilActual = p;
      nombre.value = p.handle; nombre.readOnly = true;
      localStorage.setItem('liga:nombre', p.handle);
      $('social-codigo').textContent = p.codigo_amigo;
      $('social-vermio').href = B + '/u?h=' + p.handle;
      $('social-meta').hidden = false;
      $('social-guardar').hidden = true;
    }
    function desbloquear() {
      nombre.readOnly = false;
      $('social-guardar').hidden = false;
      $('social-meta').hidden = true;
      $('social-msg').textContent = 'Elegí tu @usuario — no se puede cambiar después.';
    }
    async function cargar() {
      if (!haySupabase) { $('social-guardar').hidden = true; return; }
      if (!usuario()) {
        nombre.readOnly = false; $('social-guardar').hidden = true; $('social-meta').hidden = true;
        $('social-msg').textContent = 'Iniciá sesión (☁️) para perfil público y amigos.'; return;
      }
      try {
        const p = await miPerfil();
        if (p) { bloquear(p); $('social-msg').textContent = ''; actualizarSnapshot(temas); }
        else { desbloquear(); }
      } catch { desbloquear(); }
    }
    $('social-guardar').addEventListener('click', async () => {
      const handle = normHandle(nombre.value);
      if (handle.length < 3) { $('social-msg').textContent = '⚠️ Mínimo 3 caracteres (minúsculas, números o _).'; return; }
      nombre.value = handle; localStorage.setItem('liga:nombre', handle);
      const avatar = Number(localStorage.getItem('col:avatar')) || 0;
      $('social-msg').textContent = 'Creando…';
      try {
        bloquear(await guardarPerfil({ handle, nombre: handle, avatar, publico: snapshotPublico(temas) }));
        $('social-msg').textContent = '✅ ¡Usuario @' + perfilActual.handle + ' creado!';
      } catch (e) { $('social-msg').textContent = '⚠️ ' + (e.message || e); }
    });
    window.addEventListener('nube:cambio', cargar);
    window.addEventListener('avatar:cambio', () => actualizarSnapshot(temas));
    cargar();
  </script>

  <script type="application/json" id="liga-data" set:html={JSON.stringify({ regiones, totalEj })}></script>
  <script>
    import { badgeSvg } from '../lib/sprites.js';   // medallas computadas en el cliente (no inlineadas en el HTML)
    (function () {
      const data = JSON.parse(document.getElementById('liga-data').textContent);
      const $ = (s) => document.querySelector(s);
      const B = (window.__BASE || '/').replace(/\/$/, '');
      const nombre = document.getElementById('nombre');
      nombre.value = localStorage.getItem('liga:nombre') || '';
      nombre.addEventListener('input', () => localStorage.setItem('liga:nombre', nombre.value));

      const proyOk = (k) => localStorage.getItem('proy:' + k + ':ok') === '1';
      const hitos = (() => { try { return new Set(JSON.parse(localStorage.getItem('col:hitos')) || []); } catch { return new Set(); } })();

      let doneTotal = 0, medallas = 0, regionesCompletas = 0, primeraIncompleta = '';
      for (const r of data.regiones) {
        let medReg = 0;
        const meds = [], filas = [];
        r.temas.forEach((t, i) => {
          const done = t.exIds.filter((id) => localStorage.getItem('ej:' + t.slug + ':' + id + ':ok') === '1').length;
          const total = t.exIds.length;
          const yaTeniaMedalla = hitos.has('tema:' + t.slug);
          const completo = total > 0 && done === total && (proyOk(t.slug) || yaTeniaMedalla);
          doneTotal += done;
          if (completo) { medallas++; medReg++; }
          const pct = total ? Math.round((done / total) * 100) : 0;
          filas.push('<a class="pt-row" href="' + B + '/ejercicios/' + t.slug + '"><span class="pt-emoji">' + badgeSvg(r.id, i, true, 20) + '</span>' +
            '<span class="pt-nom">' + t.titulo + '</span><span class="pt-bar"><i style="width:' + pct + '%"></i></span>' +
            '<span class="pt-num">' + done + '/' + total + '</span></a>');
          meds.push('<div class="medalla ' + (completo ? 'ganada' : '') + '" title="Gimnasio ' + t.gym + '"><div class="med-ico">' + badgeSvg(r.id, i, completo, 42) + '</div><div class="med-nom">' + t.gym + '</div></div>');
        });
        $('[data-medallas="' + r.id + '"]').innerHTML = meds.join('');
        $('[data-progreso="' + r.id + '"]').innerHTML = filas.join('');
        const completaReg = medReg === r.temas.length && r.temas.length;
        if (completaReg) regionesCompletas++;
        if (!primeraIncompleta && r.temas.length && !completaReg) primeraIncompleta = r.id;
        $('[data-reg="' + r.id + '"]').textContent = completaReg ? '🏆 ¡' + r.titulo + '!' : medReg + '/' + r.temas.length + ' medallas';
        // chip + barra de la pestaña de la región
        const _chip = document.querySelector('[data-prog="' + r.id + '"]');
        const _bar = document.querySelector('[data-bar="' + r.id + '"]');
        if (_chip) _chip.textContent = medReg + '/' + r.temas.length;
        if (_bar) _bar.style.width = (r.temas.length ? Math.round(medReg / r.temas.length * 100) : 0) + '%';
        if (completaReg) {
          const _t = document.querySelector('.reg-tab[data-region="' + r.id + '"]'); if (_t) _t.classList.add('completa');
          const _d = document.querySelector('[data-diploma="' + r.id + '"]'); if (_d) _d.hidden = false;
        }
      }

      // ── pestañas: mostrar una sección a la vez (Logros + regiones) ──
      const PANELS = Array.from(document.querySelectorAll('.liga-panel'));
      const TABS = Array.from(document.querySelectorAll('#liga-tabs .reg-tab'));
      function mostrarTab(tab) {
        if (!PANELS.some((p) => p.dataset.tab === tab)) tab = 'logros';
        PANELS.forEach((p) => { p.hidden = p.dataset.tab !== tab; });
        TABS.forEach((t) => {
          const sel = t.dataset.tab === tab;
          t.classList.toggle('activo', sel);
          t.setAttribute('aria-selected', sel ? 'true' : 'false');
          t.tabIndex = sel ? 0 : -1;
        });
        try { localStorage.setItem('liga:tab', tab); } catch (e) {}
        if (location.hash.slice(1) !== tab) history.replaceState(null, '', '#' + tab);
        const el = TABS.find((t) => t.dataset.tab === tab);
        if (el) el.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      }
      TABS.forEach((t) => t.addEventListener('click', () => mostrarTab(t.dataset.tab)));
      // teclado: ← → para moverse entre pestañas
      const TABIDS = TABS.map((t) => t.dataset.tab);
      document.getElementById('liga-tabs').addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        e.preventDefault();
        const cur = TABS.findIndex((t) => t.classList.contains('activo'));
        const j = ((cur < 0 ? 0 : cur) + (e.key === 'ArrowRight' ? 1 : -1) + TABIDS.length) % TABIDS.length;
        mostrarTab(TABIDS[j]); TABS[j].focus();
      });
      const _guardada = (() => { try { return localStorage.getItem('liga:tab'); } catch (e) { return null; } })();
      mostrarTab(location.hash.slice(1) || _guardada || primeraIncompleta || 'logros');
      window.addEventListener('hashchange', () => mostrarTab(location.hash.slice(1)));

      // ── diploma de Campeón (canvas → PNG descargable / compartible) ──
      const canvas = document.getElementById('dip-canvas');
      function dibujarDiploma(reg) {
        const r = data.regiones.find((x) => x.id === reg); if (!r) return;
        const handle = (localStorage.getItem('liga:nombre') || '').trim() || 'Entrenador/a';
        const fecha = new Date().toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' });
        const ctx = canvas.getContext('2d'); const W = 1200, H = 630;
        // fondo
        const g = ctx.createLinearGradient(0, 0, W, H); g.addColorStop(0, '#0e1a12'); g.addColorStop(1, '#16241a');
        ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
        ctx.strokeStyle = 'rgba(255,255,255,.035)'; ctx.lineWidth = 1;
        for (let x = 0; x < W; x += 30) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
        for (let y = 0; y < H; y += 30) { ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(W, y); ctx.stroke(); }
        // marco dorado
        ctx.strokeStyle = '#ffcf3f'; ctx.lineWidth = 6; ctx.strokeRect(26, 26, W - 52, H - 52);
        ctx.strokeStyle = 'rgba(255,207,63,.4)'; ctx.lineWidth = 2; ctx.strokeRect(40, 40, W - 80, H - 80);
        ctx.textAlign = 'center';
        ctx.fillStyle = '#e3350d'; ctx.font = '700 24px "JetBrains Mono", monospace'; ctx.fillText('▸ POKÉDEX CODEX', W / 2, 102);
        ctx.fillStyle = '#bfe9cf'; ctx.font = '700 22px "JetBrains Mono", monospace'; ctx.fillText('D I P L O M A   D E   C A M P E Ó N', W / 2, 148);
        ctx.font = '92px serif'; ctx.fillText(r.emoji, W / 2, 280);
        ctx.fillStyle = '#ffcf3f'; ctx.font = '800 60px "Silkscreen", "JetBrains Mono", monospace'; ctx.fillText('Campeón de ' + r.nombre, W / 2, 372);
        ctx.fillStyle = '#9fd9b4'; ctx.font = '400 26px "JetBrains Mono", monospace'; ctx.fillText(r.sub, W / 2, 414);
        ctx.fillStyle = '#eef'; ctx.font = '600 30px "JetBrains Mono", monospace'; ctx.fillText('Otorgado a  @' + handle, W / 2, 492);
        ctx.fillStyle = '#8fb6a0'; ctx.font = '500 22px "JetBrains Mono", monospace'; ctx.fillText('🏅 8 gimnasios vencidos   ·   ' + fecha, W / 2, 536);
        ctx.fillStyle = '#5e8a72'; ctx.font = '600 20px "JetBrains Mono", monospace'; ctx.fillText('felipendelicia.github.io/luca-journey', W / 2, 586);
        return r;
      }
      let dipReg = null;
      async function abrirDiploma(reg) {
        dipReg = reg;
        try { await document.fonts.ready; } catch (e) {}
        const r = dibujarDiploma(reg); if (!r) return;
        document.getElementById('dip-modal').hidden = false;
        document.getElementById('dip-x').focus();
      }
      document.querySelectorAll('[data-diploma]').forEach((b) => b.addEventListener('click', () => abrirDiploma(b.dataset.diploma)));
      document.getElementById('dip-x').addEventListener('click', () => { document.getElementById('dip-modal').hidden = true; });
      document.getElementById('dip-modal').addEventListener('click', (e) => { if (e.target.id === 'dip-modal') document.getElementById('dip-modal').hidden = true; });
      document.getElementById('dip-download').addEventListener('click', () => {
        canvas.toBlob((b) => {
          const a = document.createElement('a'); a.href = URL.createObjectURL(b); a.download = 'diploma-' + (dipReg || 'campeon') + '.png';
          a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
        });
      });
      const shareBtn = document.getElementById('dip-share');
      if (navigator.share) {
        shareBtn.hidden = false;
        shareBtn.addEventListener('click', () => {
          const r = data.regiones.find((x) => x.id === dipReg);
          canvas.toBlob(async (b) => {
            const f = new File([b], 'diploma.png', { type: 'image/png' });
            const datos = { title: '¡Campeón de ' + (r ? r.nombre : '') + '!', text: 'Me convertí en Campeón de ' + (r ? r.nombre : '') + ' en Python con Pokémon 🏆' };
            try { if (navigator.canShare && navigator.canShare({ files: [f] })) await navigator.share({ ...datos, files: [f] }); else await navigator.share(datos); } catch (e) {}
          });
        });
      }

      const exp = doneTotal * 20;
      const nivel = 1 + Math.floor(exp / 100);
      const RANGOS = [[0, 'Novato'], [4, 'Aprendiz'], [8, 'Entrenador'], [12, 'Veterano'], [16, 'As'], [24, 'Líder'], [32, 'Maestro']];
      let rango = 'Novato';
      for (const [n, x] of RANGOS) if (medallas >= n) rango = x;
      document.getElementById('nivel').textContent = nivel;
      document.getElementById('rango').textContent = rango;
      document.getElementById('exp-txt').textContent = exp + ' EXP';
      document.getElementById('exp-next').textContent = (100 - (exp % 100)) + ' para nivel ' + (nivel + 1);
      document.getElementById('exp-fill').style.width = (exp % 100) + '%';
      document.getElementById('st-ej').textContent = doneTotal + '/' + data.totalEj;
      document.getElementById('st-med').textContent = medallas + '/' + (data.regiones.length * 8);
      document.getElementById('st-reg').textContent = regionesCompletas + '/' + data.regiones.length;
      if (regionesCompletas === data.regiones.length && data.regiones.length) {
        document.getElementById('rango').textContent = '¡Maestro Pokémon!';
      }
    })();
  </script>

  <script>
    import pokemon from '../data/pokemon.json';   // módulo → chunk /_astro cacheado (compartido con pokedex)
    (function () {
      const nombres = Object.fromEntries(pokemon.map((p) => [p.id, p.nombre]));
      const sprite = (id) => 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/' + id + '.png';
      const av = document.getElementById('avatar');
      const modal = document.getElementById('avatar-modal');
      const grid = document.getElementById('avatar-grid');
      const sub = document.getElementById('av-sub');
      const atrapados = () => { try { return JSON.parse(localStorage.getItem('col:atrapados')) || {}; } catch { return {}; } };

      function pintar() {
        const id = localStorage.getItem('col:avatar');
        const cam = '<span class="avatar-cam">📷</span>';
        av.innerHTML = (id && atrapados()[id]) ? '<img src="' + sprite(id) + '" alt="avatar" />' + cam : '🎓' + cam;
      }
      function cerrar() { modal.hidden = true; }
      function abrir() {
        const at = atrapados();
        const ids = Object.keys(at).sort((a, b) => a - b);
        if (!ids.length) {
          sub.textContent = 'Todavía no atrapaste ninguno. ¡Andá al Safari! 🎒';
          grid.innerHTML = '';
        } else {
          sub.textContent = 'Tocá un Pokémon para usarlo de foto.';
          grid.innerHTML = ids.map((id) =>
            '<button class="av-poke" type="button" data-id="' + id + '" title="' + (nombres[id] || ('Nº ' + id)) + '">' +
            '<img loading="lazy" src="' + sprite(id) + '" alt="' + (nombres[id] || id) + '" /></button>').join('');
          grid.querySelectorAll('.av-poke').forEach((b) => b.addEventListener('click', () => {
            localStorage.setItem('col:avatar', b.dataset.id); pintar(); cerrar();
            window.dispatchEvent(new Event('avatar:cambio'));
          }));
        }
        modal.hidden = false;
      }

      av.addEventListener('click', abrir);
      document.getElementById('av-cerrar').addEventListener('click', cerrar);
      document.getElementById('av-reset').addEventListener('click', () => { localStorage.removeItem('col:avatar'); pintar(); cerrar(); window.dispatchEvent(new Event('avatar:cambio')); });
      modal.addEventListener('click', (e) => { if (e.target === modal) cerrar(); });
      pintar();
    })();
  </script>
</Base>
