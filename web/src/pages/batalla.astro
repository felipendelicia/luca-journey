---
import Base from '../layouts/Base.astro';
import datos from '../data/ejercicios.json';
import { u } from '../lib/url.ts';

const temas = datos.map((w) => ({ slug: w.slug, region: w.region, ejercicios: w.ejercicios.map((e) => ({ id: e.id })) }));
---
<Base title="Batalla — Python con Pokémon" active="Batalla">
  <div class="wrap batalla">
    <div class="safari-head">
      <h1>⚔️ Batalla</h1>
      <a class="navlink" href={u('/pokedex')}>📕 Mi Pokédex</a>
    </div>
    <p>Armá un equipo de hasta <b>3</b> y peleá. En <b>🤖 Práctica</b> es contra una CPU; en <b>🌐 En vivo</b> contra otro entrenador real. Elegís ataques (tipos importan), y cuando se llena la barra desatás el <b>⚡ Súper</b>: un reto de código de tu nivel. 🥊</p>

    <div class="bt-modo" id="bt-modo">
      <button class="bt-modo-b" data-modo="practica"><b>🤖 Práctica</b><small>vs CPU · entrená sin presión</small></button>
      <button class="bt-modo-b" data-modo="online"><b>🌐 En vivo</b><small>vs jugador real · cola, código o amigo</small></button>
    </div>

    <div id="bt-online" hidden></div>
    <div id="bt-sel" hidden></div>
    <div id="bt-combate" hidden>
      <button class="bt-mute" id="bt-mute" type="button" title="Música / sonido">🔊</button>
      <div class="bt-field">
        <div class="bt-arena">
          <img class="bt-sprite bt-sprite-r" id="r-img" src="" alt="rival" />
          <img class="bt-sprite bt-sprite-p" id="p-img" src="" alt="vos" />
        </div>
        <div class="bt-rival">
          <div class="bt-info"><span class="bt-nom" id="r-nom"></span><span class="bt-gen" id="r-gen"></span><span class="bt-lv" id="r-lv"></span><span class="bt-estado" id="r-estado"></span></div>
          <div class="bt-hpbar"><div class="bt-hp" id="r-hp"></div></div>
          <div class="bt-row2"><span class="bt-hpnum" id="r-hpnum"></span><span class="bt-tipos" id="r-tipos"></span></div>
          <div class="bt-hab" id="r-hab"></div>
          <div class="bt-equipo" id="r-dots"></div>
        </div>
        <div class="bt-yo">
          <div class="bt-info"><span class="bt-nom" id="p-nom"></span><span class="bt-gen" id="p-gen"></span><span class="bt-lv" id="p-lv"></span><span class="bt-estado" id="p-estado"></span></div>
          <div class="bt-hpbar"><div class="bt-hp" id="p-hp"></div></div>
          <div class="bt-row2"><span class="bt-hpnum" id="p-hpnum"></span><span class="bt-tipos" id="p-tipos"></span></div>
          <div class="bt-hab" id="p-hab"></div>
          <div class="bt-equipo" id="p-dots"></div>
        </div>
      </div>
      <div class="bt-estado-online" id="bt-estado-online" hidden><span class="bt-eo-ico" id="bt-eo-ico">🟢</span><span class="bt-eo-txt" id="bt-eo-txt">Elegí tu acción</span></div>
      <p class="bt-msg" id="bt-msg">¡Que empiece la batalla!</p>
      <div class="bt-carga"><div class="bt-carga-fill" id="bt-carga"></div><span id="bt-carga-txt">Súper: 0%</span></div>
      <div class="bt-timer" id="bt-timer" hidden><span class="bt-timer-txt" id="bt-timer-txt"></span><div class="bt-timer-bar"><i id="bt-timer-bar"></i></div></div>
      <div class="bt-timer bt-timer-online" id="bt-timer-online" hidden><span class="bt-timer-txt" id="bt-timer-online-txt"></span><div class="bt-timer-bar"><i id="bt-timer-online-bar"></i></div></div>
      <div class="bt-moves" id="bt-moves"></div>
      <div class="bt-banca-wrap"><span class="bt-banca-lbl">Tu equipo <small>(tocá para cambiar)</small></span><div class="bt-banca" id="bt-banca"></div></div>
    </div>
  </div>

  <div class="reto-modal" id="reto-modal" hidden>
    <div class="reto-card">
      <h2>⚡ ¡Súper ataque! Resolvé para potenciarlo</h2>
      <div class="reto-timer"><i id="reto-timer-bar"></i></div>
      <p class="reto-q" id="reto-q"></p>
      <div class="reto-ops" id="reto-ops"></div>
    </div>
  </div>

  <div class="reto-modal" id="mochila-modal" hidden>
    <div class="reto-card mochila-card">
      <button class="rar-x" id="mochila-x" type="button" aria-label="Cerrar">✕</button>
      <h2>🎒 Mochila — usar poción</h2>
      <p class="bt-mochila-nota">Cura a tu Pokémon activo. Usarla <b>gasta tu turno</b>.</p>
      <div class="mochila-lista" id="mochila-lista"></div>
    </div>
  </div>

  <div class="reto-modal reemplazo-modal" id="reemplazo-modal" hidden>
    <div class="reto-card reemplazo-card">
      <h2>🔄 Tu Pokémon cayó</h2>
      <p class="bt-mochila-nota" id="reemplazo-nota">Elegí el próximo que entra al combate.</p>
      <div class="reemplazo-lista" id="reemplazo-lista"></div>
    </div>
  </div>

  <div class="bt-fin" id="bt-fin" hidden>
    <div class="bt-fin-card">
      <h2 id="fin-tit"></h2>
      <p id="fin-msg"></p>
      <button class="btn-tirar" id="fin-otra">Otra batalla</button>
    </div>
  </div>

  <script type="application/json" id="bt-data" set:html={JSON.stringify({ temas })}></script>
  <script>
    import { pc, sincronizar, spriteUrl, regionesDesbloqueadas, darCaramelos, darBalls, items, usarItem, darEV, yieldDe, habMeta } from '../lib/coleccion.js';
    import { ITEMS } from '../lib/items.js';
    import { itemSvg } from '../lib/sprites.js';
    import { combatiente, calcularDano, danoSuper, elegirCPU, equipoCPU, esEstado, aplicarEstado, puedeActuar, aplicarAilment, tickEstado, acierta, tiraCritico, sinPP, FORCEJEO, ESTADOS, habAlEntrar, habAlContacto } from '../lib/batalla.js';
    import { etiquetaEfec } from '../lib/tipos.js';
    import { efectoAtaque } from '../lib/batalla-fx.js';
    import { retoAlAzar } from '../lib/retos-batalla.js';
    import { sonarExito, sonarEpico, musicaBatalla, detenerMusica, toggleSonido, sonidoActivo, volumen } from '../lib/sonidos.js';
    import * as online from '../lib/batalla-online.js';
    import { amigos, rankingPvp } from '../lib/social.js';
    import { refrescarDesdeNube } from '../lib/nube.js';

    const D = JSON.parse(document.getElementById('bt-data').textContent);
    sincronizar(D.temas);
    const $ = (id) => document.getElementById(id);
    const esperar = (ms) => new Promise((r) => setTimeout(r, ms));

    // narra una línea en el cuadro de texto (#bt-msg) escribiéndola LETRA POR LETRA (estilo FireRed).
    // Al terminar muestra el cursor ▼ (clase .listo) un instante y resuelve. Un tap saltea al texto completo.
    // prefers-reduced-motion → texto directo (sin tipeo).
    let _narrarSkip = null;
    function narrar(texto) {
      const box = document.getElementById('bt-msg');
      return new Promise((resolve) => {
        texto = String(texto == null ? '' : texto);
        if (!box || matchMedia('(prefers-reduced-motion: reduce)').matches) { if (box) box.textContent = texto; setTimeout(resolve, 280); return; }
        let i = 0; _narrarSkip = null;
        box.classList.add('escribiendo'); box.classList.remove('listo'); box.textContent = '';
        const fin = () => { box.classList.remove('escribiendo'); box.classList.add('listo'); _narrarSkip = null; setTimeout(() => { box.classList.remove('listo'); resolve(); }, 450); };
        const tick = () => {
          if (i >= texto.length) return fin();
          box.textContent += texto[i++];
          _narrarSkip = () => { box.textContent = texto; i = texto.length; _narrarSkip = null; fin(); };
          setTimeout(tick, 24);
        };
        tick();
      });
    }
    // tap/click en cualquier parte saltea la línea que se está escribiendo
    document.addEventListener('pointerdown', () => { if (_narrarSkip) _narrarSkip(); });

    // grito (cry) de un Pokémon (PokeAPI, ogg)
    const CRY_BASE = 'https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/';
    function cry(idp, vol = 0.4) { try { const a = new Audio(CRY_BASE + idp + '.ogg'); a.volume = Math.max(0, Math.min(1, vol * volumen())); a.play().catch(() => {}); } catch {} }
    // color por tipo (para el destello del ataque)
    const TCOLOR = { Normal: '#9099a1', Fuego: '#ff6b2c', Agua: '#4d90d5', Planta: '#56ad4e', 'Eléctrico': '#e0bd2b', Hielo: '#62c4b6', Lucha: '#ce4069', Veneno: '#a85fc4', Tierra: '#d3793f', Volador: '#8aa6df', 'Psíquico': '#f56a72', Bicho: '#88bb26', Roca: '#b3a576', Fantasma: '#5269ac', 'Dragón': '#0a6dc4', Siniestro: '#585761', Acero: '#5a8ea1', Hada: '#e487dd' };
    // sprites GBA reales (FireRed/LeafGreen) para gen 1-3; el resto usa el sprite por defecto.
    const FRSPR = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/';
    // sprites PIXEL/retro por generación (frente y espaldas): gen 1-3 FireRed (GBA), gen 4 HGSS, gen 5 BW.
    // gen 6+ no tiene sprites pixel (Game Freak pasó a 3D) → render moderno por defecto. onerror → spriteUrl.
    const spriteBatalla = (id, shiny, back) => {
      const b = back ? 'back/' : '', s = shiny ? 'shiny/' : '';
      if (id <= 386) return FRSPR + 'versions/generation-iii/firered-leafgreen/' + b + s + id + '.png';
      if (id <= 493) return FRSPR + 'versions/generation-iv/heartgold-soulsilver/' + b + s + id + '.png';
      if (id <= 649) return FRSPR + 'versions/generation-v/black-white/' + b + s + id + '.png';
      return FRSPR + b + s + id + '.png';
    };
    // fija el sprite de un combatiente: rival de frente (back=false), jugador DE ESPALDAS (back=true).
    // fallback al sprite por defecto si el de FireRed/back no existe.
    function setSpr(imgId, c, back) {
      const img = document.getElementById(imgId); if (!img) return;
      img.onerror = () => { img.onerror = null; img.src = spriteUrl(c.id, c.shiny); };
      img.src = spriteBatalla(c.id, c.shiny, back);
    }
    const chipsTipo = (tipos) => (tipos || []).map((t) => '<span class="bt-tipo" style="background:' + (TCOLOR[t] || '#888') + '">' + t + '</span>').join('');
    // HUD: género (♂/♀) junto al nombre + habilidad debajo. `c` es un Combatiente (.gen / .hab).
    const genHud = (gen) => gen === 'm' ? '<span class="bt-gen-m">♂</span>' : gen === 'f' ? '<span class="bt-gen-f">♀</span>' : '';
    function hudIdent(pre, c) {
      $(pre + '-gen').innerHTML = genHud(c && c.gen);
      const hm = c && c.hab ? habMeta(c.hab) : null;
      $(pre + '-hab').innerHTML = hm ? '<span class="bt-hab-ico">✦</span> ' + hm.nombre : '';
    }
    function destello(esRival, tipo) {
      const arena = document.querySelector('.bt-arena'); if (!arena) return;
      const fx = document.createElement('div'); fx.className = 'bt-fx';
      fx.style.setProperty('--c', TCOLOR[tipo] || '#fff');
      fx.style.left = esRival ? '70%' : '30%'; fx.style.top = esRival ? '24%' : '68%';
      arena.appendChild(fx); setTimeout(() => fx.remove(), 480);
    }

    let G = null; // estado del combate

    // ── Fase 1: selección de equipo ──
    // enriquece la colección con PODER (suma de stats efectivas) + tipos, ordenada por poder desc.
    function porPoder(arr) {
      return arr.map((m) => {
        const c = combatiente(m);
        return { m, tipos: c.tipos || [], poder: Math.round(c.hpMax + c.atk + c.def + c.spa + c.spd + c.spe) };
      }).sort((a, b) => b.poder - a.poder || b.m.nivel - a.m.nivel);
    }
    // tipos presentes en `lista` (orden canónico de TCOLOR) para los chips de filtro.
    const tiposPresentes = (lista) => { const s = new Set(); lista.forEach((x) => x.tipos.forEach((t) => s.add(t))); return Object.keys(TCOLOR).filter((t) => s.has(t)); };
    // chips de filtro por tipo: "Todos" + uno por tipo presente.
    function chipsFiltroTipo(tipos, activo) {
      const chip = (t, lbl, on) => '<button type="button" class="bt-ftipo' + (on ? ' on' : '') + '" data-ftipo="' + t + '"' + (t ? ' style="--c:' + TCOLOR[t] + '"' : '') + '>' + lbl + '</button>';
      return '<div class="bt-filtros" role="group" aria-label="Filtrar por tipo">' + chip('', 'Todos', !activo) + tipos.map((t) => chip(t, t, activo === t)).join('') + '</div>';
    }
    // tarjeta de un Pokémon en la selección (muestra el PODER, que es el criterio de orden).
    const cardPick = (m, poder, elegido) => '<button class="bt-pick' + (elegido ? ' elegido' : '') + '" data-iid="' + m.iid + '"><img src="' + spriteUrl(m.id, m.shiny) + '" alt="" /><span>' + esc(m.mote || ('Nº ' + m.id)) + '</span><small>💪 ' + poder + ' · Nv.' + m.nivel + '</small></button>';

    function pintarSeleccion() {
      const arr = pc();
      if (!arr.length) {
        $('bt-sel').innerHTML = '<p class="bt-vacio">No tenés Pokémon todavía. Andá al <b>Safari</b> a atrapar algunos. 🎒</p>';
        return;
      }
      const lista = porPoder(arr), tipos = tiposPresentes(lista), sel = new Set();
      let filtro = null;
      $('bt-sel').innerHTML = '<h2 class="liga-h">Elegí tu equipo <small>(hasta 3 · ordenados por poder)</small></h2>'
        + chipsFiltroTipo(tipos, filtro) + '<div class="bt-picks" id="bt-grid-sel"></div>'
        + '<button class="btn-tirar" id="bt-go" disabled>⚔️ ¡Pelear!</button>';
      const grid = $('bt-grid-sel');
      function pintarGrid() {
        const vis = filtro ? lista.filter((x) => x.tipos.includes(filtro)) : lista;
        grid.innerHTML = vis.length ? vis.map((x) => cardPick(x.m, x.poder, sel.has(String(x.m.iid)))).join('') : '<p class="bt-vacio">Ningún Pokémon de ese tipo.</p>';
        grid.querySelectorAll('.bt-pick').forEach((b) => b.addEventListener('click', () => {
          const iid = b.dataset.iid;
          if (sel.has(iid)) { sel.delete(iid); b.classList.remove('elegido'); }
          else if (sel.size < 3) { sel.add(iid); b.classList.add('elegido'); }
          $('bt-go').disabled = sel.size === 0;
        }));
      }
      pintarGrid();
      $('bt-sel').querySelectorAll('.bt-ftipo').forEach((b) => b.addEventListener('click', () => {
        filtro = b.dataset.ftipo || null;
        $('bt-sel').querySelectorAll('.bt-ftipo').forEach((x) => x.classList.toggle('on', (x.dataset.ftipo || '') === (filtro || '')));
        pintarGrid();
      }));
      $('bt-go').addEventListener('click', () => empezar([...sel]));
    }

    // ── Fase 2: combate ──
    async function empezar(iids) {
      const arr = pc();
      const equipo = iids.map((iid) => combatiente(arr.find((m) => m.iid === iid)));
      const nivelProm = Math.round(equipo.reduce((a, c) => a + c.nivel, 0) / equipo.length);
      // pool de especies para el rival: las regiones desbloqueadas (1..721 simplificado por starters comunes)
      const pool = poolRival();
      const rival = equipoCPU(pool, Math.min(3, equipo.length), Math.max(2, nivelProm + (Math.random() < 0.5 ? -2 : 2)));
      G = { equipo, rival, pa: 0, ra: 0, carga: 0, lock: false, itemsUsados: 0 };
      $('bt-sel').hidden = true; $('bt-combate').hidden = false; $('bt-fin').hidden = true;
      $('bt-estado-online').hidden = true; $('bt-timer-online').hidden = true;   // banner/timer online no aplican vs CPU
      musicaBatalla();          // 🎵 música de fondo de la pelea
      // habilidad AL ENTRAR (Intimidación): ambos activos entran a la vez → cada uno intimida al otro
      G.lock = true; render();
      cry(rivAct().id, 0.45); setTimeout(() => cry(miAct().id, 0.4), 550);
      await narrar('¡Aparece el rival! Elegí tu ataque.'); await esperar(300);
      { const te = habAlEntrar(rivAct(), miAct()); if (te) { render(); await narrar(te); await esperar(400); } }
      { const te = habAlEntrar(miAct(), rivAct()); if (te) { render(); await narrar(te); await esperar(400); } }
      G.lock = false; render(); armarTimer();
    }
    function poolRival() {
      // especies “salvajes” simples por región desbloqueada (líderes/starters conocidos)
      const reg = regionesDesbloqueadas(D.temas);
      const base = { kanto: [1, 4, 7, 25, 133, 143, 68, 65, 94, 130], johto: [152, 155, 158, 196, 197, 248], hoenn: [252, 255, 258, 282, 373], sinnoh: [387, 390, 393, 448, 445], unova: [495, 498, 501, 530], kalos: [650, 653, 656, 700], alola: [722, 725, 728, 745, 778, 794], galar: [810, 813, 816, 823, 851, 884], paldea: [906, 909, 912, 925, 998, 1000] };
      let pool = [];
      for (const r of Object.keys(base)) if (reg.has(r)) pool = pool.concat(base[r]);
      return pool.length ? pool : base.kanto;
    }

    const miAct = () => G.equipo[G.pa];
    const rivAct = () => G.rival[G.ra];
    const vivos = (t) => t.filter((c) => c.hp > 0).length;

    // ── timeout de turno: si no movés en TURNO_SEG, actúa solo ──
    const TURNO_SEG = 30, RETO_SEG = 15;
    let timerH = null, retoH = null;
    function cancelarTimer() { if (timerH) { clearInterval(timerH); timerH = null; } $('bt-timer').hidden = true; }
    function cancelarRetoTimer() { if (retoH) { clearInterval(retoH); retoH = null; } }
    function armarTimer() {
      cancelarTimer();
      if (!G || G.lock || !$('bt-fin').hidden || vivos(G.equipo) === 0 || vivos(G.rival) === 0) return;
      let seg = TURNO_SEG;
      const cont = $('bt-timer'), txt = $('bt-timer-txt'), bar = $('bt-timer-bar');
      cont.hidden = false;
      const pintarT = () => { txt.textContent = '⏱ ' + seg + 's para mover'; bar.style.width = (seg / TURNO_SEG * 100) + '%'; cont.classList.toggle('urgente', seg <= 5); };
      pintarT();
      timerH = setInterval(() => { seg--; if (seg <= 0) { cancelarTimer(); autoMover(); } else pintarT(); }, 1000);
    }
    function autoMover() {
      if (!G || G.lock) return;
      msg('⏰ ¡Se acabó el tiempo! ' + miAct().nombre + ' actúa por instinto…');
      const ms = miAct().movs;
      turno(ms[Math.floor(Math.random() * ms.length)]);
    }

    function render() {
      const p = miAct(), r = rivAct();
      if (!p || !r) return;   // un equipo quedó eliminado → terminar() maneja la UI
      $('r-nom').textContent = r.nombre; $('r-lv').textContent = 'Nv.' + r.nivel; $('r-tipos').innerHTML = chipsTipo(r.tipos);
      $('p-nom').textContent = p.nombre; $('p-lv').textContent = 'Nv.' + p.nivel; $('p-tipos').innerHTML = chipsTipo(p.tipos);
      hudIdent('r', r); hudIdent('p', p);
      $('r-hpnum').textContent = Math.max(0, r.hp) + '/' + r.hpMax; $('p-hpnum').textContent = Math.max(0, p.hp) + '/' + p.hpMax;
      $('r-estado').innerHTML = estadoChip(r); $('p-estado').innerHTML = estadoChip(p);
      // sprites GBA reales (FireRed/LeafGreen) para gen 1-3; fallback al sprite por defecto
      const rImg = $('r-img');
      rImg.onerror = () => { rImg.onerror = null; rImg.src = spriteUrl(r.id, r.shiny); };
      rImg.src = spriteBatalla(r.id, r.shiny, false);
      const pImg = $('p-img');   // jugador DE ESPALDAS
      pImg.onerror = () => { pImg.onerror = () => { pImg.onerror = null; pImg.src = spriteUrl(p.id, p.shiny); };
        pImg.src = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/back/' + (p.shiny ? 'shiny/' : '') + p.id + '.png'; };
      pImg.src = spriteBatalla(p.id, p.shiny, true);
      hp('r-hp', r); hp('p-hp', p);
      dots('r-dots', G.rival); dots('p-dots', G.equipo);
      $('bt-carga').style.width = G.carga + '%'; $('bt-carga-txt').textContent = 'Súper: ' + G.carga + '%';
      const movesHtml = sinPP(p)
        ? '<button class="bt-move" id="bt-forcejeo"' + (G.lock ? ' disabled' : '') + '><b>Forcejeo</b><small>Sin PP · ataque desesperado</small></button>'
        : p.movs.map((mv, i) =>
            '<button class="bt-move" data-i="' + i + '"' + ((G.lock || mv.pp <= 0) ? ' disabled' : '') + '><b>' + mv.nombre + '</b><small>' + mv.tipo + (mv.poder ? ' · ⚔️' + mv.poder : '') + ' · PP ' + mv.pp + '/' + mv.ppMax + '</small></button>').join('');
      $('bt-moves').innerHTML = movesHtml +
        '<button class="bt-move bt-super" id="bt-super"' + (G.carga < 100 || G.lock ? ' disabled' : '') + '>⚡ SÚPER</button>' +
        '<button class="bt-move bt-mochila" id="bt-mochila"' + (G.lock || G.itemsUsados >= 2 ? ' disabled' : '') + '>🎒 Mochila (' + (2 - G.itemsUsados) + ')</button>';
      if (sinPP(p)) { const fb = $('bt-forcejeo'); if (fb) fb.addEventListener('click', () => turno({ ...FORCEJEO, pp: 1, ppMax: 1 })); }
      else $('bt-moves').querySelectorAll('.bt-move[data-i]').forEach((b) => b.addEventListener('click', () => turno(p.movs[+b.dataset.i])));
      $('bt-super').addEventListener('click', abrirReto);
      $('bt-mochila').addEventListener('click', abrirMochila);
      // banca: tu equipo (tocá un suplente vivo para cambiarlo)
      $('bt-banca').innerHTML = G.equipo.map((c, i) => {
        const ko = c.hp <= 0, act = i === G.pa, dis = act || ko || G.lock;
        const hpPct = Math.max(0, Math.round((c.hp / c.hpMax) * 100));
        return '<button class="bt-banca-m' + (act ? ' activo' : '') + (ko ? ' ko' : '') + '" data-sw="' + i + '"' + (dis ? ' disabled' : '') + '>' +
          '<img src="' + spriteUrl(c.id, c.shiny) + '" alt="" /><span class="bm-nom">' + c.nombre + '</span>' +
          '<span class="bm-hp"><i style="width:' + hpPct + '%"></i></span>' +
          '<small>' + (ko ? '💀 Debilitado' : act ? '● En combate' : 'Nv.' + c.nivel) + '</small></button>';
      }).join('');
      $('bt-banca').querySelectorAll('[data-sw]').forEach((b) => b.addEventListener('click', () => cambiar(+b.dataset.sw)));
    }
    // cambiar de Pokémon (manual): usa el turno → el rival ataca después.
    async function cambiar(i) {
      if (G.lock || i === G.pa || G.equipo[i].hp <= 0) return;
      cancelarTimer(); G.lock = true; render();
      G.pa = i; render(); cry(miAct().id, 0.4); await narrar('¡Adelante, ' + miAct().nombre + '!');
      await esperar(450);
      { const te = habAlEntrar(miAct(), rivAct()); if (te) { render(); await narrar(te); await esperar(400); } }
      await turnoRival();
      if (fin()) return;
      await tick('r');
      if (fin()) return;
      G.lock = false; render(); armarTimer();
    }
    function hp(id, c) {
      const pct = Math.max(0, Math.round((c.hp / c.hpMax) * 100));
      const el = $(id); el.style.width = pct + '%';
      el.className = 'bt-hp' + (pct <= 25 ? ' bajo' : pct <= 50 ? ' medio' : '');
    }
    function dots(id, team) { $(id).innerHTML = team.map((c) => '<span class="bt-dot' + (c.hp <= 0 ? ' ko' : '') + '"></span>').join(''); }
    function msg(t) { $('bt-msg').textContent = t; }

    // usar un movimiento: si es de ESTADO cambia stats; si no, hace daño.
    async function usarMov(at, mov, defLado) {
      const def = defLado === 'p' ? miAct() : rivAct();
      if (esEstado(mov)) {
        const txt = aplicarEstado(mov, at, def);
        efectoAtaque(document.querySelector('.bt-arena'), mov, defLado === 'r');   // FX de estado (flechas ↑/↓)
        render();
        await narrar('¡' + at.nombre + ' usó ' + mov.nombre + '!  ' + txt);
        await esperar(550);
      } else {
        await aplicarGolpe(at, mov, defLado, calcularDano(at, mov, def, Math.random, tiraCritico()));
      }
    }
    async function aplicarGolpe(at, mov, defLado, dmgInfo) {
      const def = defLado === 'p' ? miAct() : rivAct();
      const atImg = defLado === 'p' ? $('r-img') : $('p-img');   // el atacante es el otro lado
      const defImg = defLado === 'p' ? $('p-img') : $('r-img');
      const ef = etiquetaEfec(dmgInfo.efec);
      await narrar('¡' + at.nombre + ' usó ' + (mov.nombre || 'su ataque') + '!' + (dmgInfo.crit ? '  ¡Golpe crítico! 💥' : '') + (ef ? '  ' + ef : ''));
      await esperar(200);   // beat tras la línea, antes del golpe
      // 1) el atacante embiste
      atImg.classList.add('bt-lunge'); await esperar(190); atImg.classList.remove('bt-lunge');
      // 2) impacto: animación de ataque (por movimiento, o por tipo) + shake si pega fuerte
      efectoAtaque(document.querySelector('.bt-arena'), mov, defLado === 'r');
      def.hp = Math.max(0, def.hp - dmgInfo.dmg);
      defImg.classList.add('bt-hit');
      const fuerte = dmgInfo.efec >= 2 || dmgInfo.dmg > def.hpMax * 0.38;
      if (fuerte) document.querySelector('.bt-arena').classList.add('bt-sacude');
      render(); await esperar(220);
      defImg.classList.remove('bt-hit'); document.querySelector('.bt-arena').classList.remove('bt-sacude');
      await esperar(620);
      if (def.hp <= 0) {
        cry(def.id, 0.3); await narrar(def.nombre + ' se debilitó.');
        if (defLado === 'r') darEV(miAct().iid, yieldDe(def.id));   // práctica: EVs al activo del jugador
        defImg.classList.add('bt-faint'); await esperar(650); defImg.classList.remove('bt-faint');
        avanzar(defLado);
        if ((defLado === 'p' ? G.pa : G.ra) < 0) return;   // equipo eliminado → el caller corre fin()
        render(); cry((defLado === 'p' ? miAct() : rivAct()).id, 0.35); await esperar(450);
        // habilidad AL ENTRAR del reemplazo (Intimidación) → intimida al activo rival
        { const nuevo = defLado === 'p' ? miAct() : rivAct(), opo = defLado === 'p' ? rivAct() : miAct();
          const te = habAlEntrar(nuevo, opo); if (te) { render(); await narrar(te); await esperar(400); } }
      }
    }
    function avanzar(lado) {
      const team = lado === 'p' ? G.equipo : G.rival;
      const idx = team.findIndex((c) => c.hp > 0);
      if (lado === 'p') G.pa = idx; else G.ra = idx;
    }

    // chip de estado alterado junto al nombre
    const estadoChip = (c) => c.estado && ESTADOS[c.estado]
      ? '<span class="bt-est" style="--e:' + ESTADOS[c.estado].color + '">' + ESTADOS[c.estado].ico + ' ' + ESTADOS[c.estado].sigla + '</span>' : '';

    // una acción de un lado: resuelve estado (sueño/cong/para/confusión), fallo (precisión),
    // el movimiento, y aplica el estado del move al rival.
    async function accion(lado, mov) {
      const at = lado === 'p' ? miAct() : rivAct();
      const defLado = lado === 'p' ? 'r' : 'p';
      const def = lado === 'p' ? rivAct() : miAct();
      const img = lado === 'p' ? $('p-img') : $('r-img');
      const pa = puedeActuar(at);
      if (pa.texto) {
        if (pa.autogolpe) { img.classList.add('bt-hit'); }
        render(); await narrar(pa.texto); await esperar(350);
        if (pa.autogolpe) { img.classList.remove('bt-hit'); }
      }
      if (!pa.actua) return;                                   // perdió el turno (no gasta PP)
      if (mov.id && mov.pp > 0) mov.pp--;                      // consume PP (Forcejeo id 0 no gasta)
      if (!acierta(mov, Math.random, at)) { render(); await narrar('¡' + at.nombre + ' usó ' + mov.nombre + '… pero falló!'); await esperar(350); return; }
      await usarMov(at, mov, defLado);
      if (def.hp > 0) { const t = aplicarAilment(mov, at, def); if (t) { render(); await narrar(t); await esperar(400); } }
      if (def.hp > 0) { const tc = habAlContacto(def, at, mov, Math.random); if (tc) { render(); await narrar(tc); await esperar(400); } }
    }

    // daño por turno (veneno/quemadura) del activo del lado, con su posible debilitamiento.
    async function tick(lado) {
      const c = lado === 'p' ? miAct() : rivAct();
      const tk = tickEstado(c);
      if (!tk.dmg) return;
      const img = lado === 'p' ? $('p-img') : $('r-img');
      img.classList.add('bt-hit'); render(); await narrar(tk.texto); img.classList.remove('bt-hit'); await esperar(450);
      if (c.hp <= 0) {
        cry(c.id, 0.3); await narrar(c.nombre + ' se debilitó.');
        if (lado === 'r') darEV(miAct().iid, yieldDe(c.id));   // práctica: EVs al activo del jugador
        img.classList.add('bt-faint'); await esperar(650); img.classList.remove('bt-faint');
        avanzar(lado); render(); await esperar(350);
        // habilidad AL ENTRAR del reemplazo (Intimidación) → intimida al activo rival
        const nuevo = lado === 'p' ? miAct() : rivAct(), opo = lado === 'p' ? rivAct() : miAct();
        if (nuevo && opo) { const te = habAlEntrar(nuevo, opo); if (te) { render(); await narrar(te); await esperar(400); } }
      }
    }

    async function turno(mov) {
      if (G.lock) return; cancelarTimer(); G.lock = true; render();
      const movR = elegirCPU(rivAct(), miAct());
      // orden por VELOCIDAD (empate: jugador). Guardo los activos del inicio: el que cae este turno
      // no ataca (su reemplazo entra pero no actúa, como en los juegos).
      const pAct0 = miAct(), rAct0 = rivAct();
      const pasos = (pAct0.spe || 0) >= (rAct0.spe || 0)
        ? [['p', mov, pAct0], ['r', movR, rAct0]]
        : [['r', movR, rAct0], ['p', mov, pAct0]];
      for (const [lado, mv, actor] of pasos) {
        if (actor.hp <= 0) continue;       // cayó por el golpe del que fue más rápido → no contraataca
        await accion(lado, mv);
        if (fin()) return;
        await tick(lado);
        if (fin()) return;
      }
      G.carga = Math.min(100, G.carga + 34);
      G.lock = false; render(); armarTimer();
    }
    async function turnoRival() {
      await accion('r', elegirCPU(rivAct(), miAct()));
    }

    function fin() {
      if (vivos(G.rival) === 0) { terminar(true); return true; }
      if (vivos(G.equipo) === 0) { terminar(false); return true; }
      return false;
    }
    function terminar(gano) {
      G.lock = true; cancelarTimer(); cancelarRetoTimer(); detenerMusica();
      if (gano) {
        sonarEpico();
        const fams = new Set(G.equipo.map((c) => c.id));
        fams.forEach((id) => darCaramelos(id, 3));
        darBalls(5);
        $('fin-tit').textContent = '🏆 ¡Ganaste!';
        $('fin-msg').textContent = 'Tu equipo ganó. 🍬 +3 caramelos para cada Pokémon que peleó · 🔴 +5 Pokéballs.';
      } else {
        darBalls(5);
        $('fin-tit').textContent = '💪 Perdiste…';
        $('fin-msg').textContent = 'No aflojes. 🔴 +5 Pokéballs de consuelo para seguir entrenando.';
      }
      $('bt-fin').hidden = false;
    }

    // ── Mochila: pociones (HP), curas de estado y Revivir (cuesta el turno) ──
    const efectoTxt = (it) => it.cura ? ('cura ' + (it.cura > 9000 ? 'TODO el' : it.cura) + ' HP')
      : it.curaEstado ? ('cura ' + (it.curaEstado === 'todos' ? 'cualquier estado' : (ESTADOS[it.curaEstado] || {}).nombre)) : 'revive (50% HP)';
    function abrirMochila() {
      if (G.lock || G.itemsUsados >= 2) return;
      const inv = items();
      const usables = Object.entries(ITEMS).filter(([id, it]) => (it.cat === 'cura' || it.cat === 'estado') && inv[id] > 0);
      if (!usables.length) { msg('Tu Mochila está vacía. Comprá pociones/curas en la Tienda 🛒'); return; }
      cancelarTimer();
      $('mochila-lista').innerHTML = usables.map(([id, it]) => '<button class="mo-item" data-item="' + id + '"><span class="mo-ico">' + itemSvg(id, 26) + '</span> <b>' + it.nombre + '</b><small>' + efectoTxt(it) + ' · ×' + inv[id] + '</small></button>').join('');
      $('mochila-lista').querySelectorAll('[data-item]').forEach((b) => b.addEventListener('click', () => usarItemBatalla(b.dataset.item)));
      $('mochila-modal').hidden = false;
    }
    function cerrarMochila() { $('mochila-modal').hidden = true; if (G && !G.lock) armarTimer(); }
    async function usarItemBatalla(itemId) {
      const it = ITEMS[itemId]; if (!it || G.lock || G.itemsUsados >= 2) return;
      const a = miAct();
      // validar aplicabilidad ANTES de gastar el item / el turno
      if (it.cura) { if (a.hp >= a.hpMax) { msg(a.nombre + ' ya tiene el HP al máximo.'); return; } }
      else if (it.curaEstado) { const aplica = it.curaEstado === 'todos' ? !!a.estado : a.estado === it.curaEstado; if (!aplica) { msg(a.nombre + ' no tiene ese estado.'); return; } }
      else if (it.revive) { if (!G.equipo.some((c) => c.hp <= 0)) { msg('No hay ningún Pokémon debilitado para revivir.'); return; } }
      if (!usarItem(itemId)) return;
      $('mochila-modal').hidden = true; cancelarTimer(); G.lock = true; G.itemsUsados++;
      let _it = '';
      if (it.cura) { const c = Math.min(a.hpMax - a.hp, it.cura); a.hp += c; _it = '¡Usaste ' + it.nombre + '! ' + a.nombre + ' recuperó ' + c + ' HP.'; }
      else if (it.curaEstado) { a.estado = null; a.estadoT = 0; _it = '¡Usaste ' + it.nombre + '! ' + a.nombre + ' se recuperó.'; }
      else if (it.revive) { const ko = G.equipo.find((c) => c.hp <= 0); ko.hp = Math.max(1, Math.round(ko.hpMax * it.revive)); ko.estado = null; ko.estadoT = 0; sonarExito(); _it = '¡' + ko.nombre + ' revivió con ' + ko.hp + ' HP!'; }
      render();
      await narrar(_it);
      await esperar(500);
      await turnoRival();
      if (fin()) return;
      await tick('r');
      if (fin()) return;
      G.lock = false; render(); armarTimer();
    }

    // ── Súper: reto de código ──
    function abrirReto() {
      if (G.carga < 100 || G.lock) return;
      cancelarTimer(); G.lock = true; render();
      const reg = regionesDesbloqueadas(D.temas);
      const reto = retoAlAzar(reg);
      const t0 = Date.now();
      $('reto-q').textContent = reto.q;
      $('reto-ops').innerHTML = reto.op.map((o, i) => '<button class="reto-op" data-i="' + i + '">' + o + '</button>').join('');
      $('reto-ops').querySelectorAll('.reto-op').forEach((b) => b.addEventListener('click', () => resolverReto(reto, +b.dataset.i, t0)));
      $('reto-modal').hidden = false;
      // timeout del reto: si no respondés en RETO_SEG, el súper se apaga
      let seg = RETO_SEG; const bar = $('reto-timer-bar'); bar.style.width = '100%';
      retoH = setInterval(() => { seg--; bar.style.width = Math.max(0, seg / RETO_SEG * 100) + '%'; if (seg <= 0) { cancelarRetoTimer(); resolverReto(reto, -1, t0); } }, 1000);
    }
    async function resolverReto(reto, i, t0) {
      if ($('reto-modal').hidden) return;   // ya resuelto (click o timeout)
      cancelarRetoTimer();
      $('reto-modal').hidden = true;
      G.carga = 0;
      const ok = i === reto.c;
      if (ok) {
        const seg = (Date.now() - t0) / 1000;
        const calidad = Math.max(0, Math.min(1, 1 - seg / 12)); // rápido = mejor
        sonarExito();
        const s = danoSuper(miAct(), rivAct(), calidad);
        await narrar('✅ ¡Correcto! ' + miAct().nombre + ' desata un SÚPER con ' + s.mov.nombre + '!');
        await esperar(350);
        await aplicarGolpe(miAct(), s.mov, 'r', { dmg: s.dmg, efec: s.efec });
      } else {
        await narrar('❌ Incorrecto… el súper se apagó.');
        await esperar(450);
      }
      if (fin()) return;
      await turnoRival();
      if (fin()) return;
      G.lock = false; render(); armarTimer();
    }

    // botón de música/sonido en la batalla (global)
    (function () {
      const b = $('bt-mute'); if (!b) return;
      const pintarMute = () => { b.textContent = sonidoActivo() ? '🔊' : '🔇'; };
      pintarMute();
      b.addEventListener('click', () => {
        const activo = toggleSonido();      // true = quedó activo
        pintarMute();
        if (activo && !$('bt-combate').hidden) musicaBatalla(); else detenerMusica();
      });
    })();

    $('mochila-x').addEventListener('click', cerrarMochila);
    $('mochila-modal').addEventListener('click', (e) => { if (e.target === $('mochila-modal')) cerrarMochila(); });

    // ════════════════ Modo EN VIVO (PvP, server-autoritativo) ════════════════
    let OS = null;              // {snap, prev}
    let onlineWired = false;
    let musOn = false;          // música de batalla online activa
    let selOnline = new Set();
    const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const loMsg = (t) => { const m = $('lo-msg'); if (m) m.textContent = t; };

    function volverInicio() {
      detenerMusica(); musOn = false;
      if (typeof limpiarOnline === 'function') limpiarOnline();
      $('bt-estado-online').hidden = true; $('bt-timer-online').hidden = true;
      $('bt-fin').hidden = true; $('bt-combate').hidden = true; $('bt-sel').hidden = true; $('bt-online').hidden = true;
      $('reto-modal').hidden = true; $('mochila-modal').hidden = true; $('reemplazo-modal').hidden = true; $('bt-modo').hidden = false;
    }

    // ── Lobby ──
    function lobbyOnline() {
      if (!online.hayOnline) {
        $('bt-online').innerHTML = '<p class="bt-vacio">El modo en vivo necesita la nube. Iniciá sesión (☁️) para jugar PvP.</p><button class="bt-volver" id="lo-volver">← Volver</button>';
        $('bt-online').hidden = false; $('lo-volver').onclick = volverInicio; return;
      }
      $('bt-online').innerHTML =
        '<h2 class="liga-h">🌐 En vivo</h2>' +
        '<div class="bt-lobby">' +
          '<button class="btn-tirar" id="lo-cola">🎯 Buscar rival (cola)</button>' +
          '<button class="bt-modo-b" id="lo-codear"><b>🔑 Crear código</b><small>sala privada</small></button>' +
          '<div class="bt-codejoin"><input id="lo-code" placeholder="CÓDIGO" maxlength="8" /><button class="bt-modo-b" id="lo-join">Unirme</button></div>' +
          '<div class="bt-amigos" id="lo-amigos"><small>Cargando amigos…</small></div>' +
        '</div>' +
        '<div class="bt-rank" id="bt-rank"></div>' +
        '<p class="bt-msg" id="lo-msg"></p><button class="bt-volver" id="lo-volver">← Volver</button>';
      $('bt-online').hidden = false;
      wireOnline();
      $('lo-cola').onclick = () => { online.buscar(); loMsg('Buscando rival…'); };
      $('lo-codear').onclick = () => online.crearCodigo();
      $('lo-join').onclick = () => { const c = $('lo-code').value.trim(); if (c) online.unirseCodigo(c); };
      $('lo-volver').onclick = () => { online.cancelarCola(); volverInicio(); };
      cargarAmigos();
      cargarRanking();
    }
    function cargarRanking() {
      const cont = $('bt-rank'); if (!cont) return;
      let pvp = {}, hist = [];
      try { pvp = JSON.parse(localStorage.getItem('col:pvp') || '{}'); } catch {}
      try { hist = JSON.parse(localStorage.getItem('col:pvp_hist') || '[]'); } catch {}
      const tu = '<div class="bt-rank-yo">🏅 Tu rating: <b>' + (pvp.rating || 1000) + '</b> · ' + (pvp.victorias || 0) + 'V / ' + (pvp.jugados || 0) + ' duelos · racha ' + (pvp.racha || 0) + '</div>';
      const histH = hist.length ? '<div class="bt-rank-hist">' + hist.slice(0, 5).map((h) => '<span class="bt-duelo ' + (h.gano ? 'g' : 'p') + '">' + (h.gano ? '✓' : '✗') + ' ' + esc(h.rival || '?') + ' <b>' + (h.delta >= 0 ? '+' : '') + h.delta + '</b></span>').join('') + '</div>' : '';
      cont.innerHTML = tu + histH + '<div id="bt-rank-top"><small>Cargando ranking…</small></div>';
      rankingPvp().then((top) => {
        const t = $('bt-rank-top'); if (!t) return;
        if (!top || !top.length) { t.innerHTML = '<small>Todavía no hay duelos jugados. ¡Sé el primero! 🏆</small>'; return; }
        t.innerHTML = '<small>🏆 Ranking de la clase</small><ol class="bt-rank-ol">' + top.map((r) => '<li><span class="r-rt">' + r.rating + '</span> ' + esc(r.nombre || ('@' + r.handle) || '—') + ' <span class="r-v">' + r.victorias + 'V</span></li>').join('') + '</ol>';
      }).catch(() => { const t = $('bt-rank-top'); if (t) t.innerHTML = ''; });
    }
    async function cargarAmigos() {
      try {
        const list = await amigos(); const cont = $('lo-amigos'); if (!cont) return;
        if (!list || !list.length) { cont.innerHTML = '<small>Sin amigos aún. Agregalos en la Liga 🏆</small>'; return; }
        cont.innerHTML = '<small>Invitar a un amigo:</small><div class="bt-amigos-l">' + list.map((a) =>
          '<button class="bt-amigo" data-uid="' + esc(a.userId || a.id) + '">👤 ' + esc(a.nombre || a.handle || 'amigo') + '</button>').join('') + '</div>';
        cont.querySelectorAll('[data-uid]').forEach((b) => b.onclick = () => { online.invitar(b.dataset.uid); loMsg('Invitación enviada…'); });
      } catch { const c = $('lo-amigos'); if (c) c.innerHTML = '<small>No se pudieron cargar los amigos.</small>'; }
    }

    // ── Selección de equipo (en vivo) ──
    function seleccionOnline(rival) {
      selOnline = new Set();
      const arr = pc();
      if (!arr.length) { $('bt-online').innerHTML = '<p class="bt-vacio">No tenés Pokémon. Andá al Safari 🎒</p><button class="bt-volver" id="so-volver">← Volver</button>'; $('bt-online').hidden = false; $('so-volver').onclick = () => { online.rendirse(); volverInicio(); }; return; }
      const lista = porPoder(arr), tipos = tiposPresentes(lista);
      let filtro = null;
      $('bt-online').innerHTML =
        '<h2 class="liga-h">Elegí tu equipo <small>(hasta 3 · por poder) · rival: ' + esc((rival && rival.nombre) || '?') + '</small></h2>' +
        chipsFiltroTipo(tipos, filtro) + '<div class="bt-picks" id="so-grid"></div>' +
        '<button class="btn-tirar" id="so-listo" disabled>✅ ¡Listo!</button><p class="bt-msg" id="so-msg"></p>';
      $('bt-online').hidden = false; $('bt-combate').hidden = true;
      const grid = $('so-grid');
      function pintarGrid() {
        const vis = filtro ? lista.filter((x) => x.tipos.includes(filtro)) : lista;
        grid.innerHTML = vis.length
          ? vis.map((x) => '<button class="bt-pick' + (selOnline.has(String(x.m.iid)) ? ' sel' : '') + '" data-iid="' + x.m.iid + '"><img src="' + spriteUrl(x.m.id, x.m.shiny) + '" alt="" /><span>' + esc(x.m.mote || ('Nº ' + x.m.id)) + '</span><small>💪 ' + x.poder + ' · Nv.' + x.m.nivel + '</small></button>').join('')
          : '<p class="bt-vacio">Ningún Pokémon de ese tipo.</p>';
        grid.querySelectorAll('.bt-pick').forEach((b) => b.onclick = () => {
          const iid = b.dataset.iid;
          if (selOnline.has(iid)) { selOnline.delete(iid); b.classList.remove('sel'); }
          else if (selOnline.size < 3) { selOnline.add(iid); b.classList.add('sel'); }
          $('so-listo').disabled = selOnline.size < 1;
        });
      }
      pintarGrid();
      $('bt-online').querySelectorAll('.bt-ftipo').forEach((b) => b.addEventListener('click', () => {
        filtro = b.dataset.ftipo || null;
        $('bt-online').querySelectorAll('.bt-ftipo').forEach((x) => x.classList.toggle('on', (x.dataset.ftipo || '') === (filtro || '')));
        pintarGrid();
      }));
      $('so-listo').onclick = () => { online.elegirEquipo([...selOnline]); $('so-listo').disabled = true; $('so-msg').textContent = 'Esperando al rival…'; };
    }

    // ── estado de la ronda simultánea (cliente) ──
    // OS = { snap, prev }. ONL = estado de UI de la ronda en curso.
    let ONL = { deadline: 0, miEleccion: null, bloqueado: false, rivalListo: false, animando: false, fase: 'combate' };
    let timerOnH = null;
    function cancelarTimerOnline() { if (timerOnH) { cancelAnimationFrame(timerOnH); timerOnH = null; } $('bt-timer-online').hidden = true; }

    // Banner de estado: 🟢 elegir / ⏳ esperando / ⚔️ resolviendo / 🔄 reemplazo / 🏁 fin
    function bannerOnline(ico, txt, mod) {
      const cont = $('bt-estado-online'); if (!cont) return;
      cont.hidden = false;
      $('bt-eo-ico').textContent = ico; $('bt-eo-txt').textContent = txt;
      cont.className = 'bt-estado-online' + (mod ? ' ' + mod : '');
    }

    // Timer que drena hacia ronda.deadline (epoch ms). Animado con requestAnimationFrame.
    function armarTimerOnline(deadline) {
      cancelarTimerOnline();
      ONL.deadline = deadline || 0;
      if (!deadline) return;
      const cont = $('bt-timer-online'), txt = $('bt-timer-online-txt'), bar = $('bt-timer-online-bar');
      const total = Math.max(1, deadline - Date.now());
      cont.hidden = false;
      const tick = () => {
        const restante = deadline - Date.now();
        if (restante <= 0) { txt.textContent = '⏱ 0s'; bar.style.width = '0%'; cont.classList.add('urgente'); timerOnH = null; return; }
        const seg = Math.ceil(restante / 1000);
        txt.textContent = '⏱ ' + seg + 's para elegir';
        bar.style.width = Math.max(0, Math.min(100, (restante / total) * 100)) + '%';
        cont.classList.toggle('urgente', seg <= 5);
        timerOnH = requestAnimationFrame(tick);
      };
      tick();
    }

    // ── Combate (render desde el snapshot del server) ──
    // selección: durante la fase de combate el jugador elige UNA acción; el server resuelve.
    function renderOnline() {
      if (!OS || !OS.snap) return;
      const snap = OS.snap, myUid = online.miUid();
      const me = snap.jugadores.find((j) => j.uid === myUid), rival = snap.jugadores.find((j) => j.uid !== myUid);
      if (!me || !rival) return;
      const myAct = me.equipo[me.activo], rivAct = rival.equipo[rival.activo];
      $('bt-online').hidden = true; $('bt-sel').hidden = true; $('bt-modo').hidden = true; $('bt-combate').hidden = false;
      $('bt-timer').hidden = true;   // el timer "vs CPU" no se usa en vivo
      $('r-nom').textContent = rivAct.nombre; $('r-lv').textContent = 'Nv.' + rivAct.nivel; $('r-tipos').textContent = rivAct.tipos.join(' · '); $('r-estado').innerHTML = estadoChip(rivAct); setSpr('r-img', rivAct, false); hp('r-hp', rivAct); dots('r-dots', rival.equipo);
      $('p-nom').textContent = myAct.nombre; $('p-lv').textContent = 'Nv.' + myAct.nivel; $('p-tipos').textContent = myAct.tipos.join(' · '); $('p-estado').innerHTML = estadoChip(myAct); setSpr('p-img', myAct, true); hp('p-hp', myAct); dots('p-dots', me.equipo);
      hudIdent('r', rivAct); hudIdent('p', myAct);
      $('bt-carga').style.width = me.super + '%'; $('bt-carga-txt').textContent = 'Súper: ' + me.super + '%';
      const enCombate = snap.fase === 'combate';
      // mientras animo la resolución o ya elegí, el menú queda bloqueado (salvo re-pick)
      const puedeElegir = enCombate && !ONL.animando && !ONL.bloqueado;
      const superListo = me.super >= 100;
      $('bt-moves').innerHTML = myAct.movs.map((mv, i) =>
        '<button class="bt-move" data-i="' + i + '"' + (puedeElegir ? '' : ' disabled') + '><b>' + esc(mv.nombre) + '</b><small>' + esc(mv.tipo) + (mv.poder ? ' · ⚔️' + mv.poder : '') + '</small></button>').join('') +
        '<button class="bt-move bt-super" id="bt-super"' + (puedeElegir && superListo ? '' : ' disabled') + '>⚡ SÚPER</button>' +
        '<button class="bt-move bt-mochila" id="bt-mochila"' + (puedeElegir ? '' : ' disabled') + '>🎒 Mochila</button>' +
        '<button class="bt-move bt-rendir" id="bt-rendir"' + (ONL.animando ? ' disabled' : '') + '>🏳️ Rendirse</button>';
      $('bt-moves').querySelectorAll('.bt-move[data-i]').forEach((b) => b.onclick = () => { if (puedeElegir) elegirAccionOnline({ tipo: 'mover', i: +b.dataset.i }, esc(myAct.movs[+b.dataset.i].nombre)); });
      $('bt-super').onclick = () => { if (puedeElegir && superListo) lanzarSuperOnline(); };
      $('bt-mochila').onclick = () => { if (puedeElegir) abrirMochilaOnline(); };
      $('bt-rendir').onclick = () => { if (!ONL.animando && confirm('¿Rendirte? Cuenta como derrota.')) online.rendirse(); };
      $('bt-banca').innerHTML = me.equipo.map((c, i) => {
        const ko = c.hp <= 0, act = i === me.activo, dis = act || ko || !puedeElegir, pct = Math.max(0, Math.round((c.hp / c.hpMax) * 100));
        return '<button class="bt-banca-m' + (act ? ' activo' : '') + (ko ? ' ko' : '') + '" data-sw="' + i + '"' + (dis ? ' disabled' : '') + '><img src="' + spriteUrl(c.id, c.shiny) + '" alt="" /><span class="bm-nom">' + esc(c.nombre) + '</span><span class="bm-hp"><i style="width:' + pct + '%"></i></span><small>' + (ko ? '💀 Debilitado' : act ? '● En combate' : 'Nv.' + c.nivel) + '</small></button>';
      }).join('');
      $('bt-banca').querySelectorAll('[data-sw]').forEach((b) => b.onclick = () => { if (puedeElegir) elegirAccionOnline({ tipo: 'cambiar', idx: +b.dataset.sw }, 'cambiar a ' + esc(me.equipo[+b.dataset.sw].nombre)); });
    }

    // helper: nombre del activo del lado (para FX/cries durante la resolución)
    function actDe(snap, uid) { const j = snap.jugadores.find((x) => x.uid === uid); return j ? j.equipo[j.activo] : null; }

    // etiqueta legible de la acción elegida (para el chip "✓ Elegiste: …")
    function etiquetaAccion(accion) {
      if (!accion) return '—';
      const me = OS && OS.snap && OS.snap.jugadores.find((j) => j.uid === online.miUid());
      const act = me && me.equipo[me.activo];
      if (accion.tipo === 'mover') return act && act.movs[accion.i] ? esc(act.movs[accion.i].nombre) : 'ataque';
      if (accion.tipo === 'cambiar') { const c = me && me.equipo[accion.idx]; return 'cambiar a ' + esc((c && c.nombre) || '?'); }
      if (accion.tipo === 'pocion') { const it = ITEMS[accion.itemId]; return esc((it && it.nombre) || 'poción'); }
      if (accion.tipo === 'super') return 'Súper ⚡';
      if (accion.tipo === 'rendirse') return 'rendirse';
      return '—';
    }

    // elegir una acción de la ronda: la manda al server, bloquea el menú y deja re-elegir
    // hasta que el rival bloquee (rivalListo) o se acabe el timer.
    function elegirAccionOnline(accion, etiqueta) {
      ONL.miEleccion = accion; ONL.bloqueado = true;
      online.elegir(accion);
      pintarEspera(etiqueta);
    }
    // chip "✓ Elegiste: X" + ⏳ esperando + botón Cambiar (re-pick) habilitado hasta rivalListo/timeout
    function pintarEspera(etiqueta) {
      bannerOnline('⏳', 'Esperando al rival…', 'esperando');
      const puedeRepick = !ONL.rivalListo;
      $('bt-moves').innerHTML =
        '<div class="bt-lock">' +
          '<div class="bt-lock-chip">✓ Elegiste: <b>' + (etiqueta || '—') + '</b></div>' +
          '<div class="bt-lock-sub">' + (ONL.rivalListo ? '⚔️ El rival ya eligió — resolviendo…' : '⏳ Esperando que el rival elija…') + '</div>' +
          '<button class="bt-move bt-repick"' + (puedeRepick ? '' : ' disabled') + ' id="bt-repick">↩️ Cambiar mi acción</button>' +
        '</div>';
      const rb = $('bt-repick'); if (rb) rb.onclick = () => { if (!ONL.rivalListo) { ONL.bloqueado = false; ONL.miEleccion = null; renderOnline(); } };
    }

    // ── Súper inline: abrir TU reto; mientras tanto el rival sigue eligiendo. Al resolver, mando la calidad. ──
    function lanzarSuperOnline() {
      // marco que ya "elegí" (bloquea el menú); el reto corre en paralelo a la elección del rival
      ONL.miEleccion = { tipo: 'super', pendiente: true }; ONL.bloqueado = true;
      pintarEsperaSuper();
      abrirRetoOnline();
    }
    function pintarEsperaSuper() {
      bannerOnline('⚡', 'Resolviendo tu Súper…', 'super');
      $('bt-moves').innerHTML =
        '<div class="bt-lock">' +
          '<div class="bt-lock-chip super">⚡ Resolviendo tu Súper…</div>' +
          '<div class="bt-lock-sub">' + (ONL.rivalListo ? 'El rival ya eligió.' : 'El rival sigue eligiendo.') + '</div>' +
        '</div>';
    }
    // súper por código: abrís TU reto; al resolver mandás la calidad al server (lanzarSuper)
    function abrirRetoOnline() {
      const reto = retoAlAzar(regionesDesbloqueadas(D.temas)); const t0 = Date.now();
      $('reto-q').textContent = reto.q;
      $('reto-ops').innerHTML = reto.op.map((o, i) => '<button class="reto-op" data-i="' + i + '">' + esc(o) + '</button>').join('');
      $('reto-ops').querySelectorAll('.reto-op').forEach((b) => b.onclick = () => resolverRetoOnline(reto, +b.dataset.i, t0));
      $('reto-modal').hidden = false;
      let seg = RETO_SEG; const bar = $('reto-timer-bar'); bar.style.width = '100%'; cancelarRetoTimer();
      retoH = setInterval(() => { seg--; bar.style.width = Math.max(0, seg / RETO_SEG * 100) + '%'; if (seg <= 0) { cancelarRetoTimer(); resolverRetoOnline(reto, -1, t0); } }, 1000);
    }
    function resolverRetoOnline(reto, i, t0) {
      if ($('reto-modal').hidden) return; cancelarRetoTimer(); $('reto-modal').hidden = true;
      const ok = i === reto.c, seg = (Date.now() - t0) / 1000;
      const calidad = ok ? Math.max(0.05, Math.min(1, 1 - seg / 12)) : 0;
      if (ok) sonarExito();
      online.lanzarSuper(calidad);   // manda la acción {tipo:'super', calidad}; el server resuelve la ronda
    }
    function abrirMochilaOnline() {
      const inv = items();
      const usables = Object.entries(ITEMS).filter(([id, it]) => (it.cat === 'cura' || it.cat === 'estado') && inv[id] > 0);
      if (!usables.length) { $('bt-msg').textContent = 'Mochila vacía. Comprá pociones/curas en la Tienda 🛒'; return; }
      $('mochila-lista').innerHTML = usables.map(([id, it]) => '<button class="mo-item" data-item="' + id + '"><span class="mo-ico">' + itemSvg(id, 26) + '</span> <b>' + esc(it.nombre) + '</b><small>' + efectoTxt(it) + ' · ×' + inv[id] + '</small></button>').join('');
      $('mochila-lista').querySelectorAll('[data-item]').forEach((b) => b.onclick = () => usarItemOnline(b.dataset.item));
      $('mochila-modal').hidden = false;
    }
    function usarItemOnline(itemId) {
      const it = ITEMS[itemId]; if (!it || !OS || !OS.snap) return;
      const me = OS.snap.jugadores.find((j) => j.uid === online.miUid()); if (!me) return;
      const a = me.equipo[me.activo];
      // validar aplicabilidad para no gastar el turno en vano (el server revalida)
      if (it.cura) { if (a.hp >= a.hpMax) { $('bt-msg').textContent = a.nombre + ' ya tiene el HP al máximo.'; return; } }
      else if (it.curaEstado) { const ok = it.curaEstado === 'todos' ? !!a.estado : a.estado === it.curaEstado; if (!ok) { $('bt-msg').textContent = a.nombre + ' no tiene ese estado.'; return; } }
      else if (it.revive) { if (!me.equipo.some((c) => c.hp <= 0)) { $('bt-msg').textContent = 'No hay ningún Pokémon debilitado para revivir.'; return; } }
      if (!usarItem(itemId)) return;
      $('mochila-modal').hidden = true;
      elegirAccionOnline({ tipo: 'pocion', itemId }, esc(it.nombre));
    }
    // ── REVEAL + animar la resolución de la ronda ──
    // Estructurado para que Task 6 reemplace `narrarRonda(texto)` por el typewriter `await narrar(...)`.
    function narrarRonda(texto) { return narrar(texto); }   // typewriter FireRed (await en los call-sites)

    // refresca HUD (HP, sprites, estado, dots) desde un snapshot — sin re-armar el menú
    function pintarHud(snap) {
      const myUid = online.miUid();
      const me = snap.jugadores.find((j) => j.uid === myUid), rival = snap.jugadores.find((j) => j.uid !== myUid);
      if (!me || !rival) return;
      const myAct = me.equipo[me.activo], rivAct = rival.equipo[rival.activo];
      $('r-nom').textContent = rivAct.nombre; $('r-lv').textContent = 'Nv.' + rivAct.nivel; $('r-tipos').textContent = rivAct.tipos.join(' · '); $('r-estado').innerHTML = estadoChip(rivAct); setSpr('r-img', rivAct, false); hp('r-hp', rivAct); dots('r-dots', rival.equipo);
      $('p-nom').textContent = myAct.nombre; $('p-lv').textContent = 'Nv.' + myAct.nivel; $('p-tipos').textContent = myAct.tipos.join(' · '); $('p-estado').innerHTML = estadoChip(myAct); setSpr('p-img', myAct, true); hp('p-hp', myAct); dots('p-dots', me.equipo);
      hudIdent('r', rivAct); hudIdent('p', myAct);
      $('bt-carga').style.width = me.super + '%'; $('bt-carga-txt').textContent = 'Súper: ' + me.super + '%';
    }

    // anima los `eventos` de una ronda en orden: narra cada texto, FX/cry de impacto, actualiza HUD desde snap.
    // Estructura pensada para Task 6: cada `narrarRonda(...)` será `await narrar(...)`.
    // id de la barra de HP del lado de `uid` (mío = 'p-hp', rival = 'r-hp')
    const barraDe = (uid) => (uid === online.miUid() ? 'p-hp' : 'r-hp');
    // refleja un CAMBIO/entrada al instante: sprite + nombre/nivel/tipos/estado del lado + barra al HP del momento.
    function mostrarLado(snap, uid, hpRest, hpMax) {
      const c = actDe(snap, uid); if (!c) return;
      const esMio = uid === online.miUid(), pre = esMio ? 'p' : 'r';
      $(pre + '-nom').textContent = c.nombre; $(pre + '-lv').textContent = 'Nv.' + c.nivel;
      $(pre + '-tipos').textContent = (c.tipos || []).join(' · '); $(pre + '-estado').innerHTML = estadoChip(c);
      setSpr(pre + '-img', c, esMio);
      hp(pre + '-hp', { hp: hpRest != null ? hpRest : c.hp, hpMax: hpMax != null ? hpMax : c.hpMax });
    }

    async function animarRonda(snap, eventos) {
      ONL.animando = true; ONL.bloqueado = true; ONL.rivalListo = false; ONL.miEleccion = null;
      cancelarTimerOnline();
      bannerOnline('⚔️', 'Resolviendo…', 'resolviendo');
      const evs = eventos || [];
      const myUid = online.miUid();
      // "▶ primero": quién posee el primer mover/super
      const primero = evs.find((e) => e.t === 'mover' || e.t === 'super');
      if (primero) {
        const mio = primero.uid === myUid;
        marcarPrimero(mio);
        await narrarRonda(mio ? '▶ ¡Vos primero!' : '▶ El rival se adelanta…');
        await esperar(420);
      }
      // anima cada evento en orden
      for (const ev of evs) {
        const dueno = ev.uid;                            // uid del que ACTÚA
        const esMio = dueno === myUid;
        if (ev.t === 'mover' || ev.t === 'super') {
          // el que recibe es el otro lado
          const atImgId = esMio ? 'p-img' : 'r-img', defImgId = esMio ? 'r-img' : 'p-img';
          const atImg = $(atImgId), defImg = $(defImgId);
          await narrarRonda(ev.texto || '¡Ataque!');
          await esperar(220);   // pequeña pausa tras la línea, antes del impacto
          if (atImg) { atImg.classList.add('bt-lunge'); await esperar(190); atImg.classList.remove('bt-lunge'); }
          // FX por daño: destello sobre el defensor + la barra de HP baja AL IMPACTO (no al final del turno)
          if (ev.dmg != null) { destello(!esMio, ev.tipo || ''); if (defImg) { defImg.classList.add('bt-hit'); } if (ev.efec >= 2) document.querySelector('.bt-arena').classList.add('bt-sacude'); }
          if (ev.hpRest != null) hp(barraDe(ev.objetivo), { hp: ev.hpRest, hpMax: ev.hpMax });
          await esperar(260);
          if (defImg) defImg.classList.remove('bt-hit'); document.querySelector('.bt-arena').classList.remove('bt-sacude');
          await esperar(520);
        } else if (ev.t === 'cambiar' || ev.t === 'cambio' || ev.t === 'reemplazo' || ev.t === 'entra') {
          await narrarRonda(ev.texto || '¡Adelante!');
          mostrarLado(snap, dueno, ev.hpRest, ev.hpMax);   // cambia el sprite/HUD al nuevo Pokémon EN EL MOMENTO
          const c = actDe(snap, dueno); if (c) cry(c.id, 0.4); await esperar(560);
        } else if (ev.t === 'debilitado' || ev.t === 'cae') {
          const c = actDe(snap, dueno); if (c) cry(c.id, 0.3);
          const img = esMio ? $('p-img') : $('r-img'); if (img) { img.classList.add('bt-faint'); }
          if (barraDe(dueno)) hp(barraDe(dueno), { hp: 0, hpMax: (c && c.hpMax) || 1 });   // KO → barra a 0
          await narrarRonda(ev.texto || 'se debilitó.'); await esperar(620);
          if (img) img.classList.remove('bt-faint');
        } else {
          // estado, fallo, pocion, tick, info, etc. — solo narrar (+ HP si es daño por veneno/quemadura)
          await narrarRonda(ev.texto || '');
          if (ev.t === 'dot' && ev.hpRest != null) hp(barraDe(ev.objetivo || ev.uid), { hp: ev.hpRest, hpMax: ev.hpMax });
          await esperar(480);
        }
      }
      // aplico el snapshot final (HP/sprites/super reales)
      OS = { snap, prev: OS && OS.snap }; pintarHud(snap);
      quitarPrimero();
      ONL.animando = false;
      // aviso al server que terminé de animar — SIEMPRE, incluido el FIN: así el server espera a que AMBOS
      // terminen de ver la animación antes de mostrar el resultado (no más "perdió" instantáneo sin animación).
      online.ackRonda();
      if (snap.fase === 'fin') { bannerOnline('🏁', '¡Fin del combate!', 'fin'); return; }
      bannerOnline('⌛', 'Esperando al rival…', 'resolviendo');
    }

    function marcarPrimero(mio) {
      quitarPrimero();
      const tgt = mio ? document.querySelector('.bt-yo') : document.querySelector('.bt-rival');
      if (tgt) tgt.classList.add('bt-primero');
    }
    function quitarPrimero() { document.querySelectorAll('.bt-primero').forEach((e) => e.classList.remove('bt-primero')); }

    // ── Reemplazo: elegir el próximo Pokémon (un equipo cae) ──
    function pintarReemplazo(uids) {
      cancelarTimerOnline();
      ONL.bloqueado = true; ONL.animando = false;
      const myUid = online.miUid();
      const meToca = (uids || []).includes(myUid);
      if (!meToca) {
        bannerOnline('🔄', 'El rival elige su próximo Pokémon…', 'reemplazo');
        narrarRonda('Esperando que el rival elija su Pokémon…');
        $('bt-moves').innerHTML = '<div class="bt-lock"><div class="bt-lock-chip">🔄 El rival está reemplazando…</div><div class="bt-lock-sub">Esperá tu turno.</div></div>';
        $('reemplazo-modal').hidden = true;
        return;
      }
      bannerOnline('🔄', 'Elegí tu próximo Pokémon', 'reemplazo');
      narrarRonda('Tu Pokémon cayó — elegí el próximo.');
      const me = OS && OS.snap && OS.snap.jugadores.find((j) => j.uid === myUid);
      if (!me) return;
      const lista = me.equipo.map((c, i) => {
        const ko = c.hp <= 0, act = i === me.activo, pct = Math.max(0, Math.round((c.hp / c.hpMax) * 100));
        const dis = ko || act;
        return '<button class="bt-banca-m reemplazo-m' + (ko ? ' ko' : '') + '" data-rep="' + i + '"' + (dis ? ' disabled' : '') + '>' +
          '<img src="' + spriteUrl(c.id, c.shiny) + '" alt="" /><span class="bm-nom">' + esc(c.nombre) + '</span>' +
          '<span class="bm-hp"><i style="width:' + pct + '%"></i></span>' +
          '<small>' + (ko ? '💀 Debilitado' : act ? '● En combate' : 'Nv.' + c.nivel) + '</small></button>';
      }).join('');
      $('reemplazo-lista').innerHTML = lista;
      $('reemplazo-lista').querySelectorAll('[data-rep]').forEach((b) => b.onclick = () => {
        const idx = +b.dataset.rep;
        if (me.equipo[idx].hp <= 0 || idx === me.activo) return;
        online.elegirReemplazo(idx);
        $('reemplazo-modal').hidden = true;
        bannerOnline('⏳', 'Listo — resolviendo…', 'esperando');
        narrarRonda('¡Adelante! Esperando al rival…');
      });
      $('reemplazo-modal').hidden = false;
    }

    // limpia el estado de la ronda online (al terminar)
    function limpiarOnline() {
      cancelarTimerOnline(); cancelarRetoTimer();
      ONL = { deadline: 0, miEleccion: null, bloqueado: false, rivalListo: false, animando: false, fase: 'combate' };
      quitarPrimero();
      $('reto-modal').hidden = true; $('mochila-modal').hidden = true; $('reemplazo-modal').hidden = true;
    }

    async function finOnline(data) {
      limpiarOnline();
      bannerOnline('🏁', '¡Fin del combate!', 'fin');
      const gano = data.ganador === online.miUid(), pr = data.premios || {};
      $('fin-tit').textContent = gano ? '🏆 ¡Ganaste!' : '💪 Perdiste…';
      let m = gano ? 'Venciste a tu rival.' : 'Caíste esta vez.';
      if (pr.balls) m += ' 🔴 +' + pr.balls + ' Pokéballs.';
      if (pr.caramelos) { const t = Object.values(pr.caramelos).reduce((a, b) => a + b, 0); if (t) m += ' 🍬 +' + t + ' caramelos.'; }
      if (pr.insignias && pr.insignias.length) m += ' 🏅 ¡Insignia nueva: ' + pr.insignias.join(', ') + '!';
      if (pr.rating != null) m += ' 📊 Rating: ' + pr.rating + ' (' + (pr.delta >= 0 ? '+' : '') + pr.delta + ').';
      if (pr.ev && pr.ev.some((n) => n > 0)) {
        const EVL = ['PS', 'Atq', 'Def', 'At.Esp', 'Df.Esp', 'Vel'];
        const evs = pr.ev.map((n, i) => n > 0 ? EVL[i] + '+' + n : null).filter(Boolean);
        if (evs.length) m += ' 💪 +EVs: ' + evs.join(' · ') + '.';
      }
      detenerMusica(); musOn = false;
      $('fin-msg').textContent = m; if (gano) sonarEpico(); $('bt-fin').hidden = false;
      try { await refrescarDesdeNube(); } catch {}
    }

    // suscripción a los eventos del gateway (una sola vez)
    function wireOnline() {
      if (onlineWired) return; onlineWired = true;
      online.conectarBatalla(localStorage.getItem('liga:nombre') || '');
      online.onBatalla('emparejado', (d) => { OS = null; seleccionOnline(d.rival); });
      online.onBatalla('enCola', () => loMsg('En cola, esperando rival…'));
      online.onBatalla('codigoCreado', (d) => loMsg('Tu código: ' + d.codigo + ' — compartilo. Esperando rival…'));
      online.onBatalla('invitado', () => loMsg('Invitación enviada. Esperando…'));
      online.onBatalla('invitacion', (d) => { if (confirm(((d && d.de) || 'Alguien') + ' te invitó a un duelo. ¿Aceptar?')) online.aceptar(d.roomId); });
      online.onBatalla('seleccion', (d) => { const m = $('so-msg'); if (m) { const r = (d.listos || []).find((x) => x.uid !== online.miUid()); m.textContent = r && r.listo ? 'Rival listo. ¡Empezamos!' : 'Esperando al rival…'; } });
      // snapshot inicial del combate
      online.onBatalla('estado', (snap) => {
        OS = { snap, prev: OS && OS.snap };
        ONL.fase = snap.fase;
        renderOnline();
        if (snap.fase === 'combate' && !musOn) { musOn = true; musicaBatalla(); }
      });
      // arranca una ronda de selección: deadline (epoch ms) + snapshot
      online.onBatalla('ronda', (d) => {
        OS = { snap: d.snap || (OS && OS.snap), prev: OS && OS.snap };
        ONL.bloqueado = false; ONL.animando = false; ONL.rivalListo = false; ONL.miEleccion = null; ONL.fase = 'combate';
        bannerOnline('🟢', 'Elegí tu acción', 'elegir');
        renderOnline();
        narrarRonda('¡Elegí tu acción!');
        armarTimerOnline(Date.now() + (d.dur || 30000));   // duración local: sin depender del reloj del server (el rival veía mal el timer)
        if (!musOn) { musOn = true; musicaBatalla(); }
      });
      // el rival bloqueó su acción → ya no puedo re-elegir
      online.onBatalla('rivalListo', () => {
        ONL.rivalListo = true;
        if (ONL.bloqueado && ONL.miEleccion) {
          // ya elegí → refresco el chip para deshabilitar "Cambiar" y avisar
          if (ONL.miEleccion.tipo === 'super') pintarEsperaSuper();
          else pintarEspera(etiquetaAccion(ONL.miEleccion));
        } else {
          // todavía no elegí → el banner avisa que el rival ya bloqueó
          bannerOnline('🟢', 'Elegí tu acción — el rival ya eligió', 'elegir');
        }
      });
      // mi elección quedó guardada (el server confirma)
      online.onBatalla('esperando', () => { if (!ONL.animando) { ONL.bloqueado = true; if (ONL.miEleccion && ONL.miEleccion.tipo !== 'super') pintarEspera(etiquetaAccion(ONL.miEleccion)); } });
      // la ronda se resolvió → revelar y animar los eventos en orden
      online.onBatalla('resolucion', (d) => {
        cancelarTimerOnline();
        ONL.fase = (d.snap && d.snap.fase) || 'combate';
        animarRonda(d.snap, d.eventos || []);
      });
      // un equipo cayó: hay que elegir reemplazo
      online.onBatalla('reemplazo', (d) => {
        if (d && d.snap) OS = { snap: d.snap, prev: OS && OS.snap };
        cancelarTimerOnline();
        ONL.fase = 'reemplazo';
        pintarReemplazo((d && d.uids) || []);
      });
      online.onBatalla('fin', (d) => finOnline(d));
      online.onBatalla('rivalDesconectado', (d) => { $('bt-msg').textContent = '⚠️ Rival desconectado. Esperando ' + ((d && d.graciaSeg) || 30) + 's…'; });
      online.onBatalla('rivalVolvio', () => { $('bt-msg').textContent = 'El rival volvió. ¡Seguimos!'; });
      online.onBatalla('abortado', () => { volverInicio(); lobbyOnline(); loMsg('La sala se cerró (el rival salió).'); });
      online.onBatalla('error', (e) => {
        const map = { 'ya-estas-en-sala': 'Ya estás en una sala.', 'codigo-invalido': 'Código inválido.', 'equipo-invalido': 'Equipo inválido.', 'no-es-tu-turno': 'No es tu turno.', 'super-no-listo': 'El súper no está listo todavía.', 'no-en-combate': 'No estás en combate.' };
        const t = map[e && e.msg] || ('Error: ' + ((e && e.msg) || '?')); loMsg(t); if (!$('bt-combate').hidden) $('bt-msg').textContent = t;
      });
    }

    // ── arranque: elegir modo ──
    $('fin-otra').addEventListener('click', volverInicio);
    document.querySelectorAll('#bt-modo .bt-modo-b').forEach((b) => b.addEventListener('click', () => {
      $('bt-modo').hidden = true;
      if (b.dataset.modo === 'online') lobbyOnline();
      else { $('bt-sel').hidden = false; pintarSeleccion(); }
    }));
  </script>
</Base>
