---
import Base from '../layouts/Base.astro';
import datos from '../data/ejercicios.json';
import { u } from '../lib/url.ts';

const temas = datos.map((w) => ({ slug: w.slug, region: w.region, ejercicios: w.ejercicios.map((e) => ({ id: e.id })) }));
---
<Base title="Batalla — Python con Pokémon" active="Batalla">
  <div class="wrap batalla">
    <div class="safari-head">
      <h1>⚔️ Batalla</h1>
      <a class="navlink" href={u('/pokedex')}>📕 Mi Pokédex</a>
    </div>
    <p>Armá un equipo de hasta <b>3</b> y peleá. En <b>🤖 Práctica</b> es contra una CPU; en <b>🌐 En vivo</b> contra otro entrenador real. Elegís ataques (tipos importan), y cuando se llena la barra desatás el <b>⚡ Súper</b>: un reto de código de tu nivel. 🥊</p>

    <div class="bt-modo" id="bt-modo">
      <button class="bt-modo-b" data-modo="practica"><b>🤖 Práctica</b><small>vs CPU · entrená sin presión</small></button>
      <button class="bt-modo-b" data-modo="online"><b>🌐 En vivo</b><small>vs jugador real · cola, código o amigo</small></button>
    </div>

    <div id="bt-online" hidden></div>
    <div id="bt-sel" hidden></div>
    <div id="bt-combate" hidden>
      <button class="bt-mute" id="bt-mute" type="button" title="Música / sonido">🔊</button>
      <div class="bt-field">
        <div class="bt-arena">
          <img class="bt-sprite bt-sprite-r" id="r-img" src="" alt="rival" />
          <img class="bt-sprite bt-sprite-p" id="p-img" src="" alt="vos" />
        </div>
        <div class="bt-rival">
          <div class="bt-info"><span class="bt-nom" id="r-nom"></span><span class="bt-lv" id="r-lv"></span><span class="bt-estado" id="r-estado"></span></div>
          <div class="bt-hpbar"><div class="bt-hp" id="r-hp"></div></div>
          <div class="bt-row2"><span class="bt-hpnum" id="r-hpnum"></span><span class="bt-tipos" id="r-tipos"></span></div>
          <div class="bt-equipo" id="r-dots"></div>
        </div>
        <div class="bt-yo">
          <div class="bt-info"><span class="bt-nom" id="p-nom"></span><span class="bt-lv" id="p-lv"></span><span class="bt-estado" id="p-estado"></span></div>
          <div class="bt-hpbar"><div class="bt-hp" id="p-hp"></div></div>
          <div class="bt-row2"><span class="bt-hpnum" id="p-hpnum"></span><span class="bt-tipos" id="p-tipos"></span></div>
          <div class="bt-equipo" id="p-dots"></div>
        </div>
      </div>
      <p class="bt-msg" id="bt-msg">¡Que empiece la batalla!</p>
      <div class="bt-carga"><div class="bt-carga-fill" id="bt-carga"></div><span id="bt-carga-txt">Súper: 0%</span></div>
      <div class="bt-timer" id="bt-timer" hidden><span class="bt-timer-txt" id="bt-timer-txt"></span><div class="bt-timer-bar"><i id="bt-timer-bar"></i></div></div>
      <div class="bt-moves" id="bt-moves"></div>
      <div class="bt-banca-wrap"><span class="bt-banca-lbl">Tu equipo <small>(tocá para cambiar)</small></span><div class="bt-banca" id="bt-banca"></div></div>
    </div>
  </div>

  <div class="reto-modal" id="reto-modal" hidden>
    <div class="reto-card">
      <h2>⚡ ¡Súper ataque! Resolvé para potenciarlo</h2>
      <div class="reto-timer"><i id="reto-timer-bar"></i></div>
      <p class="reto-q" id="reto-q"></p>
      <div class="reto-ops" id="reto-ops"></div>
    </div>
  </div>

  <div class="reto-modal" id="mochila-modal" hidden>
    <div class="reto-card mochila-card">
      <button class="rar-x" id="mochila-x" type="button" aria-label="Cerrar">✕</button>
      <h2>🎒 Mochila — usar poción</h2>
      <p class="bt-mochila-nota">Cura a tu Pokémon activo. Usarla <b>gasta tu turno</b>.</p>
      <div class="mochila-lista" id="mochila-lista"></div>
    </div>
  </div>

  <div class="bt-fin" id="bt-fin" hidden>
    <div class="bt-fin-card">
      <h2 id="fin-tit"></h2>
      <p id="fin-msg"></p>
      <button class="btn-tirar" id="fin-otra">Otra batalla</button>
    </div>
  </div>

  <script type="application/json" id="bt-data" set:html={JSON.stringify({ temas })}></script>
  <script>
    import { pc, sincronizar, spriteUrl, regionesDesbloqueadas, darCaramelos, darBalls, items, usarItem } from '../lib/coleccion.js';
    import { ITEMS } from '../lib/items.js';
    import { itemSvg } from '../lib/sprites.js';
    import { combatiente, calcularDano, danoSuper, elegirCPU, equipoCPU, esEstado, aplicarEstado, puedeActuar, aplicarAilment, tickEstado, acierta, tiraCritico, sinPP, FORCEJEO, ESTADOS, habAlEntrar, habAlContacto } from '../lib/batalla.js';
    import { etiquetaEfec } from '../lib/tipos.js';
    import { efectoAtaque } from '../lib/batalla-fx.js';
    import { retoAlAzar } from '../lib/retos-batalla.js';
    import { sonarExito, sonarEpico, musicaBatalla, detenerMusica, toggleSonido, sonidoActivo } from '../lib/sonidos.js';
    import * as online from '../lib/batalla-online.js';
    import { amigos, rankingPvp } from '../lib/social.js';
    import { refrescarDesdeNube } from '../lib/nube.js';

    const D = JSON.parse(document.getElementById('bt-data').textContent);
    sincronizar(D.temas);
    const $ = (id) => document.getElementById(id);
    const esperar = (ms) => new Promise((r) => setTimeout(r, ms));

    // grito (cry) de un Pokémon (PokeAPI, ogg)
    const CRY_BASE = 'https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/';
    function cry(idp, vol = 0.4) { try { const a = new Audio(CRY_BASE + idp + '.ogg'); a.volume = vol; a.play().catch(() => {}); } catch {} }
    // color por tipo (para el destello del ataque)
    const TCOLOR = { Normal: '#9099a1', Fuego: '#ff6b2c', Agua: '#4d90d5', Planta: '#56ad4e', 'Eléctrico': '#e0bd2b', Hielo: '#62c4b6', Lucha: '#ce4069', Veneno: '#a85fc4', Tierra: '#d3793f', Volador: '#8aa6df', 'Psíquico': '#f56a72', Bicho: '#88bb26', Roca: '#b3a576', Fantasma: '#5269ac', 'Dragón': '#0a6dc4', Siniestro: '#585761', Acero: '#5a8ea1', Hada: '#e487dd' };
    // sprites GBA reales (FireRed/LeafGreen) para gen 1-3; el resto usa el sprite por defecto.
    const FRSPR = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/';
    const spriteBatalla = (id, shiny, back) => id <= 386
      ? FRSPR + 'versions/generation-iii/firered-leafgreen/' + (back ? 'back/' : '') + (shiny ? 'shiny/' : '') + id + '.png'
      : FRSPR + (back ? 'back/' : '') + (shiny ? 'shiny/' : '') + id + '.png';
    const chipsTipo = (tipos) => (tipos || []).map((t) => '<span class="bt-tipo" style="background:' + (TCOLOR[t] || '#888') + '">' + t + '</span>').join('');
    function destello(esRival, tipo) {
      const arena = document.querySelector('.bt-arena'); if (!arena) return;
      const fx = document.createElement('div'); fx.className = 'bt-fx';
      fx.style.setProperty('--c', TCOLOR[tipo] || '#fff');
      fx.style.left = esRival ? '70%' : '30%'; fx.style.top = esRival ? '24%' : '68%';
      arena.appendChild(fx); setTimeout(() => fx.remove(), 480);
    }

    let G = null; // estado del combate

    // ── Fase 1: selección de equipo ──
    function pintarSeleccion() {
      const arr = pc();
      if (!arr.length) {
        $('bt-sel').innerHTML = '<p class="bt-vacio">No tenés Pokémon todavía. Andá al <b>Safari</b> a atrapar algunos. 🎒</p>';
        return;
      }
      const cards = [...arr].sort((a, b) => b.nivel - a.nivel).map((m) =>
        '<button class="bt-pick" data-iid="' + m.iid + '"><img src="' + spriteUrl(m.id, m.shiny) + '" alt="" /><span>' + (m.mote || ('Nº ' + m.id)) + '</span><small>Nv. ' + m.nivel + '</small></button>').join('');
      $('bt-sel').innerHTML = '<h2 class="liga-h">Elegí tu equipo <small>(hasta 3)</small></h2><div class="bt-picks">' + cards + '</div>' +
        '<button class="btn-tirar" id="bt-go" disabled>⚔️ ¡Pelear!</button>';
      const sel = new Set();
      $('bt-sel').querySelectorAll('.bt-pick').forEach((b) => b.addEventListener('click', () => {
        const iid = b.dataset.iid;
        if (sel.has(iid)) { sel.delete(iid); b.classList.remove('elegido'); }
        else if (sel.size < 3) { sel.add(iid); b.classList.add('elegido'); }
        $('bt-go').disabled = sel.size === 0;
      }));
      $('bt-go').addEventListener('click', () => empezar([...sel]));
    }

    // ── Fase 2: combate ──
    async function empezar(iids) {
      const arr = pc();
      const equipo = iids.map((iid) => combatiente(arr.find((m) => m.iid === iid)));
      const nivelProm = Math.round(equipo.reduce((a, c) => a + c.nivel, 0) / equipo.length);
      // pool de especies para el rival: las regiones desbloqueadas (1..721 simplificado por starters comunes)
      const pool = poolRival();
      const rival = equipoCPU(pool, Math.min(3, equipo.length), Math.max(2, nivelProm + (Math.random() < 0.5 ? -2 : 2)));
      G = { equipo, rival, pa: 0, ra: 0, carga: 0, lock: false, itemsUsados: 0 };
      $('bt-sel').hidden = true; $('bt-combate').hidden = false; $('bt-fin').hidden = true;
      musicaBatalla();          // 🎵 música de fondo de la pelea
      render(); msg('¡Aparece el rival! Elegí tu ataque.');
      cry(rivAct().id, 0.45); setTimeout(() => cry(miAct().id, 0.4), 550);
      // habilidad AL ENTRAR (Intimidación): ambos activos entran a la vez → cada uno intimida al otro
      G.lock = true; render();
      { const te = habAlEntrar(rivAct(), miAct()); if (te) { msg(te); render(); await esperar(1000); } }
      { const te = habAlEntrar(miAct(), rivAct()); if (te) { msg(te); render(); await esperar(1000); } }
      G.lock = false; render(); armarTimer();
    }
    function poolRival() {
      // especies “salvajes” simples por región desbloqueada (líderes/starters conocidos)
      const reg = regionesDesbloqueadas(D.temas);
      const base = { kanto: [1, 4, 7, 25, 133, 143, 68, 65, 94, 130], johto: [152, 155, 158, 196, 197, 248], hoenn: [252, 255, 258, 282, 373], sinnoh: [387, 390, 393, 448, 445], unova: [495, 498, 501, 530], kalos: [650, 653, 656, 700], alola: [722, 725, 728, 745, 778, 794], galar: [810, 813, 816, 823, 851, 884], paldea: [906, 909, 912, 925, 998, 1000] };
      let pool = [];
      for (const r of Object.keys(base)) if (reg.has(r)) pool = pool.concat(base[r]);
      return pool.length ? pool : base.kanto;
    }

    const miAct = () => G.equipo[G.pa];
    const rivAct = () => G.rival[G.ra];
    const vivos = (t) => t.filter((c) => c.hp > 0).length;

    // ── timeout de turno: si no movés en TURNO_SEG, actúa solo ──
    const TURNO_SEG = 30, RETO_SEG = 15;
    let timerH = null, retoH = null;
    function cancelarTimer() { if (timerH) { clearInterval(timerH); timerH = null; } $('bt-timer').hidden = true; }
    function cancelarRetoTimer() { if (retoH) { clearInterval(retoH); retoH = null; } }
    function armarTimer() {
      cancelarTimer();
      if (!G || G.lock || !$('bt-fin').hidden || vivos(G.equipo) === 0 || vivos(G.rival) === 0) return;
      let seg = TURNO_SEG;
      const cont = $('bt-timer'), txt = $('bt-timer-txt'), bar = $('bt-timer-bar');
      cont.hidden = false;
      const pintarT = () => { txt.textContent = '⏱ ' + seg + 's para mover'; bar.style.width = (seg / TURNO_SEG * 100) + '%'; cont.classList.toggle('urgente', seg <= 5); };
      pintarT();
      timerH = setInterval(() => { seg--; if (seg <= 0) { cancelarTimer(); autoMover(); } else pintarT(); }, 1000);
    }
    function autoMover() {
      if (!G || G.lock) return;
      msg('⏰ ¡Se acabó el tiempo! ' + miAct().nombre + ' actúa por instinto…');
      const ms = miAct().movs;
      turno(ms[Math.floor(Math.random() * ms.length)]);
    }

    function render() {
      const p = miAct(), r = rivAct();
      if (!p || !r) return;   // un equipo quedó eliminado → terminar() maneja la UI
      $('r-nom').textContent = r.nombre; $('r-lv').textContent = 'Nv.' + r.nivel; $('r-tipos').innerHTML = chipsTipo(r.tipos);
      $('p-nom').textContent = p.nombre; $('p-lv').textContent = 'Nv.' + p.nivel; $('p-tipos').innerHTML = chipsTipo(p.tipos);
      $('r-hpnum').textContent = Math.max(0, r.hp) + '/' + r.hpMax; $('p-hpnum').textContent = Math.max(0, p.hp) + '/' + p.hpMax;
      $('r-estado').innerHTML = estadoChip(r); $('p-estado').innerHTML = estadoChip(p);
      // sprites GBA reales (FireRed/LeafGreen) para gen 1-3; fallback al sprite por defecto
      const rImg = $('r-img');
      rImg.onerror = () => { rImg.onerror = null; rImg.src = spriteUrl(r.id, r.shiny); };
      rImg.src = spriteBatalla(r.id, r.shiny, false);
      const pImg = $('p-img');   // jugador DE ESPALDAS
      pImg.onerror = () => { pImg.onerror = () => { pImg.onerror = null; pImg.src = spriteUrl(p.id, p.shiny); };
        pImg.src = 'https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/back/' + (p.shiny ? 'shiny/' : '') + p.id + '.png'; };
      pImg.src = spriteBatalla(p.id, p.shiny, true);
      hp('r-hp', r); hp('p-hp', p);
      dots('r-dots', G.rival); dots('p-dots', G.equipo);
      $('bt-carga').style.width = G.carga + '%'; $('bt-carga-txt').textContent = 'Súper: ' + G.carga + '%';
      const movesHtml = sinPP(p)
        ? '<button class="bt-move" id="bt-forcejeo"' + (G.lock ? ' disabled' : '') + '><b>Forcejeo</b><small>Sin PP · ataque desesperado</small></button>'
        : p.movs.map((mv, i) =>
            '<button class="bt-move" data-i="' + i + '"' + ((G.lock || mv.pp <= 0) ? ' disabled' : '') + '><b>' + mv.nombre + '</b><small>' + mv.tipo + (mv.poder ? ' · ⚔️' + mv.poder : '') + ' · PP ' + mv.pp + '/' + mv.ppMax + '</small></button>').join('');
      $('bt-moves').innerHTML = movesHtml +
        '<button class="bt-move bt-super" id="bt-super"' + (G.carga < 100 || G.lock ? ' disabled' : '') + '>⚡ SÚPER</button>' +
        '<button class="bt-move bt-mochila" id="bt-mochila"' + (G.lock || G.itemsUsados >= 2 ? ' disabled' : '') + '>🎒 Mochila (' + (2 - G.itemsUsados) + ')</button>';
      if (sinPP(p)) { const fb = $('bt-forcejeo'); if (fb) fb.addEventListener('click', () => turno({ ...FORCEJEO, pp: 1, ppMax: 1 })); }
      else $('bt-moves').querySelectorAll('.bt-move[data-i]').forEach((b) => b.addEventListener('click', () => turno(p.movs[+b.dataset.i])));
      $('bt-super').addEventListener('click', abrirReto);
      $('bt-mochila').addEventListener('click', abrirMochila);
      // banca: tu equipo (tocá un suplente vivo para cambiarlo)
      $('bt-banca').innerHTML = G.equipo.map((c, i) => {
        const ko = c.hp <= 0, act = i === G.pa, dis = act || ko || G.lock;
        const hpPct = Math.max(0, Math.round((c.hp / c.hpMax) * 100));
        return '<button class="bt-banca-m' + (act ? ' activo' : '') + (ko ? ' ko' : '') + '" data-sw="' + i + '"' + (dis ? ' disabled' : '') + '>' +
          '<img src="' + spriteUrl(c.id, c.shiny) + '" alt="" /><span class="bm-nom">' + c.nombre + '</span>' +
          '<span class="bm-hp"><i style="width:' + hpPct + '%"></i></span>' +
          '<small>' + (ko ? '💀 Debilitado' : act ? '● En combate' : 'Nv.' + c.nivel) + '</small></button>';
      }).join('');
      $('bt-banca').querySelectorAll('[data-sw]').forEach((b) => b.addEventListener('click', () => cambiar(+b.dataset.sw)));
    }
    // cambiar de Pokémon (manual): usa el turno → el rival ataca después.
    async function cambiar(i) {
      if (G.lock || i === G.pa || G.equipo[i].hp <= 0) return;
      cancelarTimer(); G.lock = true; render();
      G.pa = i; msg('¡Adelante, ' + miAct().nombre + '!'); render(); cry(miAct().id, 0.4);
      await esperar(750);
      { const te = habAlEntrar(miAct(), rivAct()); if (te) { msg(te); render(); await esperar(1000); } }
      await turnoRival();
      if (fin()) return;
      await tick('r');
      if (fin()) return;
      G.lock = false; render(); armarTimer();
    }
    function hp(id, c) {
      const pct = Math.max(0, Math.round((c.hp / c.hpMax) * 100));
      const el = $(id); el.style.width = pct + '%';
      el.className = 'bt-hp' + (pct <= 25 ? ' bajo' : pct <= 50 ? ' medio' : '');
    }
    function dots(id, team) { $(id).innerHTML = team.map((c) => '<span class="bt-dot' + (c.hp <= 0 ? ' ko' : '') + '"></span>').join(''); }
    function msg(t) { $('bt-msg').textContent = t; }

    // usar un movimiento: si es de ESTADO cambia stats; si no, hace daño.
    async function usarMov(at, mov, defLado) {
      const def = defLado === 'p' ? miAct() : rivAct();
      if (esEstado(mov)) {
        const txt = aplicarEstado(mov, at, def);
        msg('¡' + at.nombre + ' usó ' + mov.nombre + '!  ' + txt);
        efectoAtaque(document.querySelector('.bt-arena'), mov, defLado === 'r');   // FX de estado (flechas ↑/↓)
        render(); await esperar(950);
      } else {
        await aplicarGolpe(at, mov, defLado, calcularDano(at, mov, def, Math.random, tiraCritico()));
      }
    }
    async function aplicarGolpe(at, mov, defLado, dmgInfo) {
      const def = defLado === 'p' ? miAct() : rivAct();
      const atImg = defLado === 'p' ? $('r-img') : $('p-img');   // el atacante es el otro lado
      const defImg = defLado === 'p' ? $('p-img') : $('r-img');
      const ef = etiquetaEfec(dmgInfo.efec);
      msg('¡' + at.nombre + ' usó ' + (mov.nombre || 'su ataque') + '!' + (dmgInfo.crit ? '  ¡Golpe crítico! 💥' : '') + (ef ? '  ' + ef : ''));
      // 1) el atacante embiste
      atImg.classList.add('bt-lunge'); await esperar(190); atImg.classList.remove('bt-lunge');
      // 2) impacto: animación de ataque (por movimiento, o por tipo) + shake si pega fuerte
      efectoAtaque(document.querySelector('.bt-arena'), mov, defLado === 'r');
      def.hp = Math.max(0, def.hp - dmgInfo.dmg);
      defImg.classList.add('bt-hit');
      const fuerte = dmgInfo.efec >= 2 || dmgInfo.dmg > def.hpMax * 0.38;
      if (fuerte) document.querySelector('.bt-arena').classList.add('bt-sacude');
      render(); await esperar(200);
      defImg.classList.remove('bt-hit'); document.querySelector('.bt-arena').classList.remove('bt-sacude');
      await esperar(560);
      if (def.hp <= 0) {
        cry(def.id, 0.3); msg(def.nombre + ' se debilitó.');
        defImg.classList.add('bt-faint'); await esperar(650); defImg.classList.remove('bt-faint');
        avanzar(defLado);
        if ((defLado === 'p' ? G.pa : G.ra) < 0) return;   // equipo eliminado → el caller corre fin()
        render(); cry((defLado === 'p' ? miAct() : rivAct()).id, 0.35); await esperar(400);
        // habilidad AL ENTRAR del reemplazo (Intimidación) → intimida al activo rival
        { const nuevo = defLado === 'p' ? miAct() : rivAct(), opo = defLado === 'p' ? rivAct() : miAct();
          const te = habAlEntrar(nuevo, opo); if (te) { msg(te); render(); await esperar(1000); } }
      }
    }
    function avanzar(lado) {
      const team = lado === 'p' ? G.equipo : G.rival;
      const idx = team.findIndex((c) => c.hp > 0);
      if (lado === 'p') G.pa = idx; else G.ra = idx;
    }

    // chip de estado alterado junto al nombre
    const estadoChip = (c) => c.estado && ESTADOS[c.estado]
      ? '<span class="bt-est" style="--e:' + ESTADOS[c.estado].color + '">' + ESTADOS[c.estado].ico + ' ' + ESTADOS[c.estado].sigla + '</span>' : '';

    // una acción de un lado: resuelve estado (sueño/cong/para/confusión), fallo (precisión),
    // el movimiento, y aplica el estado del move al rival.
    async function accion(lado, mov) {
      const at = lado === 'p' ? miAct() : rivAct();
      const defLado = lado === 'p' ? 'r' : 'p';
      const def = lado === 'p' ? rivAct() : miAct();
      const img = lado === 'p' ? $('p-img') : $('r-img');
      const pa = puedeActuar(at);
      if (pa.texto) {
        msg(pa.texto);
        if (pa.autogolpe) { img.classList.add('bt-hit'); }
        render(); await esperar(1000);
        if (pa.autogolpe) { img.classList.remove('bt-hit'); }
      }
      if (!pa.actua) return;                                   // perdió el turno (no gasta PP)
      if (mov.id && mov.pp > 0) mov.pp--;                      // consume PP (Forcejeo id 0 no gasta)
      if (!acierta(mov, Math.random, at)) { msg('¡' + at.nombre + ' usó ' + mov.nombre + '… pero falló!'); render(); await esperar(950); return; }
      await usarMov(at, mov, defLado);
      if (def.hp > 0) { const t = aplicarAilment(mov, at, def); if (t) { msg(t); render(); await esperar(1000); } }
      if (def.hp > 0) { const tc = habAlContacto(def, at, mov, Math.random); if (tc) { msg(tc); render(); await esperar(1000); } }
    }

    // daño por turno (veneno/quemadura) del activo del lado, con su posible debilitamiento.
    async function tick(lado) {
      const c = lado === 'p' ? miAct() : rivAct();
      const tk = tickEstado(c);
      if (!tk.dmg) return;
      const img = lado === 'p' ? $('p-img') : $('r-img');
      msg(tk.texto); img.classList.add('bt-hit'); render(); await esperar(230); img.classList.remove('bt-hit'); await esperar(620);
      if (c.hp <= 0) {
