    async function turno(mov) {
      if (G.lock) return; cancelarTimer(); G.lock = true; render();
      const movR = elegirCPU(rivAct(), miAct());
      // orden por VELOCIDAD (empate: jugador). Guardo los activos del inicio: el que cae este turno
      // no ataca (su reemplazo entra pero no actúa, como en los juegos).
      const pAct0 = miAct(), rAct0 = rivAct();
      const pasos = (pAct0.spe || 0) >= (rAct0.spe || 0)
        ? [['p', mov, pAct0], ['r', movR, rAct0]]
        : [['r', movR, rAct0], ['p', mov, pAct0]];
      for (const [lado, mv, actor] of pasos) {
        if (actor.hp <= 0) continue;       // cayó por el golpe del que fue más rápido → no contraataca
        await accion(lado, mv);
        if (fin()) return;
        await tick(lado);
        if (fin()) return;
      }
      G.carga = Math.min(100, G.carga + 34);
      G.lock = false; render(); armarTimer();
    }
