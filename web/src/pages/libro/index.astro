---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { agrupar } from '../../lib/grupos.mjs';

const caps = (await getCollection('libro')).sort((a, b) => a.data.order - b.data.order);
const grupos = agrupar(caps);
---
<Base title="El libro — Python con Pokémon" active="Libro">
  <div class="wrap">
    <section class="hero-home" style="padding:48px 36px 40px; margin-bottom:28px;">
      <p class="kick">El libro del curso</p>
      <h1>Python con Pokémon</h1>
      <p>Toda la teoría, de Linux a la POO, con ejemplos que podés ejecutar en el navegador.</p>
    </section>

    {grupos.map((g) => (
      <details class="grupo grupo-idx" open>
        <summary>
          <span class="g-ico">{g.icono}</span>{g.nombre}
          <span class="g-count">{g.items.length}</span>
        </summary>
        <div class="cards indice">
          {g.items.map(({ cap, n }) => (
            <a class="card" href={`/libro/${cap.slug}`} style="display:flex; align-items:center; gap:6px;">
              <span class="num">{n}</span>
              <span><h3 style="margin:0;">{cap.data.title}</h3></span>
            </a>
          ))}
        </div>
      </details>
    ))}
  </div>
</Base>
