---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { agrupar } from '../../lib/grupos.mjs';
import { u } from '../../lib/url.ts';

export async function getStaticPaths() {
  const caps = (await getCollection('libro')).sort((a, b) => a.data.order - b.data.order);
  return caps.map((cap, i) => ({
    params: { slug: cap.slug },
    props: { cap, caps, i },
  }));
}

const { cap, caps, i } = Astro.props;
const { Content } = await cap.render();
const prev = caps[i - 1];
const next = caps[i + 1];
const grupos = agrupar(caps);
---
<Base title={cap.data.title + ' — Python con Pokémon'} active="Libro">
  <div class="wrap">
    <div class="book-layout">
      <aside class="book-rail">
        <div class="rail-tit">Capítulos</div>
        {grupos.map((g) => (
          <details class="grupo" open={g.items.some((it) => it.cap.slug === cap.slug)}>
            <summary><span class="g-ico">{g.icono}</span>{g.nombre}</summary>
            {g.items.map(({ cap: c, n }) => (
              <a class={c.slug === cap.slug ? 'activo' : ''} href={u(`/libro/${c.slug}`)}>
                <span class="rn">{n}</span><span>{c.data.title}</span>
              </a>
            ))}
          </details>
        ))}
      </aside>

      <main class="book">
        <h1>{cap.data.title}</h1>
        <Content />
        <nav class="cap-nav">
          {prev
            ? <a href={u(`/libro/${prev.slug}`)}><span class="dir">← Anterior</span><br />{prev.data.title}</a>
            : <a href={u('/libro')}><span class="dir">← Índice</span><br />Todos los capítulos</a>}
          {next
            ? <a class="next" href={u(`/libro/${next.slug}`)}><span class="dir">Siguiente →</span><br />{next.data.title}</a>
            : <a class="next" href={u('/ejercicios')}><span class="dir">Seguir →</span><br />Ir a los Ejercicios</a>}
        </nav>
      </main>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/pyodide/v0.26.4/full/pyodide.js"></script>
  <script>
    // Los bloques python del libro se vuelven editores (CodeMirror) que podés
    // tocar y ejecutar; los bash quedan como ventana de solo lectura.
    import { editorPython } from '../../lib/editor.js';
    import { traducirError } from '../../lib/errores.js';
    import trazadorPy from '../../lib/trazador.py?raw';

    const esc = (s) => String(s == null ? '' : s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
    let pyReady = null;
    async function getPy(out) {
      if (!pyReady) {
        out.innerHTML = '<span class="lbl">SALIDA</span>⏳ Cargando Python (~15s la primera vez)…';
        pyReady = window.loadPyodide();
      }
      return pyReady;
    }
    async function correr(codigo, out, btn) {
      out.classList.add('show');
      out.innerHTML = '<span class="lbl">SALIDA</span>';
      btn.disabled = true;
      try {
        const py = await getPy(out);
        // cargar librerías si el código las usa
        const pkgs = [];
        if (/\bnumpy\b|\bnp\./.test(codigo)) pkgs.push('numpy');
        if (/\bpandas\b|\bpd\./.test(codigo)) pkgs.push('pandas');
        const usaPlot = /\bmatplotlib\b|\bplt\./.test(codigo);
        if (usaPlot) pkgs.push('matplotlib');
        if (/\bimport sqlite3\b|\bsqlite3\./.test(codigo)) pkgs.push('sqlite3');
        if (/\bfrom sklearn\b|\bimport sklearn\b|\bsklearn\./.test(codigo)) pkgs.push('scikit-learn');
        const usaFlask = /\bflask\b|\bFlask\(/.test(codigo);
        if (usaFlask) pkgs.push('micropip');
        if (pkgs.length) { out.innerHTML = '<span class="lbl">SALIDA</span>⏳ cargando librerías…'; await py.loadPackage(pkgs); }
        if (usaFlask) await py.runPythonAsync("import micropip\nawait micropip.install('flask')");
        out.innerHTML = '<span class="lbl">SALIDA</span>';
        py.setStdout({ batched: (s) => out.appendChild(document.createTextNode(s + '\n')) });
        py.setStderr({ batched: (s) => { const e = document.createElement('span'); e.className = 'err'; e.textContent = s + '\n'; out.appendChild(e); } });
        py.setStdin({ stdin: () => { const v = window.prompt('input():'); return v === null ? '' : v; } });
        if (usaPlot) await py.runPythonAsync("import matplotlib; matplotlib.use('AGG')");
        await py.runPythonAsync(codigo);
        if (usaPlot) {
          const b64 = await py.runPythonAsync("import io,base64,matplotlib.pyplot as _p\n_b=''\nif _p.get_fignums():\n    _f=io.BytesIO(); _p.gcf().savefig(_f,format='png',bbox_inches='tight',dpi=110); _p.close('all'); _b=base64.b64encode(_f.getvalue()).decode()\n_b");
          if (b64) { const img = document.createElement('img'); img.className = 'cw-img'; img.src = 'data:image/png;base64,' + b64; out.appendChild(img); }
        }
      } catch (err) {
        const raw = (err && err.message) ? err.message : String(err);
        const t = traducirError(raw);
        if (t) {
          const f = document.createElement('div'); f.className = 'cw-errfix';
          f.innerHTML = t.ico + ' <b>' + esc(t.titulo) + '</b>' + (t.linea ? ' (línea ' + t.linea + ')' : '') + ' — ' + esc(t.causa) + '<br>💡 ' + esc(t.fix);
          out.appendChild(f);
        }
        const e = document.createElement('span'); e.className = 'err';
        e.textContent = '\n' + raw;
        out.appendChild(e);
      } finally {
        btn.disabled = false;
      }
    }

    // ── Visualizador paso a paso ──────────────────────────────────────────────
    let trazadorCargado = false;
    async function visualizar(codigo, fig, btn) {
      btn.disabled = true;
      const previo = fig.querySelector('.cw-viz');
      if (previo) previo.remove();
      const cont = document.createElement('div');
      cont.className = 'cw-viz';
      cont.innerHTML = '<span class="lbl">VISUALIZADOR</span> ⏳ Cargando Python (~15s la primera vez)…';
      fig.appendChild(cont);
      try {
        const py = await getPy(cont);
        if (!trazadorCargado) { await py.runPythonAsync(trazadorPy); trazadorCargado = true; }
        py.globals.set('_cod', codigo);
        const data = JSON.parse(await py.runPythonAsync('trazar(_cod)'));
        renderViz(cont, codigo, data);
      } catch (e) {
        cont.innerHTML = '<span class="lbl">VISUALIZADOR</span><span class="err"> ' + esc((e && e.message) || e) + '</span>';
      } finally {
        btn.disabled = false;
      }
    }

    function renderViz(cont, codigo, data) {
      const lineas = codigo.split('\n');
      const pasos = data.pasos || [];
      if (!pasos.length) { cont.innerHTML = '<span class="lbl">VISUALIZADOR</span> Sin pasos para mostrar.'; return; }
      let i = 0;
      cont.innerHTML = '';
      const head = document.createElement('div'); head.className = 'viz-head';
      const cuerpo = document.createElement('div'); cuerpo.className = 'viz-cuerpo';
      const codeEl = document.createElement('pre'); codeEl.className = 'viz-code';
      const lado = document.createElement('div'); lado.className = 'viz-lado';
      cuerpo.appendChild(codeEl); cuerpo.appendChild(lado);
      cont.appendChild(head); cont.appendChild(cuerpo);

      function pintar() {
        const p = pasos[i];
        head.innerHTML = '';
        const prev = document.createElement('button'); prev.className = 'viz-btn'; prev.textContent = '◀ atrás'; prev.disabled = i === 0;
        const next = document.createElement('button'); next.className = 'viz-btn'; next.textContent = 'siguiente ▶'; next.disabled = i === pasos.length - 1;
        const lbl = document.createElement('span'); lbl.className = 'viz-paso';
        lbl.textContent = '👁️ Paso ' + (i + 1) + '/' + pasos.length + (p.fin ? ' · final' : (p.linea ? ' · línea ' + p.linea : ''));
        const cerrar = document.createElement('button'); cerrar.className = 'viz-btn cerrar'; cerrar.textContent = '✕';
        cerrar.addEventListener('click', () => cont.remove());
        prev.addEventListener('click', () => { if (i > 0) { i--; pintar(); } });
        next.addEventListener('click', () => { if (i < pasos.length - 1) { i++; pintar(); } });
        head.appendChild(prev); head.appendChild(next); head.appendChild(lbl); head.appendChild(cerrar);

        codeEl.innerHTML = lineas.map((ln, idx) =>
          '<span class="viz-ln' + (p.linea === idx + 1 ? ' activa' : '') + '">' + esc(ln === '' ? ' ' : ln) + '</span>').join('\n');

        const vars = p.vars || {};
        const keys = Object.keys(vars);
        let h = '<div class="viz-tit">Variables</div>';
        h += keys.length
          ? '<table class="viz-vars">' + keys.map((k) => '<tr><td class="vn">' + esc(k) + '</td><td class="vv">' + esc(vars[k]) + '</td></tr>').join('') + '</table>'
          : '<div class="viz-vacio">(ninguna todavía)</div>';
        if (p.salida) h += '<div class="viz-tit">Salida</div><pre class="viz-salida">' + esc(p.salida) + '</pre>';
        if (p.error) h += '<div class="viz-errbox">⚠️ ' + esc(p.error) + '</div>';
        if (data.truncado && i === pasos.length - 1) h += '<div class="viz-vacio">(traza cortada a ' + (pasos.length - 1) + ' pasos — código muy largo o bucle grande)</div>';
        lado.innerHTML = h;
      }
      pintar();
    }

    // ── Libro activo: quiz de opción múltiple ─────────────────────────────────
    // Sintaxis en el .md (bloque ```quiz):  P: pregunta / + correcta / - incorrecta / > explicación
    function renderQuiz(pre, texto) {
      let pregunta = '', expl = '';
      const opciones = [];
      for (const ln of texto.split('\n')) {
        const t = ln.trim();
        if (t.startsWith('P:')) pregunta = t.slice(2).trim();
        else if (t.startsWith('+ ')) opciones.push({ txt: t.slice(2).trim(), ok: true });
        else if (t.startsWith('- ')) opciones.push({ txt: t.slice(2).trim(), ok: false });
        else if (t.startsWith('> ')) expl = t.slice(2).trim();
      }
      if (!pregunta || !opciones.length) return;
      const box = document.createElement('div');
      box.className = 'quiz';
      const q = document.createElement('div'); q.className = 'quiz-q'; q.textContent = '🤔 ' + pregunta;
      const opsEl = document.createElement('div'); opsEl.className = 'quiz-ops';
      const explEl = document.createElement('div'); explEl.className = 'quiz-expl'; explEl.hidden = true; explEl.textContent = expl;
      opciones.forEach((op) => {
        const b = document.createElement('button'); b.className = 'quiz-op'; b.type = 'button'; b.textContent = op.txt;
        b.addEventListener('click', () => {
          if (box.classList.contains('resuelto')) return;
          box.classList.add('resuelto');
          Array.from(opsEl.children).forEach((x, idx) => { if (opciones[idx].ok) x.classList.add('correcta'); });
          b.classList.add(op.ok ? 'elegida-ok' : 'elegida-mal');
          if (expl) explEl.hidden = false;
        });
        opsEl.appendChild(b);
      });
      box.appendChild(q); box.appendChild(opsEl); box.appendChild(explEl);
      pre.parentNode.replaceChild(box, pre);
    }

    document.querySelectorAll('.book pre.astro-code').forEach((pre) => {
      const lang = (pre.getAttribute('data-language') || '').toLowerCase();
      const codigo = pre.innerText.replace(/\n+$/, '');
      if (lang === 'quiz') { renderQuiz(pre, codigo); return; }
      const fig = document.createElement('figure');
      fig.className = 'cw';
      const bar = document.createElement('div');
      bar.className = 'cw-bar';
      bar.innerHTML = '<span class="dots"><i></i><i></i><i></i></span><span class="cw-lang">' + (lang || 'code') + '</span>';
      pre.parentNode.insertBefore(fig, pre);
      fig.appendChild(bar);

      if (lang === 'python') {
        const host = document.createElement('div');
        host.className = 'cw-edit';
        fig.appendChild(host);
        pre.remove();
        const view = editorPython({
          doc: codigo,
          parent: host,
          onRun: () => correr(view.state.doc.toString(), out, btn),
        });
        const hint = document.createElement('span');
        hint.className = 'cw-hint'; hint.textContent = '✎ editable';
        bar.appendChild(hint);
        const out = document.createElement('div');
        out.className = 'cw-out';
        out.innerHTML = '<span class="lbl">SALIDA</span>';
        const btn = document.createElement('button');
        btn.className = 'cw-run'; btn.type = 'button'; btn.textContent = '▶ ejecutar';
        btn.addEventListener('click', () => correr(view.state.doc.toString(), out, btn));
        bar.appendChild(btn);
        const vbtn = document.createElement('button');
        vbtn.className = 'cw-run cw-viz-btn'; vbtn.type = 'button'; vbtn.textContent = '👁️ visualizar';
        vbtn.title = 'Ver cómo corre el código paso a paso';
        vbtn.addEventListener('click', () => visualizar(view.state.doc.toString(), fig, vbtn));
        bar.appendChild(vbtn);
        fig.appendChild(out);
      } else {
        fig.appendChild(pre);
      }
    });
  </script>
</Base>
