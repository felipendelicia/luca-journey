---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { agrupar } from '../../lib/grupos.mjs';

export async function getStaticPaths() {
  const caps = (await getCollection('libro')).sort((a, b) => a.data.order - b.data.order);
  return caps.map((cap, i) => ({
    params: { slug: cap.slug },
    props: { cap, caps, i },
  }));
}

const { cap, caps, i } = Astro.props;
const { Content } = await cap.render();
const prev = caps[i - 1];
const next = caps[i + 1];
const grupos = agrupar(caps);
---
<Base title={cap.data.title + ' — Python con Pokémon'} active="Libro">
  <div class="wrap">
    <div class="book-layout">
      <aside class="book-rail">
        <div class="rail-tit">Capítulos</div>
        {grupos.map((g) => (
          <details class="grupo" open={g.items.some((it) => it.cap.slug === cap.slug)}>
            <summary><span class="g-ico">{g.icono}</span>{g.nombre}</summary>
            {g.items.map(({ cap: c, n }) => (
              <a class={c.slug === cap.slug ? 'activo' : ''} href={`/libro/${c.slug}`}>
                <span class="rn">{n}</span><span>{c.data.title}</span>
              </a>
            ))}
          </details>
        ))}
      </aside>

      <main class="book">
        <h1>{cap.data.title}</h1>
        <Content />
        <nav class="cap-nav">
          {prev
            ? <a href={`/libro/${prev.slug}`}><span class="dir">← Anterior</span><br />{prev.data.title}</a>
            : <a href="/libro"><span class="dir">← Índice</span><br />Todos los capítulos</a>}
          {next
            ? <a class="next" href={`/libro/${next.slug}`}><span class="dir">Siguiente →</span><br />{next.data.title}</a>
            : <a class="next" href="/playground"><span class="dir">Seguir →</span><br />Ir al Playground</a>}
        </nav>
      </main>
    </div>
  </div>

  <script is:inline src="https://cdn.jsdelivr.net/pyodide/v0.26.4/full/pyodide.js"></script>
  <script>
    // Los bloques python del libro se vuelven editores (CodeMirror) que podés
    // tocar y ejecutar; los bash quedan como ventana de solo lectura.
    import { EditorView, basicSetup } from 'codemirror';
    import { keymap } from '@codemirror/view';
    import { indentWithTab } from '@codemirror/commands';
    import { python } from '@codemirror/lang-python';
    import { oneDark } from '@codemirror/theme-one-dark';

    let pyReady = null;
    async function getPy(out) {
      if (!pyReady) {
        out.innerHTML = '<span class="lbl">SALIDA</span>⏳ Cargando Python (~15s la primera vez)…';
        pyReady = window.loadPyodide();
      }
      return pyReady;
    }
    async function correr(codigo, out, btn) {
      out.classList.add('show');
      out.innerHTML = '<span class="lbl">SALIDA</span>';
      btn.disabled = true;
      try {
        const py = await getPy(out);
        out.innerHTML = '<span class="lbl">SALIDA</span>';
        py.setStdout({ batched: (s) => out.appendChild(document.createTextNode(s + '\n')) });
        py.setStderr({ batched: (s) => { const e = document.createElement('span'); e.className = 'err'; e.textContent = s + '\n'; out.appendChild(e); } });
        py.setStdin({ stdin: () => { const v = window.prompt('input():'); return v === null ? '' : v; } });
        await py.runPythonAsync(codigo);
      } catch (err) {
        const e = document.createElement('span'); e.className = 'err';
        e.textContent = '\n' + (err && err.message ? err.message : err);
        out.appendChild(e);
      } finally {
        btn.disabled = false;
      }
    }

    document.querySelectorAll('.book pre.astro-code').forEach((pre) => {
      const lang = (pre.getAttribute('data-language') || '').toLowerCase();
      const codigo = pre.innerText.replace(/\n+$/, '');
      const fig = document.createElement('figure');
      fig.className = 'cw';
      const bar = document.createElement('div');
      bar.className = 'cw-bar';
      bar.innerHTML = '<span class="dots"><i></i><i></i><i></i></span><span class="cw-lang">' + (lang || 'code') + '</span>';
      pre.parentNode.insertBefore(fig, pre);
      fig.appendChild(bar);

      if (lang === 'python') {
        const host = document.createElement('div');
        host.className = 'cw-edit';
        fig.appendChild(host);
        pre.remove();
        const view = new EditorView({
          doc: codigo,
          extensions: [basicSetup, keymap.of([indentWithTab]), python(), oneDark],
          parent: host,
        });
        const hint = document.createElement('span');
        hint.className = 'cw-hint'; hint.textContent = '✎ editable';
        bar.appendChild(hint);
        const out = document.createElement('div');
        out.className = 'cw-out';
        out.innerHTML = '<span class="lbl">SALIDA</span>';
        const btn = document.createElement('button');
        btn.className = 'cw-run'; btn.type = 'button'; btn.textContent = '▶ ejecutar';
        btn.addEventListener('click', () => correr(view.state.doc.toString(), out, btn));
        bar.appendChild(btn);
        fig.appendChild(out);
      } else {
        fig.appendChild(pre);
      }
    });
  </script>
</Base>
