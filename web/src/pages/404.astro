---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url.ts';
---
<Base title="Página no encontrada — Python con Pokémon" description="Esta página se escapó a las hierbas altas.">
  <main class="wrap nf-wrap">
    <div class="nf-card">
      <div class="nf-glitch" aria-hidden="true">MissingNo.</div>
      <p class="kick">Error 404</p>
      <h1>¡Se escapó! 🌿</h1>
      <p class="nf-tag">La página que buscás se fue a las hierbas altas… o nunca existió. Pasa hasta a los mejores entrenadores.</p>
      <div class="cta">
        <a class="btn-grande" href={u('/')}>🏠 Volver al inicio</a>
        <a class="btn-grande sec" href={u('/libro')}>📖 El libro</a>
        <a class="btn-grande sec" href={u('/safari')}>🎒 Safari</a>
      </div>
    </div>
  </main>

  <style>
    .nf-wrap { display:flex; align-items:center; justify-content:center; min-height: 62vh; }
    .nf-card { text-align:center; max-width: 560px; position:relative; padding: 20px; }
    .nf-glitch { font:800 clamp(2.2rem, 8vw, 4.5rem) var(--font-pixel, var(--font-display)); letter-spacing:.04em;
      color: transparent; -webkit-text-stroke: 1.5px color-mix(in srgb, var(--red) 60%, var(--ink-mute));
      opacity:.35; margin-bottom: 6px; animation: nf-flick 3.5s steps(2) infinite; }
    @keyframes nf-flick { 0%,92%,100%{ opacity:.35; transform:none; } 93%{ opacity:.12; transform:translateX(2px); } 96%{ opacity:.4; transform:translateX(-2px); } }
    .nf-card h1 { margin: 4px 0 8px; font-size: clamp(1.6rem, 5vw, 2.4rem); }
    .nf-tag { color: var(--ink-soft); max-width: 46ch; margin: 0 auto 18px; }
    .nf-card .cta { justify-content:center; }
    @media (prefers-reduced-motion: reduce) { .nf-glitch { animation: none; } }
  </style>
</Base>
