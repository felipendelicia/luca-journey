---
import Base from '../layouts/Base.astro';
import { u } from '../lib/url.ts';

const features = [
  ['📖', 'El libro', 'Toda la teoría, de Python a la IA. Cada ejemplo de código se puede <strong>editar y ejecutar</strong> ahí mismo, sin instalar nada.', '/libro'],
  ['🏋️', 'Ejercicios', 'Resolvés cada ejercicio y tocás <strong>Corregir</strong>: corro los <strong>tests reales</strong> en tu navegador y te digo qué pasa, ejercicio por ejercicio.', '/ejercicios'],
  ['🏆', 'La Liga', 'Tu progreso se vuelve un juego: <strong>EXP</strong>, <strong>niveles</strong>, <strong>medallas</strong> de gimnasio, <strong>logros</strong> y <strong>racha diaria 🔥</strong>. Completá una región para ser su Campeón y descargar tu <strong>📜 diploma</strong>.', '/liga'],
  ['📕', 'Pokédex', 'Tu colección estilo <strong>Pokémon GO</strong>: cada Pokémon es una instancia con su <strong>nivel</strong>. Subís nivel y evolucionás con <strong>🍬 caramelos</strong>. Tocá uno para ver su modal (rareza, línea evolutiva, ataques, mote, liberar).', '/pokedex'],
  ['🎒', 'Safari', 'Ganás <strong>Pokéballs</strong> resolviendo ejercicios y tirás para atrapar Pokémon salvajes (¡con su <strong>nivel</strong>!), con animación y suspenso.', '/safari'],
  ['⚔️', 'Batalla', 'Armá un equipo y peleá por turnos: contra una <strong>CPU</strong> para practicar, o <strong>en vivo (PvP)</strong> contra otro entrenador con <strong>ranking ELO</strong>. Los <strong>tipos</strong> importan y, cuando se llena la barra, desatás el <strong>⚡ Súper</strong>: un reto de código de tu nivel.', '/batalla'],
  ['🛒', 'Tienda', 'Gastá tus <strong>Pokébolas</strong> en <strong>piedras evolutivas por tipo</strong> (Fuego, Agua, Trueno, Hoja, Lunar, Solar, Día, Alba, Noche) y el <strong>Disco de Enlace</strong> (evos por intercambio), más <strong>pociones</strong> (curar en batalla) y <strong>mejores Pokéballs</strong> (Super/Ultra). Cada Pokémon pide la piedra que le corresponde; la evolución se hace en la <strong>Pokédex</strong>.', '/tienda'],
  ['🧩', 'Desafíos de la comunidad', 'Creá o resolvé retos de Python hechos por otros entrenadores. Ganá Pokéballs, votá los mejores y mirá cómo los resolvieron los demás.', '/desafios'],
  ['🥊', 'Líderes de Gimnasio', 'Mini-proyectos por pasos que se desbloquean al terminar los ejercicios de cada tema. Vencerlos te da la medalla del gimnasio.', '/ejercicios'],
];

const regiones = [
  ['🔴', 'Kanto', 'Fundamentos de Python', 'variables, condicionales, bucles, funciones, listas, POO, módulos'],
  ['⚪', 'Johto', 'Análisis de datos', 'NumPy, pandas y matplotlib: arrays, tablas, gráficos'],
  ['🟢', 'Hoenn', 'APIs con Flask', 'HTTP, JSON, rutas, métodos, una API REST de verdad'],
  ['🔵', 'Sinnoh', 'Bases de datos', 'SQL y SQLite: tablas, consultas, JOIN, desde Python'],
  ['⚫', 'Unova', 'Inteligencia Artificial', 'Machine Learning con scikit-learn: clasificar, predecir, evaluar'],
  ['🟠', 'Kalos', 'Testing y calidad', 'manejo de errores, excepciones, escribir tests, TDD'],
  ['🌺', 'Alola', 'Automatizaciones', 'scripts con argumentos, archivos y rutas (pathlib), procesar en lote, subprocess, entorno, fechas, scraping y un bot'],
  ['🛡️', 'Galar', 'Asincronía y concurrencia', 'async/await, corrutinas, tareas, gather, colas, hilos y límite de concurrencia'],
  ['🔶', 'Paldea', 'Algoritmos y estructuras', 'búsqueda y orden, pila, cola, recursión, grafos, tablas hash y complejidad'],
];
---
<Base title="¿Cómo funciona? — Python con Pokémon" active="">
  <main class="wrap">
      <section class="hero-home" style="padding:52px 40px 44px;">
        <p class="kick">Guía del proyecto</p>
        <h1>¿Cómo funciona?</h1>
        <p>Una plataforma para aprender a programar desde cero, jugando. Todo corre <strong>en tu navegador</strong> — no se instala nada.</p>
        <button class="btn-grande sec" id="ver-tuto" type="button" style="margin-top:14px;">🧭 Ver el tutorial</button>
      </section>
      <script>
        import { iniciarTutorial } from '../lib/tutorial.js';
        document.getElementById('ver-tuto')?.addEventListener('click', () => iniciarTutorial(true));
      </script>

      <h2 class="ayuda-h">✨ Las features</h2>
      <div class="cards">
        {features.map(([ico, t, d, href]) => (
          <a class="card" href={u(href)}>
            <div class="ico">{ico}</div>
            <h3>{t}</h3>
            <p set:html={d}></p>
          </a>
        ))}
      </div>

      <h2 class="ayuda-h">🗺️ El viaje: 9 regiones</h2>
      <p class="ayuda-p">El curso es una aventura por regiones Pokémon. Cada región te enseña un mundo nuevo, con su libro, sus ejercicios y sus 8 medallas de gimnasio.</p>
      <div class="ayuda-regiones">
        {regiones.map(([emoji, nombre, tema, detalle]) => (
          <div class="ay-region">
            <span class="ay-emoji">{emoji}</span>
            <div><b>{nombre}</b> — {tema}<span class="ay-det">{detalle}</span></div>
          </div>
        ))}
      </div>

      <h2 class="ayuda-h">🎒 Cómo coleccionás Pokémon</h2>
      <ol class="ayuda-pasos">
        <li><b>Resolvés ejercicios</b> → ganás <b>Pokéballs</b> (+2 cada uno), <b>ganás batallas</b> (+5) y un <b>regalo cada 20 min</b> (+8).</li>
        <li>Vas al <b>Safari</b> y tirás una Pokéball → atrapás un Pokémon salvaje al azar.</li>
        <li>Hacés ejercicios de una región para <b>desbloquear</b> sus Pokémon.</li>
        <li>Completar un tema te da su Pokémon <b>insignia</b>; completar una región, un <b>legendario</b>.</li>
        <li>1% de los salvajes son <b>shiny ✨</b>. Atrapar repetidos da <b>🍬 caramelos</b> para <b>subir de nivel</b> a tus Pokémon (en el PC) y <b>evolucionarlos</b> por nivel.</li>
      </ol>

      <h2 class="ayuda-h">⚔️ Batalla</h2>
      <p class="ayuda-p">En <a href={u('/batalla')}>Batalla</a> armás un equipo de hasta <strong>3 Pokémon</strong> y peleás por turnos contra un rival CPU. Cada Pokémon usa hasta <strong>4 ataques</strong> (los elegís en el modal de la Pokédex, o usa los más fuertes que tenga). Los <strong>tipos</strong> deciden el daño (agua le gana a fuego, etc.) y el <strong>nivel</strong> sube el HP y la pegada. A medida que atacás se llena una <strong>barra de carga</strong>: al 100% desatás el <strong>⚡ Súper ataque</strong>, que te pide resolver un <strong>reto de código</strong> de un tema que ya viste — si acertás (y rápido), pegás durísimo. Ganar te da <strong>🍬 caramelos</strong>; perder, unas <strong>Pokéballs</strong> de consuelo.</p>

      <h2 class="ayuda-h">🧬 Cada Pokémon es único</h2>
      <p class="ayuda-p">Igual que en los juegos, no hay dos Pokémon iguales. Cuando atrapás uno, queda marcado <strong>de por vida</strong> con su identidad, que ves en el modal de la <a href={u('/pokedex')}>Pokédex</a> (tocá un Pokémon → panel <strong>🧬 Identidad</strong>):</p>
      <ol class="ayuda-pasos">
        <li><b>IVs</b> (genes): un valor fijo de <b>0 a 31</b> en cada stat (PS, Atq, Def, At.Esp, Def.Esp, Vel). Se sortean al capturar y <b>nunca cambian</b>. Cuanto más altos, más fuerte el Pokémon.</li>
        <li><b>Naturaleza</b>: una de 25. Sube un stat <b>+10%</b> y baja otro <b>−10%</b> (algunas son neutras). Marca su "personalidad" de combate.</li>
        <li><b>Género</b> ♂/♀ y <b>Habilidad</b>: lo definen al aparecer. Algunas habilidades tienen efecto real en batalla (ver más abajo); el resto son sabor.</li>
      </ol>

      <h2 class="ayuda-h">⭐ La tasación (el Juez)</h2>
      <p class="ayuda-p">El panel de Identidad te <strong>tasa</strong> al Pokémon de un vistazo, como el Juez de los juegos:</p>
      <ol class="ayuda-pasos">
        <li><b>% de IVs</b>: qué tan cerca está del máximo (todos los IVs en 31 = <b>100%</b>).</li>
        <li><b>Estrellas</b> (de 0 a 4 ★): un resumen del %. 4 estrellas = ≥90%, 3 = ≥75%, 2 = ≥50%, 1 = ≥25%.</li>
        <li><b>Barras por stat</b>: una barra por cada IV, con la frase del <b>Juez</b> al lado — <i>Flojo</i>, <i>Normal</i>, <i>Muy bueno</i>, <i>Fantástico</i> o <b>¡Inmejorable!</b> (cuando el IV es 31, el máximo).</li>
      </ol>

      <h2 class="ayuda-h">💪 EVs: entrenar a tu Pokémon</h2>
      <p class="ayuda-p">Los <strong>EVs</strong> (esfuerzo) son la parte que <strong>sí podés mejorar</strong>: suben los stats con el entrenamiento. Hay dos formas de ganarlos:</p>
      <ol class="ayuda-pasos">
        <li><b>Ganando combates de práctica</b> en <a href={u('/batalla')}>Batalla</a> (vs CPU): el Pokémon activo gana los EVs que "rinde" la especie que derrotó.</li>
        <li><b>Vitaminas</b> de la <a href={u('/tienda')}>Tienda</a>: <b>Proteína</b> (Atq), <b>Hierro</b> (Def), <b>Calcio</b> (At.Esp), <b>Zinc</b> (Def.Esp), <b>Carburo</b> (Vel) y <b>Más PS</b> (PS). Cada una da <b>+10 EV</b> y se usa desde el modal de la Pokédex, con los botones por stat.</li>
      </ol>
      <p class="ayuda-p">Hay topes, igual que en la saga: <strong>252 EV por stat</strong>, <strong>510 EV en total</strong>, y <strong>100 EV por stat</strong> si los ganás con vitaminas (el resto, entrenando en batalla).</p>

      <h2 class="ayuda-h">✨ Habilidades con efecto</h2>
      <p class="ayuda-p">La mayoría de las habilidades son sabor, pero un set elegido <strong>cambia el combate de verdad</strong>:</p>
      <ul class="ayuda-pasos">
        <li><b>Intimidación</b> — al entrar a combate, baja el Ataque del rival.</li>
        <li><b>Levitación</b> — inmune a los movimientos de tipo Tierra.</li>
        <li><b>Robustez</b> — aguanta con 1 PS un golpe letal si tenía los PS al máximo.</li>
        <li><b>Estática</b> — puede paralizar al rival al recibir un golpe de contacto.</li>
        <li><b>Cuerpo Llama</b> — puede quemar al rival al recibir un golpe de contacto.</li>
        <li><b>Espesura / Mar Llamas / Torrente</b> — potencian los movimientos de Planta / Fuego / Agua cuando le quedan pocos PS.</li>
        <li><b>Agallas</b> — sube el Ataque si tiene un estado alterado.</li>
        <li><b>Absorbe Agua</b> / <b>Absorbe Fuego</b> — inmune a los movimientos de Agua / Fuego.</li>
        <li><b>Inmunidad</b> — no puede ser envenenado.</li>
        <li><b>Insomnio</b> — no puede quedarse dormido.</li>
        <li><b>Armadura Magma</b> — no puede ser congelado.</li>
        <li><b>Ojo Compuesto</b> — aumenta la precisión de sus movimientos.</li>
      </ul>

      <h2 class="ayuda-h">💾 Tu progreso</h2>
      <p class="ayuda-p">Todo lo que hacés (ejercicios, medallas, Pokémon) se guarda <strong>en la nube</strong> ligado a tu cuenta de Google. Podés seguir desde cualquier dispositivo. Sin cuenta, la app funciona igual pero el progreso queda solo en este navegador.</p>

      <h2 class="ayuda-h">⚙️ ¿Cómo corre Python en el navegador?</h2>
      <p class="ayuda-p">Usamos <strong>Pyodide</strong>: Python compilado a WebAssembly, que corre dentro de la página. Por eso podés ejecutar código, correr <code>pytest</code>, y usar librerías como NumPy, pandas, Flask, SQLite o scikit-learn <strong>sin instalar absolutamente nada</strong>. La primera ejecución descarga Python (~15s); después es instantáneo.</p>

      <h2 class="ayuda-h">⚔️ Desafíos de la comunidad</h2>
      <p class="ayuda-p">En <a href={u('/desafios')}>Desafíos</a> podés crear tus propios retos de Python o resolver los de otros entrenadores. Cada desafío es una función con casos de prueba: si tu solución pasa todos los tests, ganás <strong>Pokéballs</strong>. Una vez que lo resolvés, podés ver cómo lo resolvieron los demás y aprender de sus enfoques. También podés <strong>votar</strong> los retos que más te gustaron y reportar los que tengan algún problema.</p>
      <ol class="ayuda-pasos">
        <li><b>Resolver</b>: elegís un desafío, escribís tu solución y tocás <strong>Corregir</strong>. Si pasa los tests, gana Pokéballs.</li>
        <li><b>Ver soluciones</b>: después de resolver, podés ver cómo lo hicieron los demás.</li>
        <li><b>Crear</b>: escribís la consigna, la función, los casos de prueba y la publicás. La comunidad la resuelve y la vota.</li>
        <li><b>Categorías</b>: los desafíos están organizados por región (Kanto, Johto, etc.) según el tema que usan.</li>
      </ol>

      <h2 class="ayuda-h">🥊 Líderes de Gimnasio</h2>
      <p class="ayuda-p">Dentro de <a href={u('/ejercicios')}>Ejercicios</a>, al terminar todos los ejercicios de un tema, se desbloquea el <strong>Líder de Gimnasio</strong>: un mini-proyecto por pasos que pone a prueba todo lo que aprendiste en esa sección.</p>
      <ol class="ayuda-pasos">
        <li>Completás los ejercicios del tema → aparece el botón del Líder.</li>
        <li>El proyecto se divide en <b>pasos</b>: cada uno tiene su propia consigna y tests.</li>
        <li>Usás el botón <strong>▶ Ejecutar</strong> para ver los <code>print</code> y el valor de retorno de tu código.</li>
        <li>Al pasar todos los pasos, <b>vencés al Líder</b> y ganás la medalla del gimnasio.</li>
      </ol>

      <div class="ayuda-cta">
        <a class="btn-grande" href={u('/libro')}>📖 Empezar el libro</a>
        <a class="btn-grande sec" href={u('/liga')}>🏆 Ver mi progreso</a>
      </div>
  </main>
</Base>
