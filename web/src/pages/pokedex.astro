---
import Base from '../layouts/Base.astro';
import datos from '../data/ejercicios.json';
import pokemon from '../data/pokemon.json';
import evoluciones from '../data/evoluciones.json';
import aparicion from '../data/aparicion.json';
import estadisticas from '../data/estadisticas.json';
import { u } from '../lib/url.ts';

const temas = datos.map((w) => ({ slug: w.slug, region: w.region, ejercicios: w.ejercicios.map((e) => ({ id: e.id })) }));
const REGIONES = [['kanto', '🔴 Kanto'], ['johto', '⚪ Johto'], ['hoenn', '🟢 Hoenn'], ['sinnoh', '🔵 Sinnoh'], ['unova', '⚫ Unova'], ['kalos', '🟠 Kalos']];
---
<Base title="Pokédex — Python con Pokémon" active="Pokédex">
  <div class="wrap coleccion">
    <header class="dex-hero">
      <div class="dex-scan"></div>
      <div class="dex-hero-row">
        <div class="dex-titlewrap">
          <span class="dex-kicker">▰ Pokédex Codex · registro de campo</span>
          <h1 class="dex-title">Mi Pokédex</h1>
        </div>
        <div class="dex-acciones">
          <a class="navlink" href={u('/safari')}>🎒 Safari</a>
          <a class="navlink" href={u('/batalla')}>⚔️ Batalla</a>
          <a class="navlink" href={u('/tienda')}>🛒 Tienda</a>
          <a class="navlink" href={u('/intercambio')}>🔄 Trade</a>
        </div>
      </div>
      <div class="dex-hud" id="dex-hud"></div>
    </header>

    <div class="col-contadores" id="contadores"></div>
    <input class="dex-buscar" id="buscar" type="search" placeholder="🔍 Buscar por nombre o número…" autocomplete="off" />

    <div class="dex-tabs" id="dex-tabs" role="tablist">
      <button class="dex-tab activo" data-tab="dex" id="tab-dex" type="button" role="tab">📕 Pokédex</button>
      <button class="dex-tab" data-tab="pc" id="tab-pc" type="button" role="tab">🎒 Mi PC</button>
    </div>
    <p class="dex-sinresultados" id="sinres" hidden>Ningún Pokémon coincide.</p>

    <section class="dex-panel" id="panel-dex">
      <div class="dex-filtros" id="filtros">
        <button class="dex-f activo" data-f="todos" type="button">Todos</button>
        <button class="dex-f" data-f="tengo" type="button">✅ Los que tengo</button>
        <button class="dex-f" data-f="falta" type="button">⬜ Me faltan</button>
        <button class="dex-f" data-f="shiny" type="button">✨ Shiny</button>
      </div>
      <div id="secciones"></div>
    </section>
    <section class="dex-panel" id="panel-pc" hidden>
      <div class="pc-orden">
        <span class="pc-orden-lbl">⇅ Ordenar</span>
        <select id="pc-orden" class="pc-select">
          <option value="pokedex">📕 Nº Pokédex</option>
          <option value="nivel">⬆️ Nivel (mayor primero)</option>
          <option value="caramelos">🍬 Caramelos (más primero)</option>
          <option value="recientes">🆕 Recientes</option>
          <option value="nombre">🔤 Nombre / mote (A–Z)</option>
          <option value="shiny">✨ Shiny primero</option>
          <option value="rareza">★ Rareza (más raro primero)</option>
        </select>
      </div>
      <div id="evoluciones-sec"></div>
    </section>
  </div>

  <div class="poke-modal" id="poke-modal" hidden>
    <div class="poke-modal-card">
      <button class="rar-x" id="poke-modal-x" type="button" aria-label="Cerrar">✕</button>
      <div id="poke-modal-cuerpo"></div>
    </div>
  </div>

  <!-- Escena de evolución estilo Pokémon Rojo Fuego: silueta blanca old↔new + haces + destello + reveal -->
  <div class="evo-scene" id="evo-scene" hidden>
    <div class="evo-rays"></div>
    <div class="evo-stars"></div>
    <div class="evo-stage">
      <img class="evo-mon evo-old sil" id="evo-old" src="" alt="" />
      <img class="evo-mon evo-new sil" id="evo-new" src="" alt="" />
      <div class="evo-burst" id="evo-burst"></div>
    </div>
    <p class="evo-text" id="evo-text"></p>
    <button class="evo-done" id="evo-done" hidden>¡Genial! ✨</button>
    <div class="evo-flash" id="evo-flash"></div>
  </div>

  <script type="application/json" id="dex-data" set:html={JSON.stringify({ pokemon, temas, regiones: REGIONES, evoluciones, aparicion, estadisticas })}></script>
  <script>
    import { sincronizar, spriteUrl, pc, caramelos, vistos, subirNivel, opcionesEvo, evolucionarInst, renombrar, liberar, learnsetDe, setMovs, tieneItem, costoSubir, NIVEL_MAX } from '../lib/coleccion.js';
    import { ITEMS } from '../lib/items.js';
    import { itemSvg } from '../lib/sprites.js';
    import { sonarExito, sonarEpico, musicaEvolucion, detenerMusica } from '../lib/sonidos.js';
    import { tierDe } from '../lib/rareza.js';
    import { tiposDe } from '../lib/tipos.js';
    import movimientos from '../data/movimientos.json';

    const D = JSON.parse(document.getElementById('dex-data').textContent);
    sincronizar(D.temas);
    const nombreDe = Object.fromEntries(D.pokemon.map((p) => [p.id, p.nombre]));
    const nomInst = (m) => m.mote || nombreDe[m.id] || ('Nº ' + m.id);
    const apar = D.aparicion || {};
    const famMap = {}; for (const id in D.evoluciones) famMap[id] = D.evoluciones[id].familia;
    const familiaDe = (id) => famMap[id] || Number(id);
    // rareza: badge del tier (color + nombre), derivado del peso de aparición.
    function rarTxt(id) {
      const t = tierDe(id, apar);
      const tasa = (t.rate * 100).toFixed(t.rate < 0.01 ? 2 : 1);
      return '<span class="poke-tier" style="--tier-color:' + t.color + '" title="' + t.nombre + ' · ~' + tasa + '% de aparición">'
        + (t.ico ? t.ico + ' ' : '') + t.nombre + '</span>';
    }
    const $ = (id) => document.getElementById(id);
    const buscar = $('buscar'), sinres = $('sinres');
    let filtro = 'todos';

    // Pokédex = COMPLETITUD (vistos). Mi PC = los que TENÉS (instancias).
    const REG_COLOR = { kanto: '#e0492f', johto: '#caa94e', hoenn: '#56ad4e', sinnoh: '#4d90d5', unova: '#7a7a86', kalos: '#d3793f' };
    function contadores(vis, pcArr) {
      const total = D.pokemon.length, seen = D.pokemon.filter((p) => vis.has(p.id)).length;
      const pct = Math.round((seen / total) * 100), shiny = pcArr.filter((m) => m.shiny).length;
      $('dex-hud').innerHTML =
        '<div class="hud-left"><div class="hud-main"><span class="hud-num">' + seen + '</span><span class="hud-tot">/ ' + total + ' vistos</span></div>' +
        '<div class="hud-bar"><div class="hud-fill" style="width:' + pct + '%"></div><span class="hud-pct">' + pct + '%</span></div></div>' +
        '<div class="hud-stats"><div class="hud-stat"><b>' + pcArr.length + '</b><span>📦 en tu PC</span></div>' +
        '<div class="hud-stat"><b>' + shiny + '</b><span>✨ shiny</span></div>' +
        '<div class="hud-stat"><b>' + (total - seen) + '</b><span>🔍 por hallar</span></div></div>';
      $('contadores').innerHTML = D.regiones.map(([id, label]) => {
        const t = D.pokemon.filter((p) => p.region === id).length;
        const g = D.pokemon.filter((p) => p.region === id && vis.has(p.id)).length;
        const p = Math.round((g / t) * 100);
        return '<div class="cc" style="--rc:' + (REG_COLOR[id] || 'var(--red)') + '"><div class="cc-top"><span class="cc-dot"></span><span class="cc-lbl">' + label.replace(/^\S+\s*/, '') + '</span><b>' + g + '<i>/' + t + '</i></b></div><div class="cc-bar"><div style="width:' + p + '%"></div></div></div>';
      }).join('');
    }

    function grilla(vis, pcArr) {
      const cont = {}, shinyEsp = new Set();
      for (const m of pcArr) { cont[m.id] = (cont[m.id] || 0) + 1; if (m.shiny) shinyEsp.add(m.id); }
      $('secciones').innerHTML = D.regiones.map(([id, label]) => {
        const celdas = D.pokemon.filter((p) => p.region === id).map((p) => {
          const visto = vis.has(p.id), n = cont[p.id] || 0, esShiny = shinyEsp.has(p.id);
          const attrs = 'data-num="' + p.id + '" data-nombre="' + p.nombre.toLowerCase() + '"';
          if (visto) {
            return '<div class="poke tengo' + (esShiny ? ' es-shiny' : '') + '" ' + attrs + ' title="' + p.nombre + '">' +
              '<img loading="lazy" src="' + spriteUrl(p.id, esShiny) + '" alt="' + p.nombre + '" />' + rarTxt(p.id) +
              (esShiny ? '<span class="poke-shiny">✨</span>' : '') + (n > 1 ? '<span class="poke-x">x' + n + '</span>' : '') +
              '<span class="poke-nom">' + p.nombre + '</span></div>';
          }
          return '<div class="poke falta" ' + attrs + ' title="???"><img loading="lazy" src="' + spriteUrl(p.id) + '" alt="?" />' + rarTxt(p.id) + '<span class="poke-nom">Nº ' + p.id + '</span></div>';
        }).join('');
        return '<div class="dex-seccion"><h2 class="liga-h">' + label + '</h2><div class="poke-grid">' + celdas + '</div></div>';
      }).join('');
    }

    // card SIMPLE de una instancia (foto, nombre/mote, nivel, caramelos). Tap → modal con todo.
    function instCard(m, car) {
      const tengo = car[familiaDe(m.id)] || 0;
      const busca = (nomInst(m) + ' ' + (nombreDe[m.id] || '')).toLowerCase();
      return '<button class="pc-card' + (m.shiny ? ' es-shiny' : '') + '" data-iid="' + m.iid + '" data-num="' + m.id + '" data-nombre="' + busca + '">' +
        '<img src="' + spriteUrl(m.id, m.shiny) + '" alt="' + nomInst(m) + '" />' +
        '<div class="pc-nom">' + nomInst(m) + (m.shiny ? ' ✨' : '') + '</div>' +
        '<div class="pc-meta"><span>Nv. ' + m.nivel + '</span><span>🍬 ' + tengo + '</span></div></button>';
    }

    // ordenamientos disponibles para Mi PC
    let ordenPC = 'pokedex';
    function ordenarPC(arr, car) {
      const cmp = {
        pokedex: (a, b) => (a.id - b.id) || (b.nivel - a.nivel),
        nivel: (a, b) => (b.nivel - a.nivel) || (a.id - b.id),
        caramelos: (a, b) => ((car[familiaDe(b.id)] || 0) - (car[familiaDe(a.id)] || 0)) || (a.id - b.id),
        recientes: (a, b) => ((b.creado || 0) - (a.creado || 0)) || (a.id - b.id),
        nombre: (a, b) => nomInst(a).localeCompare(nomInst(b), 'es') || (a.id - b.id),
        shiny: (a, b) => ((b.shiny ? 1 : 0) - (a.shiny ? 1 : 0)) || (a.id - b.id) || (b.nivel - a.nivel),
        rareza: (a, b) => (tierDe(b.id, apar).nivel - tierDe(a.id, apar).nivel) || (a.id - b.id),
      }[ordenPC] || ((a, b) => a.id - b.id);
      return [...arr].sort(cmp);
    }
    // tab "Mi PC": grilla de tus instancias (tap → modal). Vacío = mensaje.
    function miPC(pcArr, car) {
      const sec = $('evoluciones-sec');
      if (!pcArr.length) { sec.innerHTML = '<p class="dex-vacio">Todavía no tenés Pokémon. Andá al <b>Safari</b> a atrapar. 🎒</p>'; return; }
      const cards = ordenarPC(pcArr, car).map((m) => instCard(m, car)).join('');
      sec.innerHTML = '<div class="pc-grid">' + cards + '</div>';
      sec.querySelectorAll('.pc-card').forEach((b) => b.addEventListener('click', () => abrirModal(b.dataset.iid)));
    }

    // modal detallado de UNA instancia: rareza, nivel, caramelos, Power-Up, Evolucionar, árbol, mote, liberar.
    function evoBloque(m, ops) {
      if (!ops.length) return '';
      // un solo botón "Evolucionar" → abre el chooser con TODAS las formas + sus requisitos.
      // Las que podés hacer son tarjetas clickeables; las que necesitan otra piedra/nivel/caramelos
      // salen apagadas con qué falta + link a la Tienda.
      const tarjetas = ops.map((o) => {
        const nom = nombreDe[o.a] || ('Nº ' + o.a);
        const img = '<img src="' + spriteUrl(o.a) + '" alt="' + nom + '" />';
        const bits = [];
        if (o.req) bits.push('<span class="pm-evo-req">' + itemSvg(o.req, 15) + '</span>');
        if (o.nivel > 0) bits.push('Nv.' + o.nivel);
        if (o.costo) bits.push(o.costo + '🍬');
        const reqStr = bits.join(' ');
        if (o.ok) {
          return '<button class="pm-evo-pick" data-evopick="' + o.a + '">' + img + '<b>' + nom + '</b><span class="pm-evo-cost">' + (reqStr || '✓ Listo') + '</span></button>';
        }
        const it = o.req ? ITEMS[o.req] : null;
        const faltaItem = !!o.req && !(tieneItem(o.req) || (o.req.startsWith('piedra') && tieneItem('piedra')));
        const faltaNivel = o.nivel > 0 && m.nivel < o.nivel;
        const motivo = faltaItem ? ('Falta ' + it.nombre) : faltaNivel ? ('Nv.' + o.nivel) : ('Faltan ' + o.costo + '🍬');
        const reqShow = o.req ? '<span class="pm-evo-req">' + itemSvg(o.req, 15) + '</span> ' : '';
        const link = faltaItem ? ' <a class="pm-tienda" href="' + (window.__BASE || '') + '/tienda">→ Tienda</a>' : '';
        return '<div class="pm-evo-locked" title="' + motivo + '">' + img + '<b>' + nom + '</b><span class="pm-evo-cost">🔒 ' + reqShow + motivo + link + '</span></div>';
      }).join('');
      const cuenta = ops.length > 1 ? ' <small>(' + ops.length + ' formas)</small>' : '';
      return '<div class="pm-evo">' +
        '<button class="pm-btn pm-evo-toggle" id="pm-evo-toggle">🧬 Evolucionar' + cuenta + ' <span class="pm-evo-caret">▾</span></button>' +
        '<div class="pm-evo-chooser" id="pm-evo-chooser"><div class="pm-evo-chooser-in">' +
          '<p class="pm-evo-hint">Elegí su evolución — tocá la forma que quieras:</p>' +
          '<div class="pm-evos">' + tarjetas + '</div>' +
        '</div></div>';
    }
    // árbol/línea evolutiva de la familia (resalta la especie actual).
    function arbolEvo(m) {
      const base = familiaDe(m.id);
      const fila = (ids) => '<div class="ev-fila">' + [...new Set(ids)].map((id) =>
        '<div class="ev-nodo' + (id === m.id ? ' ev-actual' : '') + '"><img src="' + spriteUrl(id) + '" alt="' + (nombreDe[id] || id) + '" /><span>' + (nombreDe[id] || ('Nº' + id)) + '</span></div>').join('') + '</div>';
      const n1 = ((D.evoluciones[base] || {}).evos || []).map((e) => e.a);
      const n2 = n1.flatMap((id) => ((D.evoluciones[id] || {}).evos || []).map((e) => e.a));
      let html = fila([base]);
      if (n1.length) html += '<div class="ev-flecha">↓</div>' + fila(n1);
      if (n2.length) html += '<div class="ev-flecha">↓</div>' + fila(n2);
      return '<div class="pm-panel"><div class="pm-h">🧬 Línea evolutiva</div>' + html + '</div>';
    }
    // bloque de ataques: learnset por nivel con STATS + descripción; desbloqueados elegibles (4 activos).
    function movsBloque(m) {
      const activos = new Set(m.movs || []);
      const stats = (mv) => [
        (mv.poder ? '⚔️ ' + mv.poder : (mv.categoria === 'Estado' ? 'Sin daño' : '⚔️ —')),
        (mv.precision != null ? '🎯 ' + mv.precision : '🎯 —'),
        (mv.pp != null ? 'PP ' + mv.pp : ''), (mv.categoria || ''),
      ].filter(Boolean).join('   ');
      const filas = learnsetDe(m.id).map((x) => {
        const mv = movimientos[x.m] || { nombre: 'Mov ' + x.m, tipo: '—' };
        const tag = '<span class="mv-tag" data-t="' + mv.tipo + '">' + mv.tipo + '</span>';
        if (x.n > m.nivel) {
          return '<div class="mv-fila mv-bloq"><div class="mv-top"><span class="mv-nom">🔒 ' + mv.nombre + '</span>' + tag + '<span class="mv-meta">Nv.' + x.n + '</span></div><div class="mv-stats">' + stats(mv) + '</div></div>';
        }
        const act = activos.has(x.m);
        return '<button class="mv-fila mv-ok' + (act ? ' mv-act' : '') + '" data-mv="' + x.m + '"><div class="mv-top"><span class="mv-nom">' + mv.nombre + '</span>' + tag + '</div><div class="mv-stats">' + stats(mv) + '</div>' + (mv.desc ? '<div class="mv-desc">' + mv.desc + '</div>' : '') + '</button>';
      }).join('');
      return '<div class="pm-panel"><div class="pm-h">⚔️ Ataques <small>(' + (m.movs || []).length + '/4 activos)</small></div>' +
        '<p class="pm-soon">Tocá para elegir hasta 4 (de los desbloqueados). Se usan en la batalla.</p>' +
        '<div class="mv-lista">' + filas + '</div></div>';
    }
    // estadísticas base escaladas por nivel (fórmula Pokémon simplificada, sin IV/EV).
    function statsBloque(m) {
      const base = (D.estadisticas || {})[m.id]; if (!base) return '';
      const L = m.nivel;
      const scale = (b, i) => i === 0 ? Math.floor(2 * b * L / 100) + L + 10 : Math.floor(2 * b * L / 100) + 5;  // i0 = PS
      const labels = ['PS', 'Ataque', 'Defensa', 'At. Esp.', 'Def. Esp.', 'Velocidad'];
      const cols = ['#ff5959', '#f5ac78', '#fae078', '#9db7f5', '#a7db8d', '#fa92b2'];   // colores de stat (canon)
      const filas = base.map((b, i) => {
        const v = scale(b, i);
        const pct = Math.max(4, Math.min(100, Math.round(v / 220 * 100)));
        return '<div class="st-fila"><span class="st-lbl">' + labels[i] + '</span><b class="st-val">' + v + '</b><span class="st-bar"><i style="width:' + pct + '%;background:' + cols[i] + '"></i></span></div>';
      }).join('');
      const total = base.reduce((a, b) => a + b, 0);
      return '<div class="pm-panel"><div class="pm-h">📊 Estadísticas <small>(a Nv. ' + L + ')</small></div>' +
        '<div class="st-lista">' + filas + '</div><div class="st-total">Suma base: <b>' + total + '</b> · crecen con el nivel</div></div>';
    }
    function abrirModal(iid) {
      const m = pc().find((x) => x.iid === iid); if (!m) return;
      const car = caramelos()[familiaDe(m.id)] || 0, t = tierDe(m.id, apar), tps = tiposDe(m.id);
      const costo = costoSubir(m.nivel), max = m.nivel >= NIVEL_MAX, ops = opcionesEvo(iid);
      const esp = nombreDe[m.id] || ('Nº ' + m.id);
      $('poke-modal-cuerpo').innerHTML =
        '<div class="pm-screen"><div class="pm-scan"></div>' +
          '<span class="pm-num">Nº ' + String(m.id).padStart(3, '0') + '</span>' +
          (m.shiny ? '<span class="pm-shiny-led">✨</span>' : '') +
          '<div class="pm-platform"><img class="pm-img" src="' + spriteUrl(m.id, m.shiny) + '" alt="' + esp + '" /></div></div>' +
        '<div class="pm-id"><div class="pm-name">' + nomInst(m) + '</div>' +
          (m.mote ? '<div class="pm-esp">(' + esp + ')</div>' : '') +
          '<div class="pm-pills">' + tps.map((tp) => '<span class="pm-type" data-t="' + tp + '">' + tp + '</span>').join('') +
            '<span class="pm-lvlchip">Nv. ' + m.nivel + '</span>' +
            '<span class="cap-tier" style="--tier-color:' + t.color + '">' + (t.ico ? t.ico + ' ' : '') + t.nombre + '</span></div></div>' +
        '<div class="pm-body">' +
          '<div class="pm-candy">🍬 <b>' + car + '</b> caramelos de la familia</div>' +
          '<div class="pm-acciones">' +
            (max ? '<span class="pc-max">Nivel MÁXIMO (50)</span>' : '<button class="pm-btn" id="pm-up"' + (car < costo ? ' disabled' : '') + '>⬆️ Power-Up <small>(' + costo + '🍬)</small></button>') +
            evoBloque(m, ops) + '</div>' +
          statsBloque(m) + arbolEvo(m) + movsBloque(m) +
        '</div>' +
        '<div class="pm-extra">' +
          '<button class="pm-mini" id="pm-mote">✏️ ' + (m.mote ? 'Cambiar mote' : 'Poner mote') + '</button>' +
          '<button class="pm-mini pm-lib" id="pm-lib">🕊️ Liberar <small>(+1🍬)</small></button>' +
        '</div>';
      const card = $('poke-modal').querySelector('.poke-modal-card');
      if (card) { card.style.setProperty('--tier-color', t.color); card.scrollTop = 0; card.style.animation = 'none'; void card.offsetWidth; card.style.animation = ''; }
      const up = $('pm-up'); if (up) up.addEventListener('click', () => { if (subirNivel(iid)) { sonarExito(); abrirModal(iid); pintar(); } });
      const evoT = $('pm-evo-toggle');
      if (evoT) evoT.addEventListener('click', () => {
        const ch = $('pm-evo-chooser'); const abierto = ch.classList.toggle('abierto'); evoT.classList.toggle('abierto', abierto);
        if (abierto) setTimeout(() => ch.scrollIntoView({ block: 'nearest', behavior: 'smooth' }), 60);
      });
      $('poke-modal-cuerpo').querySelectorAll('[data-evopick]').forEach((b) => b.addEventListener('click', () => {
        const inst = pc().find((x) => x.iid === iid); if (!inst) return;
        const targetId = Number(b.dataset.evopick);
        animarEvolucion(iid, inst.id, nomInst(inst), inst.shiny, targetId);
      }));
      $('poke-modal-cuerpo').querySelectorAll('.mv-ok').forEach((b) => b.addEventListener('click', () => {
        const mid = Number(b.dataset.mv), cur = (pc().find((x) => x.iid === iid) || {}).movs || [];
        let next;
        if (cur.includes(mid)) next = cur.filter((x) => x !== mid);
        else if (cur.length < 4) next = [...cur, mid];
        else return;
        setMovs(iid, next); abrirModal(iid);
      }));
      $('pm-mote').addEventListener('click', () => {
        const nv = prompt('Mote para tu ' + esp + ' (vacío = sin mote):', m.mote || '');
        if (nv !== null) { renombrar(iid, nv); abrirModal(iid); pintar(); }
      });
      $('pm-lib').addEventListener('click', () => {
        if (confirm('¿Liberar a ' + nomInst(m) + '? Te da 1 🍬 pero lo perdés para siempre.')) { liberar(iid); sonarExito(); cerrarModal(); pintar(); }
      });
      $('poke-modal').hidden = false;
    }
    function cerrarModal() { $('poke-modal').hidden = true; }

    // ── Animación de evolución estilo Pokémon Rojo Fuego ──
    const CRY_BASE = 'https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/';
    function cry(id, vol = 0.5) { try { const a = new Audio(CRY_BASE + id + '.ogg'); a.volume = vol; a.play().catch(() => {}); } catch {} }
    const dormir = (ms) => new Promise((r) => setTimeout(r, ms));
    let evoEnCurso = false;

    async function animarEvolucion(iid, oldId, oldNom, shiny, newId) {
      if (evoEnCurso) return; evoEnCurso = true;
      const newNom = nombreDe[newId] || ('Nº ' + newId);
      const scene = $('evo-scene'), old = $('evo-old'), nuevo = $('evo-new'), flash = $('evo-flash'), burst = $('evo-burst'), txt = $('evo-text'), done = $('evo-done');
      old.src = spriteUrl(oldId, shiny); nuevo.src = spriteUrl(newId, shiny);
      old.style.opacity = '1'; old.style.transform = 'scale(1)'; old.classList.add('sil');
      nuevo.style.opacity = '0'; nuevo.style.transform = 'scale(.55)'; nuevo.classList.add('sil');
      burst.classList.remove('on'); flash.classList.remove('on'); done.hidden = true;
      txt.textContent = '¿Qué? ¡' + oldNom + ' está evolucionando!';
      scene.hidden = false; scene.classList.remove('reveal');
      cerrarModal();
      musicaEvolucion();                  // tema épico durante toda la secuencia
      await dormir(1500);
      // morfeo: alterna silueta vieja↔nueva, acelerando
      let t = 440; const fin = Date.now() + 3400; let verNuevo = false;
      while (Date.now() < fin) {
        verNuevo = !verNuevo;
        old.style.opacity = verNuevo ? '0' : '1'; old.style.transform = verNuevo ? 'scale(.55)' : 'scale(1)';
        nuevo.style.opacity = verNuevo ? '1' : '0'; nuevo.style.transform = verNuevo ? 'scale(1)' : 'scale(.55)';
        await dormir(t); t = Math.max(70, Math.round(t * 0.82));
      }
      // destello blanco → commit + reveal en color
      flash.classList.add('on'); sonarEpico();
      await dormir(160);
      evolucionarInst(iid, newId);                  // se concreta la evolución (gasta el item)
      old.style.opacity = '0';
      nuevo.classList.remove('sil'); nuevo.style.opacity = '1'; nuevo.style.transform = 'scale(1)';
      scene.classList.add('reveal'); burst.classList.add('on');
      await dormir(120); flash.classList.remove('on');
      cry(newId, 0.6);
      txt.innerHTML = '¡Felicidades! Tu <b>' + oldNom + '</b><br>evolucionó a <b>' + newNom + '</b>! 🎉';
      done.hidden = false;
    }
    function cerrarEvo() { detenerMusica(); $('evo-scene').hidden = true; $('evo-scene').classList.remove('reveal'); evoEnCurso = false; pintar(); }
    $('evo-done').addEventListener('click', cerrarEvo);

    function aplicar() {
      const q = buscar.value.trim().toLowerCase();
      let visDex = 0;
      document.querySelectorAll('.poke').forEach((c) => {
        const txt = !q || c.dataset.num === q || c.dataset.num.startsWith(q) || c.dataset.nombre.includes(q);
        let pasa = true;
        if (filtro === 'tengo') pasa = c.classList.contains('tengo');
        else if (filtro === 'falta') pasa = c.classList.contains('falta');
        else if (filtro === 'shiny') pasa = c.classList.contains('es-shiny');
        const ok = txt && pasa; c.style.display = ok ? '' : 'none'; if (ok) visDex++;
      });
      document.querySelectorAll('.dex-seccion').forEach((s) => {
        const algo = [...s.querySelectorAll('.poke')].some((c) => c.style.display !== 'none'); s.style.display = algo ? '' : 'none';
      });
      let visPc = 0;
      document.querySelectorAll('.pc-card').forEach((c) => {
        const ok = !q || c.dataset.num === q || c.dataset.num.startsWith(q) || (c.dataset.nombre || '').includes(q);
        c.style.display = ok ? '' : 'none'; if (ok) visPc++;
      });
      const enDex = !$('panel-dex').hidden;
      sinres.hidden = !q || (enDex ? visDex : visPc) > 0;
    }

    function pintar() {
      const pcArr = pc(), vis = vistos(), car = caramelos();
      contadores(vis, pcArr);
      grilla(vis, pcArr);
      miPC(pcArr, car);
      const seen = D.pokemon.filter((p) => vis.has(p.id)).length;
      $('tab-dex').innerHTML = '📕 Pokédex <span class="tab-n">' + seen + ' / ' + D.pokemon.length + '</span>';
      $('tab-pc').innerHTML = '🎒 Mi PC <span class="tab-n">' + pcArr.length + '</span>';
      aplicar();
    }

    // tabs Pokédex / Mi PC
    document.querySelectorAll('.dex-tab').forEach((t) => t.addEventListener('click', () => {
      document.querySelectorAll('.dex-tab').forEach((x) => x.classList.remove('activo'));
      t.classList.add('activo');
      const dex = t.dataset.tab === 'dex';
      $('panel-dex').hidden = !dex; $('panel-pc').hidden = dex;
      aplicar();
    }));

    $('pc-orden').addEventListener('change', (e) => { ordenPC = e.target.value; miPC(pc(), caramelos()); aplicar(); });
    buscar.addEventListener('input', aplicar);
    document.querySelectorAll('.dex-f').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('.dex-f').forEach((x) => x.classList.remove('activo'));
      b.classList.add('activo'); filtro = b.dataset.f; aplicar();
    }));

    // cerrar el modal: X, click en el fondo, Escape
    $('poke-modal-x').addEventListener('click', cerrarModal);
    $('poke-modal').addEventListener('click', (e) => { if (e.target === $('poke-modal')) cerrarModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrarModal(); });

    pintar();
    // si la nube cambió por fuera (ej. un intercambio), re-render para no quedar desfasado
    window.addEventListener('nube:sincronizado', pintar);
  </script>
</Base>
