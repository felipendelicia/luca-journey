---
import Base from '../layouts/Base.astro';
import datos from '../data/ejercicios.json';
import pokemon from '../data/pokemon.json';
import evoluciones from '../data/evoluciones.json';
import aparicion from '../data/aparicion.json';
import { u } from '../lib/url.ts';

const temas = datos.map((w) => ({ slug: w.slug, region: w.region, ejercicios: w.ejercicios.map((e) => ({ id: e.id })) }));
const REGIONES = [['kanto', '🔴 Kanto'], ['johto', '⚪ Johto'], ['hoenn', '🟢 Hoenn'], ['sinnoh', '🔵 Sinnoh'], ['unova', '⚫ Unova'], ['kalos', '🟠 Kalos']];
---
<Base title="Pokédex — Python con Pokémon" active="Pokédex">
  <div class="wrap coleccion">
    <div class="safari-head">
      <h1>📕 Mi Pokédex</h1>
      <div class="dex-acciones">
        <a class="navlink" href={u('/safari')}>🎒 Ir al Safari</a>
        <a class="navlink" href={u('/intercambio')}>🔄 Intercambiar</a>
      </div>
    </div>
    <p>Tu colección. Atrapá Pokémon en el <strong>Safari</strong> (con las Pokéballs que ganás resolviendo ejercicios). Sí, podés tener <strong>repetidos</strong>. 😎</p>

    <div class="col-contadores" id="contadores"></div>
    <div class="dex-controles">
      <input class="dex-buscar" id="buscar" type="search" placeholder="🔍 Buscar por nombre o número…" autocomplete="off" />
      <div class="dex-filtros" id="filtros">
        <button class="dex-f activo" data-f="todos" type="button">Todos</button>
        <button class="dex-f" data-f="tengo" type="button">✅ Los que tengo</button>
        <button class="dex-f" data-f="falta" type="button">⬜ Me faltan</button>
        <button class="dex-f" data-f="shiny" type="button">✨ Shiny</button>
      </div>
    </div>
    <p class="dex-sinresultados" id="sinres" hidden>Ningún Pokémon coincide.</p>
    <div id="evoluciones-sec"></div>
    <h2 class="liga-h dex-titulo">📕 Pokédex</h2>
    <div id="secciones"></div>
  </div>

  <div class="poke-modal" id="poke-modal" hidden>
    <div class="poke-modal-card">
      <button class="rar-x" id="poke-modal-x" type="button" aria-label="Cerrar">✕</button>
      <div id="poke-modal-cuerpo"></div>
    </div>
  </div>

  <script type="application/json" id="dex-data" set:html={JSON.stringify({ pokemon, temas, regiones: REGIONES, evoluciones, aparicion })}></script>
  <script>
    import { sincronizar, spriteUrl, pc, caramelos, vistos, subirNivel, opcionesEvo, evolucionarInst, costoSubir, NIVEL_MAX } from '../lib/coleccion.js';
    import { sonarExito } from '../lib/sonidos.js';
    import { tierDe } from '../lib/rareza.js';

    const D = JSON.parse(document.getElementById('dex-data').textContent);
    sincronizar(D.temas);
    const nombreDe = Object.fromEntries(D.pokemon.map((p) => [p.id, p.nombre]));
    const apar = D.aparicion || {};
    const famMap = {}; for (const id in D.evoluciones) famMap[id] = D.evoluciones[id].familia;
    const familiaDe = (id) => famMap[id] || Number(id);
    // rareza: badge del tier (color + nombre), derivado del peso de aparición.
    function rarTxt(id) {
      const t = tierDe(id, apar);
      const tasa = (t.rate * 100).toFixed(t.rate < 0.01 ? 2 : 1);
      return '<span class="poke-tier" style="--tier-color:' + t.color + '" title="' + t.nombre + ' · ~' + tasa + '% de aparición">'
        + (t.ico ? t.ico + ' ' : '') + t.nombre + '</span>';
    }
    const $ = (id) => document.getElementById(id);
    const buscar = $('buscar'), sinres = $('sinres');
    let filtro = 'todos';

    // Pokédex = COMPLETITUD (vistos). Mi PC = los que TENÉS (instancias).
    function contadores(vis, pcArr) {
      let c = D.regiones.map(([id, label]) => {
        const total = D.pokemon.filter((p) => p.region === id).length;
        const tengo = D.pokemon.filter((p) => p.region === id && vis.has(p.id)).length;
        return '<div class="cc"><span>' + label + '</span><b>' + tengo + ' / ' + total + '</b></div>';
      }).join('');
      c += '<div class="cc"><span>✨ Shiny</span><b>' + pcArr.filter((m) => m.shiny).length + '</b></div>';
      $('contadores').innerHTML = c;
    }

    function grilla(vis, pcArr) {
      const cont = {}, shinyEsp = new Set();
      for (const m of pcArr) { cont[m.id] = (cont[m.id] || 0) + 1; if (m.shiny) shinyEsp.add(m.id); }
      $('secciones').innerHTML = D.regiones.map(([id, label]) => {
        const celdas = D.pokemon.filter((p) => p.region === id).map((p) => {
          const visto = vis.has(p.id), n = cont[p.id] || 0, esShiny = shinyEsp.has(p.id);
          const attrs = 'data-num="' + p.id + '" data-nombre="' + p.nombre.toLowerCase() + '"';
          if (visto) {
            return '<div class="poke tengo' + (esShiny ? ' es-shiny' : '') + '" ' + attrs + ' title="' + p.nombre + '">' +
              '<img loading="lazy" src="' + spriteUrl(p.id, esShiny) + '" alt="' + p.nombre + '" />' + rarTxt(p.id) +
              (esShiny ? '<span class="poke-shiny">✨</span>' : '') + (n > 1 ? '<span class="poke-x">x' + n + '</span>' : '') +
              '<span class="poke-nom">' + p.nombre + '</span></div>';
          }
          return '<div class="poke falta" ' + attrs + ' title="???"><img loading="lazy" src="' + spriteUrl(p.id) + '" alt="?" />' + rarTxt(p.id) + '<span class="poke-nom">Nº ' + p.id + '</span></div>';
        }).join('');
        return '<div class="dex-seccion"><h2 class="liga-h">' + label + '</h2><div class="poke-grid">' + celdas + '</div></div>';
      }).join('');
    }

    // card SIMPLE de una instancia (foto, nombre, nivel, caramelos). Tap → modal con todo.
    function instCard(m, car) {
      const tengo = car[familiaDe(m.id)] || 0;
      return '<button class="pc-card' + (m.shiny ? ' es-shiny' : '') + '" data-iid="' + m.iid + '">' +
        '<img src="' + spriteUrl(m.id, m.shiny) + '" alt="' + (nombreDe[m.id] || m.id) + '" />' +
        '<div class="pc-nom">' + (nombreDe[m.id] || ('Nº ' + m.id)) + (m.shiny ? ' ✨' : '') + '</div>' +
        '<div class="pc-meta"><span>Nv. ' + m.nivel + '</span><span>🍬 ' + tengo + '</span></div></button>';
    }

    let pcAbierto = false;   // Mi PC colapsado por defecto (la página no queda larga)
    function miPC(pcArr, car) {
      const sec = $('evoluciones-sec');
      if (!pcArr.length) { sec.innerHTML = ''; return; }
      const cards = [...pcArr].sort((a, b) => (a.id - b.id) || (b.nivel - a.nivel)).map((m) => instCard(m, car)).join('');
      sec.innerHTML = '<button class="pc-toggle" id="pc-toggle"><span class="pc-arrow">' + (pcAbierto ? '▾' : '▸') + '</span> 🎒 Mi PC <small>(' + pcArr.length + ')</small></button>' +
        '<div class="pc-grid" id="pc-cont"' + (pcAbierto ? '' : ' hidden') + '>' + cards + '</div>';
      $('pc-toggle').addEventListener('click', () => {
        pcAbierto = !pcAbierto; $('pc-cont').hidden = !pcAbierto;
        sec.querySelector('.pc-arrow').textContent = pcAbierto ? '▾' : '▸';
      });
      sec.querySelectorAll('.pc-card').forEach((b) => b.addEventListener('click', () => abrirModal(b.dataset.iid)));
    }

    // modal detallado de UNA instancia: rareza, nivel, caramelos, Power-Up y Evolucionar.
    function evoBloque(m, ops) {
      if (!ops.length) return '';
      const oks = ops.filter((o) => o.ok);
      if (oks.length) {
        return '<div class="pm-evo"><b>🧬 Evolucionar a:</b><div class="pm-evos">' +
          oks.map((o) => '<button data-evopick="' + o.a + '"><img src="' + spriteUrl(o.a) + '" alt="' + (nombreDe[o.a] || o.a) + '" /><span>' + (nombreDe[o.a] || ('Nº ' + o.a)) + '<br>' + o.costo + '🍬</span></button>').join('') + '</div></div>';
      }
      const o = ops[0];
      const falta = (o.nivel > 0 && m.nivel < o.nivel) ? ('Nv.' + o.nivel) : (o.costo + '🍬 caramelos');
      return '<div class="pm-evo pm-evo-bloq">🔒 Evoluciona con <b>' + falta + '</b></div>';
    }
    function abrirModal(iid) {
      const m = pc().find((x) => x.iid === iid); if (!m) return;
      const car = caramelos()[familiaDe(m.id)] || 0, t = tierDe(m.id, apar);
      const costo = costoSubir(m.nivel), max = m.nivel >= NIVEL_MAX, ops = opcionesEvo(iid);
      $('poke-modal-cuerpo').innerHTML =
        '<img class="pm-img" src="' + spriteUrl(m.id, m.shiny) + '" alt="' + (nombreDe[m.id] || m.id) + '" />' +
        '<h2>' + (nombreDe[m.id] || ('Nº ' + m.id)) + (m.shiny ? ' ✨' : '') + '</h2>' +
        '<div class="pm-row"><span class="cap-tier" style="--tier-color:' + t.color + '">' + (t.ico ? t.ico + ' ' : '') + t.nombre + '</span><span class="pm-lvl">Nv. ' + m.nivel + '</span></div>' +
        '<div class="pm-car">🍬 ' + car + ' caramelos de la familia</div>' +
        '<div class="pm-acciones">' +
          (max ? '<span class="pc-max">Nivel MÁXIMO (50)</span>' : '<button class="pm-btn" id="pm-up"' + (car < costo ? ' disabled' : '') + '>⬆️ Power-Up <small>(' + costo + '🍬)</small></button>') +
          evoBloque(m, ops) + '</div>';
      const up = $('pm-up'); if (up) up.addEventListener('click', () => { if (subirNivel(iid)) { sonarExito(); abrirModal(iid); pintar(); } });
      $('poke-modal-cuerpo').querySelectorAll('[data-evopick]').forEach((b) => b.addEventListener('click', () => { if (evolucionarInst(iid, b.dataset.evopick)) { sonarExito(); cerrarModal(); pintar(); } }));
      $('poke-modal').hidden = false;
    }
    function cerrarModal() { $('poke-modal').hidden = true; }

    function aplicar() {
      const q = buscar.value.trim().toLowerCase();
      let visibles = 0;
      document.querySelectorAll('.poke').forEach((c) => {
        const txt = !q || c.dataset.num === q || c.dataset.num.startsWith(q) || c.dataset.nombre.includes(q);
        let pasa = true;
        if (filtro === 'tengo') pasa = c.classList.contains('tengo');
        else if (filtro === 'falta') pasa = c.classList.contains('falta');
        else if (filtro === 'shiny') pasa = c.classList.contains('es-shiny');
        const ok = txt && pasa; c.style.display = ok ? '' : 'none'; if (ok) visibles++;
      });
      document.querySelectorAll('.dex-seccion').forEach((s) => {
        const algo = [...s.querySelectorAll('.poke')].some((c) => c.style.display !== 'none'); s.style.display = algo ? '' : 'none';
      });
      sinres.hidden = visibles > 0;
    }

    function pintar() {
      const pcArr = pc(), vis = vistos(), car = caramelos();
      contadores(vis, pcArr);
      grilla(vis, pcArr);
      miPC(pcArr, car);
      aplicar();
    }

    buscar.addEventListener('input', aplicar);
    document.querySelectorAll('.dex-f').forEach((b) => b.addEventListener('click', () => {
      document.querySelectorAll('.dex-f').forEach((x) => x.classList.remove('activo'));
      b.classList.add('activo'); filtro = b.dataset.f; aplicar();
    }));

    // cerrar el modal: X, click en el fondo, Escape
    $('poke-modal-x').addEventListener('click', cerrarModal);
    $('poke-modal').addEventListener('click', (e) => { if (e.target === $('poke-modal')) cerrarModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrarModal(); });

    pintar();
    // si la nube cambió por fuera (ej. un intercambio), re-render para no quedar desfasado
    window.addEventListener('nube:sincronizado', pintar);
  </script>
</Base>
