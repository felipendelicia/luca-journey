---
import Base from '../../../layouts/Base.astro';
import RailEjercicios from '../../../components/RailEjercicios.astro';
import datos from '../../../data/ejercicios.json';
import { u } from '../../../lib/url.ts';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  const paths = [];
  datos.forEach((w) => {
    w.ejercicios.forEach((ex, n) => {
      paths.push({ params: { slug: w.slug, ex: ex.id }, props: { w, ex, n } });
    });
  });
  return paths;
}

const { w, ex, n } = Astro.props;
const prev = w.ejercicios[n - 1];
const next = w.ejercicios[n + 1];
// teoría del tema = capítulo del libro con el MISMO slug (para repasar sin salir del ejercicio).
const cap = (await getCollection('libro')).find((c) => c.slug === w.slug);
const Teoria = cap ? (await cap.render()).Content : null;
const capTitulo = cap ? cap.data.title : w.titulo;
const desc = ex.prompt.split('\n').slice(1).join('\n').trim();
const payload = {
  slug: w.slug, preamble: w.preamble, test: w.test, extra: w.extra,
  packages: w.packages || [],
  exId: ex.id, exTests: ex.tests, starter: ex.starter,
  ejercicios: w.ejercicios.map((e) => ({ id: e.id, starter: e.starter })),
};
---
<Base title={ex.titulo + ' — Ejercicios'} active="Ejercicios">
  <div class="wrap">
    <div class="book-layout">
      <RailEjercicios activeSlug={w.slug} activeEx={ex.id} />

      <main class="book ejer">
        <p class="ej-breadcrumb"><a href={u(`/ejercicios/${w.slug}`)}>{w.titulo}</a> · Ejercicio {n + 1} de {w.ejercicios.length}</p>
        <h1>{ex.titulo}</h1>
        {desc && <p class="ej-prompt">{desc}</p>}

        <div class="ejer-acciones">
          <button class="btn-corregir" id="corregir" type="button" disabled={ex.tests.length === 0}>
            {ex.tests.length ? '✅ Corregir' : 'Sin test automático'}
          </button>
          <button class="btn-sec" id="ejecutar" type="button">▶ Ejecutar</button>
          <button class="btn-sec" id="reset" type="button">↺ Reiniciar</button>
          {Teoria && <button class="btn-sec btn-teoria" id="abrir-teoria" type="button" aria-haspopup="dialog">📖 Teoría</button>}
          <span class="ejer-estado" id="estado"></span>
        </div>

        <div class="cw">
          <div class="cw-bar"><span class="dots"><i></i><i></i><i></i></span><span class="cw-lang">python</span><span class="cw-hint">✎ editable</span></div>
          <div id="editor"></div>
        </div>

        <div class="ejer-result" id="result" role="status" aria-live="polite"></div>

        <nav class="cap-nav">
          {prev
            ? <a href={u(`/ejercicios/${w.slug}/${prev.id}`)}><span class="dir">← Anterior</span><br />{prev.titulo}</a>
            : <a href={u(`/ejercicios/${w.slug}`)}><span class="dir">← Tema</span><br />{w.titulo}</a>}
          {next
            ? <a class="next" href={u(`/ejercicios/${w.slug}/${next.id}`)}><span class="dir">Siguiente →</span><br />{next.titulo}</a>
            : <a class="next" href={u('/ejercicios')}><span class="dir">Fin del tema →</span><br />Todos los temas</a>}
        </nav>
      </main>
    </div>
  </div>

  {Teoria && (
    <div class="teoria-modal" id="teoria-modal" role="dialog" aria-modal="true" aria-label={'Teoría: ' + capTitulo} hidden>
      <div class="teoria-card">
        <header class="teoria-head">
          <div class="teoria-head-txt">
            <span class="teoria-kicker">📖 Teoría · repasá sin salir</span>
            <h2 class="teoria-title">{capTitulo}</h2>
          </div>
          <button class="teoria-x" id="teoria-x" type="button" aria-label="Cerrar y volver al ejercicio">✕</button>
        </header>
        <nav class="teoria-toc" id="teoria-toc" aria-label="Secciones del capítulo"></nav>
        <div class="teoria-cont book" id="teoria-cont">
          <Teoria />
        </div>
        <footer class="teoria-foot">
          <a href={u(`/libro/${w.slug}`)} target="_blank" rel="noopener">Ver capítulo completo en el Libro ↗</a>
          <span class="teoria-hint">Esc / ✕ para volver al ejercicio</span>
        </footer>
      </div>
    </div>
  )}

  <script type="application/json" id="ej-data" set:html={JSON.stringify(payload)}></script>

  <script>
    import { editorPython } from '../../../lib/editor.js';
    import runnerPy from '../../../lib/runner.py?raw';
    import { sonarExito, sonarError } from '../../../lib/sonidos.js';
    import { crearRunnerPytest } from '../../../lib/runner-py.js';   // runner unificado (worker + timeout)
    import { bloqueError, listaTests, salidaEjecutar } from '../../../lib/correr-ui.js';   // render compartido

    const data = JSON.parse(document.getElementById('ej-data').textContent);
    const KEY = (id) => 'ej:' + data.slug + ':' + id;
    const estado = (t) => { document.getElementById('estado').textContent = t; };
    const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));

    let guardar;
    const editor = editorPython({
      doc: localStorage.getItem(KEY(data.exId)) ?? data.starter,
      parent: document.getElementById('editor'),
      onRun: () => { if (data.exTests.length) corregir(); },
      onChange: (texto) => { clearTimeout(guardar); guardar = setTimeout(() => localStorage.setItem(KEY(data.exId), texto), 500); },
    });

    function moduloCompleto() {
      const partes = [data.preamble];
      for (const e of data.ejercicios) {
        partes.push(e.id === data.exId ? editor.state.doc.toString() : (localStorage.getItem(KEY(e.id)) ?? e.starter));
      }
      return partes.join('\n\n\n');
    }

    // Runner unificado (worker + timeout). Mismo motor que proyectos.
    const R = crearRunnerPytest(runnerPy, data.packages);

    function render(tests, carga) {
      const box = document.getElementById('result');
      if (carga) { box.innerHTML = bloqueError(carga); sonarError(); return; }
      const tot = tests.length, ok = tests.filter((t) => t.ok).length, todo = tot > 0 && ok === tot;
      if (todo) sonarExito(); else sonarError();
      if (todo) localStorage.setItem(KEY(data.exId) + ':ok', '1');   // sticky: una vez resuelto, queda resuelto (un error posterior no lo desmarca)
      const resumen = '<div class="ejer-resumen ' + (todo ? 'win' : '') + '">' + ok + ' / ' + tot + ' tests' + (todo ? ' · +' + (ok * 10) + ' EXP · ¡COMPLETO! 🏅' : '') + '</div>';
      box.innerHTML = resumen + listaTests(tests);
    }

    async function corregir() {
      const b = document.getElementById('corregir');
      b.disabled = true; estado('Corrigiendo…');
      try {
        const out = await R.correr(data.slug, moduloCompleto(), data.test, JSON.stringify(data.extra || {}), JSON.stringify(data.exTests));
        const res = JSON.parse(out);
        const byName = {}; res.tests.forEach((t) => (byName[t.name] = t));
        render(data.exTests.map((nm) => byName[nm]).filter(Boolean), res.carga_error);
      } catch (e) { render([], (e && e.message) || String(e)); }
      finally { b.disabled = false; estado(''); }
    }

    async function ejecutar() {
      const b = document.getElementById('ejecutar');
      b.disabled = true; estado('Ejecutando…');
      const box = document.getElementById('result');
      box.innerHTML = '';
      try {
        const res = JSON.parse(await R.ejecutar(data.preamble + '\n\n' + editor.state.doc.toString()));
        box.innerHTML = salidaEjecutar(res);
      } catch (e) {
        box.innerHTML = '<div class="ejer-err">⚠️ ' + esc((e && e.message) || e) + '</div>';
      } finally { b.disabled = false; estado(''); }
    }
    document.getElementById('ejecutar').addEventListener('click', ejecutar);

    if (data.exTests.length) document.getElementById('corregir').addEventListener('click', corregir);
    document.getElementById('reset').addEventListener('click', () => {
      if (!confirm('¿Volver al código original de este ejercicio?')) return;
      editor.dispatch({ changes: { from: 0, to: editor.state.doc.length, insert: data.starter } });
      localStorage.removeItem(KEY(data.exId)); localStorage.removeItem(KEY(data.exId) + ':ok');
      document.getElementById('result').innerHTML = '';
    });

    // precalentar el worker en segundo plano: cuando aprietes Corregir/▶ ya está listo (sin esperar ~15s)
    (window.requestIdleCallback || ((f) => setTimeout(f, 1800)))(() => { R.asegurar().catch(() => {}); });
  </script>

  <script>
    // 📖 Teoría: abre el capítulo del libro en una modal SOBRE el ejercicio (no navega → el código no se pierde).
    (function () {
      const modal = document.getElementById('teoria-modal');
      const btn = document.getElementById('abrir-teoria');
      if (!modal || !btn) return;
      const cont = document.getElementById('teoria-cont');
      const toc = document.getElementById('teoria-toc');
      const xBtn = document.getElementById('teoria-x');
      let prevFoco = null, armado = false;

      function armar() {
        if (armado) return; armado = true;
        // ocultar quizzes (son práctica, no teoría): bloques de código 'quiz' o que arrancan con "P:"
        cont.querySelectorAll('pre.astro-code').forEach((pre) => {
          const lang = (pre.getAttribute('data-language') || '').toLowerCase();
          if (lang === 'quiz' || /^\s*P:\s/.test(pre.textContent || '')) (pre.closest('figure') || pre).style.display = 'none';
        });
        // mini-índice: saltos a los h2/h3 del capítulo
        const hs = cont.querySelectorAll('h2, h3');
        if (!hs.length) { toc.hidden = true; return; }
        hs.forEach((h, i) => {
          if (!h.id) h.id = 'teo-' + i;
          const a = document.createElement('a');
          a.href = '#' + h.id; a.className = 'teoria-toc-link' + (h.tagName === 'H3' ? ' sub' : '');
          a.textContent = h.textContent;
          a.addEventListener('click', (e) => { e.preventDefault(); h.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
          toc.appendChild(a);
        });
      }
      function abrir() { armar(); prevFoco = document.activeElement; modal.hidden = false; document.body.classList.add('modal-abierto'); cont.scrollTop = 0; xBtn.focus(); }
      function cerrar() { modal.hidden = true; document.body.classList.remove('modal-abierto'); if (prevFoco && prevFoco.focus) prevFoco.focus(); }

      btn.addEventListener('click', abrir);
      xBtn.addEventListener('click', cerrar);
      modal.addEventListener('click', (e) => { if (e.target === modal) cerrar(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) cerrar(); });
    })();
  </script>
</Base>
