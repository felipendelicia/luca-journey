---
import Base from '../../layouts/Base.astro';
import datos from '../../data/ejercicios.json';
import { u } from '../../lib/url.ts';

const REGIONES = [
  ['kanto', '🔴 Kanto · Fundamentos de Python'],
  ['johto', '⚪ Johto · Análisis de datos'],
  ['hoenn', '🟢 Hoenn · APIs con Flask'],
  ['sinnoh', '🔵 Sinnoh · Bases de datos'],
  ['unova', '⚫ Unova · Inteligencia Artificial'],
  ['kalos', '🟠 Kalos · Testing y calidad'],
];
let n = 0;
const grupos = REGIONES.map(([id, label]) => ({
  id, label,
  temas: datos.filter((w) => (w.region || 'kanto') === id).map((it) => ({
    slug: it.slug, titulo: it.titulo, n: ++n,
    total: it.ejercicios.length,
    ids: it.ejercicios.map((e) => e.id).join(','),
  })),
})).filter((g) => g.temas.length);
---
<Base title="Ejercicios — Python con Pokémon" active="Ejercicios">
  <div class="wrap">
    <section class="hero-home" style="padding:48px 36px 40px; margin-bottom:26px;">
      <p class="kick">Practicá en el navegador</p>
      <h1>Ejercicios</h1>
      <p>Resolvé los ejercicios de cada tema y corregilos al instante: corro los tests reales con Python en tu navegador. ⚡</p>
    </section>

    <div id="grid">
      {grupos.map((g) => (
        <details class="grupo grupo-idx" open>
          <summary>{g.label}<span class="g-count">{g.temas.length}</span></summary>
          <div class="cards indice">
            {g.temas.map((s) => (
              <a class="card" href={u(`/ejercicios/${s.slug}`)} data-slug={s.slug} data-total={s.total} data-ids={s.ids} style="display:flex; align-items:center; gap:8px;">
                <span class="num">{s.n}</span>
                <span>
                  <h3 style="margin:0; font-size:.98rem;">{s.titulo}</h3>
                  <p class="ej-prog">{s.total} ejercicios</p>
                </span>
              </a>
            ))}
          </div>
        </details>
      ))}
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('#grid .card').forEach((c) => {
      const slug = c.dataset.slug, total = +c.dataset.total;
      const ids = (c.dataset.ids || '').split(',').filter(Boolean);
      const done = ids.filter((id) => localStorage.getItem('ej:' + slug + ':' + id + ':ok') === '1').length;
      if (done > 0) {
        const p = c.querySelector('.ej-prog');
        p.textContent = done + ' / ' + total + ' ejercicios' + (done === total ? ' ✅' : '');
        if (done === total) c.classList.add('done');
      }
    });
  </script>
</Base>
