---
import Base from '../../layouts/Base.astro';
import datos from '../../data/ejercicios.json';
import proyectos from '../../data/proyectos.json';
import { u } from '../../lib/url.ts';

const REGIONES = [
  ['kanto', '🔴 Kanto · Fundamentos de Python'],
  ['johto', '⚪ Johto · Análisis de datos'],
  ['hoenn', '🟢 Hoenn · APIs con Flask'],
  ['sinnoh', '🔵 Sinnoh · Bases de datos'],
  ['unova', '⚫ Unova · Inteligencia Artificial'],
  ['kalos', '🟠 Kalos · Testing y calidad'],
];
let n = 0;
const grupos = REGIONES.map(([id, label]) => ({
  id, label,
  temas: datos.filter((w) => (w.region || 'kanto') === id).map((it) => ({
    slug: it.slug, titulo: it.titulo, n: ++n,
    total: it.ejercicios.length,
    ids: it.ejercicios.map((e) => e.id).join(','),
  })),
})).filter((g) => g.temas.length);

// Líderes por tema (tipo=lider) e integradores por región (tipo=integrador)
const lideresPorTema = Object.fromEntries(
  Object.values(proyectos).filter((p) => p.tipo === 'lider' && p.tema).map((p) => [p.tema, p])
);
const integradoresPorRegion = Object.fromEntries(
  Object.values(proyectos).filter((p) => p.tipo === 'integrador' && p.region).map((p) => [p.region, p])
);

const BASE = import.meta.env.BASE_URL || '/';
---
<Base title="Ejercicios — Python con Pokémon" active="Ejercicios">
  <div class="wrap">
    <section class="hero-home" style="padding:48px 36px 40px; margin-bottom:26px;">
      <p class="kick">Practicá en el navegador</p>
      <h1>Ejercicios</h1>
      <p>Resolvé los ejercicios de cada tema y corregilos al instante: corro los tests reales con Python en tu navegador. ⚡</p>
    </section>

    <div id="grid">
      {grupos.map((g) => (
        <details class="grupo grupo-idx" open>
          <summary>{g.label}<span class="g-count">{g.temas.length}</span></summary>
          <div class="cards indice">
            {g.temas.map((s) => (
              <>
                <a class="card" href={u(`/ejercicios/${s.slug}`)} data-slug={s.slug} data-total={s.total} data-ids={s.ids} style="display:flex; align-items:center; gap:8px;">
                  <span class="num">{s.n}</span>
                  <span>
                    <h3 style="margin:0; font-size:.98rem;">{s.titulo}</h3>
                    <p class="ej-prog">{s.total} ejercicios</p>
                  </span>
                </a>
                {lideresPorTema[s.slug] && (
                  <div
                    class="lider-card bloq"
                    id={'lider-' + lideresPorTema[s.slug].slug}
                    data-lider-slug={lideresPorTema[s.slug].slug}
                    data-lider-tema={s.slug}
                    data-lider-ids={s.ids}
                    data-lider-total={s.total}
                    data-lider-href={u('/proyectos/' + lideresPorTema[s.slug].slug)}
                  >
                    <span class="lc-ico">🏟️</span>
                    <span>
                      <div class="lc-tit">Líder de Gimnasio: {lideresPorTema[s.slug].lider}</div>
                      <div class="lc-sub" id={'lider-sub-' + lideresPorTema[s.slug].slug}>Completá los ejercicios del tema para desafiar al líder</div>
                    </span>
                    <span class="lc-estado" id={'lider-est-' + lideresPorTema[s.slug].slug}></span>
                  </div>
                )}
              </>
            ))}
            {integradoresPorRegion[g.id] && (
              <div
                class="lider-card bloq"
                id={'lider-' + integradoresPorRegion[g.id].slug}
                data-integrador-slug={integradoresPorRegion[g.id].slug}
                data-integrador-region={g.id}
                data-integrador-href={u('/proyectos/' + integradoresPorRegion[g.id].slug)}
              >
                <span class="lc-ico">👑</span>
                <span>
                  <div class="lc-tit">Integrador: {integradoresPorRegion[g.id].titulo}</div>
                  <div class="lc-sub" id={'lider-sub-' + integradoresPorRegion[g.id].slug}>Vencé a todos los líderes de la región para desbloquear</div>
                </span>
                <span class="lc-estado" id={'lider-est-' + integradoresPorRegion[g.id].slug}></span>
              </div>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>

  <script is:inline>
    (function () {
      // Progreso de ejercicios en las cards normales
      document.querySelectorAll('#grid .card').forEach((c) => {
        const slug = c.dataset.slug, total = +c.dataset.total;
        const ids = (c.dataset.ids || '').split(',').filter(Boolean);
        const done = ids.filter((id) => localStorage.getItem('ej:' + slug + ':' + id + ':ok') === '1').length;
        if (done > 0) {
          const p = c.querySelector('.ej-prog');
          p.textContent = done + ' / ' + total + ' ejercicios' + (done === total ? ' ✅' : '');
          if (done === total) c.classList.add('done');
        }
      });

      // Cards de líderes por tema
      document.querySelectorAll('[data-lider-slug]').forEach((card) => {
        const slug = card.dataset.liderSlug;
        const tema = card.dataset.liderTema;
        const ids = (card.dataset.liderIds || '').split(',').filter(Boolean);
        const total = +card.dataset.liderTotal;
        const href = card.dataset.liderHref;
        const done = ids.filter((id) => localStorage.getItem('ej:' + tema + ':' + id + ':ok') === '1').length;
        const desbloqueado = total > 0 && done === total;
        const ganado = localStorage.getItem('proy:' + slug + ':ok') === '1';
        const sub = document.getElementById('lider-sub-' + slug);
        const est = document.getElementById('lider-est-' + slug);
        // siempre clickeable: SE PUEDE LEER aunque no esté desbloqueado para completar
        card.style.cursor = 'pointer';
        card.addEventListener('click', () => { window.location.href = href; });
        if (desbloqueado) {
          card.classList.remove('bloq');
          if (sub) sub.textContent = ganado ? '¡Líder vencido!' : 'Hacé clic para desafiarlo';
          if (est) est.textContent = ganado ? '🏅' : '→';
        } else {
          if (sub) sub.textContent = done + '/' + total + ' ejercicios — 📖 leelo ahora (completá el tema para vencerlo)';
          if (est) est.textContent = '📖';
        }
      });

      // Cards de integradores por región
      document.querySelectorAll('[data-integrador-slug]').forEach((card) => {
        const slug = card.dataset.integradorSlug;
        const region = card.dataset.integradorRegion;
        const href = card.dataset.integradorHref;
        const sub = document.getElementById('lider-sub-' + slug);
        const est = document.getElementById('lider-est-' + slug);
        const ganado = localStorage.getItem('proy:' + slug + ':ok') === '1';
        // Desbloqueado cuando todos los líderes de la región están vencidos
        // (buscamos todas las lider-cards de esta región)
        const lideresDeLaRegion = document.querySelectorAll('[data-lider-slug]');
        // Filtramos los que pertenecen a temas de esta región: no tenemos esa info aquí directamente,
        // así que comprobamos si todos están ganados revisando los slugs de líderes con :ok
        // En Fase 1 no hay integradores, así que esta lógica no se activa — dejamos bloqueada
        // a menos que ganado === true
        // siempre clickeable: se puede leer
        card.style.cursor = 'pointer';
        card.addEventListener('click', () => { window.location.href = href; });
        if (ganado) {
          card.classList.remove('bloq');
          if (sub) sub.textContent = '¡Completado!';
          if (est) est.textContent = '👑';
        } else {
          if (sub) sub.textContent = '📖 Leelo ahora (vencé a todos los líderes de la región para completarlo)';
          if (est) est.textContent = '📖';
        }
      });
    })();
  </script>
</Base>
