---
import '../styles/global.css';
import { u } from '../lib/url.ts';
const { title = 'Python con Pokémon', active = '' } = Astro.props;
const nav = [
  ['Inicio', '/'],
  ['Libro', '/libro'],
  ['Ejercicios', '/ejercicios'],
  ['Liga', '/liga'],
  ['Pokédex', '/pokedex'],
  ['Playground', '/playground'],
];
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Silkscreen:wght@400;700&display=swap" />
</head>
<body>
  <div class="bg-grid" aria-hidden="true"></div>
  <header class="topbar">
    <a class="brand-link" href={u('/')}><span class="pb"></span><span class="brand">Pokédex <b>Codex</b></span></a>
    <div class="tools">
      {nav.map(([t, h]) => (
        <a class={'navlink' + (t === active ? ' activo' : '')} href={u(h)}>{t}</a>
      ))}
      <button class="theme-toggle" id="nube-btn" type="button" title="Guardar progreso en la nube" style="display:none">☁️</button>
      <button class="theme-toggle" id="sonido-toggle" type="button" title="Sonido on/off">🔊</button>
      <button class="theme-toggle" id="theme-toggle" type="button" title="Tema claro/oscuro">🌙</button>
    </div>
  </header>

  <div class="auth-modal" id="auth-modal" hidden>
    <div class="auth-card">
      <button class="auth-x" id="auth-x" type="button" aria-label="Cerrar">✕</button>
      <div class="auth-logo">☁️</div>
      <div class="auth-pane" id="auth-out">
        <h2>Guardá tu progreso</h2>
        <p>Entrá con tu email y llevá tu progreso —ejercicios, medallas y Pokémon— a cualquier dispositivo. Sin contraseña: te mandamos un <b>link mágico</b>. ✨</p>
        <form id="auth-form" novalidate>
          <input type="email" id="auth-email" placeholder="tu@email.com" autocomplete="email" required />
          <button type="submit" class="btn-grande" id="auth-send">Enviar link mágico</button>
        </form>
        <p class="auth-msg err" id="auth-err" hidden></p>
      </div>
      <div class="auth-pane" id="auth-sent" hidden>
        <h2>📩 ¡Revisá tu email!</h2>
        <p>Te enviamos un link a <b id="auth-sent-email"></b>. Tocalo desde este dispositivo para entrar.</p>
        <p class="auth-fine">¿No llega? Mirá el spam o probá de nuevo en un minuto.</p>
      </div>
      <div class="auth-pane" id="auth-in" hidden>
        <h2>✅ Sesión iniciada</h2>
        <p>Entraste como <b id="auth-in-email"></b>. Tu progreso se <b>sincroniza solo</b>. 🔄</p>
        <button class="btn-grande sec" id="auth-logout" type="button">Cerrar sesión</button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>window.__BASE = base;</script>

  <script>
    import { init, usuario, loginEmail, logout } from '../lib/nube.js';
    import { haySupabase } from '../lib/supa.js';
    const btn = document.getElementById('nube-btn');
    const modal = document.getElementById('auth-modal');
    if (haySupabase && btn && modal) {
      btn.style.display = '';
      init();
      const $ = (id) => document.getElementById(id);
      const panes = { out: $('auth-out'), sent: $('auth-sent'), in: $('auth-in') };
      const mostrar = (cual) => { for (const k in panes) panes[k].hidden = k !== cual; };

      const pintarBtn = () => {
        const u = usuario();
        btn.textContent = u ? '✅' : '☁️';
        btn.title = u ? `Sesión: ${u.email || ''}` : 'Iniciar sesión y guardar progreso';
      };
      const cerrar = () => { modal.hidden = true; };
      const abrir = () => {
        const u = usuario();
        if (u) { $('auth-in-email').textContent = u.email || ''; mostrar('in'); }
        else { $('auth-err').hidden = true; mostrar('out'); }
        modal.hidden = false;
        if (!u) setTimeout(() => $('auth-email').focus(), 60);
      };

      pintarBtn();
      window.addEventListener('nube:cambio', () => {
        pintarBtn();
        if (!modal.hidden && usuario()) { $('auth-in-email').textContent = usuario().email || ''; mostrar('in'); }
      });

      btn.addEventListener('click', abrir);
      $('auth-x').addEventListener('click', cerrar);
      modal.addEventListener('click', (e) => { if (e.target === modal) cerrar(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) cerrar(); });

      $('auth-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = $('auth-email').value.trim();
        const err = $('auth-err');
        err.hidden = true;
        if (!email.includes('@')) { err.textContent = 'Poné un email válido.'; err.hidden = false; return; }
        const send = $('auth-send');
        send.disabled = true; send.textContent = 'Enviando…';
        const { error } = await loginEmail(email);
        send.disabled = false; send.textContent = 'Enviar link mágico';
        if (error) { err.textContent = error.message; err.hidden = false; }
        else { $('auth-sent-email').textContent = email; mostrar('sent'); }
      });

      $('auth-logout').addEventListener('click', () => { cerrar(); logout(); });
    }
  </script>

  <slot />

  <script is:inline>
    (function () {
      var body = document.body;
      if (localStorage.getItem('tema') === 'dark') body.classList.add('dark');
      var t = document.getElementById('theme-toggle');
      function refrescar() { if (t) t.textContent = body.classList.contains('dark') ? '☀️' : '🌙'; }
      refrescar();
      if (t) t.addEventListener('click', function () {
        body.classList.toggle('dark');
        localStorage.setItem('tema', body.classList.contains('dark') ? 'dark' : 'claro');
        refrescar();
      });
      var s = document.getElementById('sonido-toggle');
      function rs() { if (s) s.textContent = localStorage.getItem('sonido:off') === '1' ? '🔇' : '🔊'; }
      rs();
      if (s) s.addEventListener('click', function () {
        localStorage.setItem('sonido:off', localStorage.getItem('sonido:off') === '1' ? '0' : '1');
        rs();
      });
    })();
  </script>
</body>
</html>
