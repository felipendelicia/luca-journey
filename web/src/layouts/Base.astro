---
import '../styles/global.css';
import { u } from '../lib/url.ts';
const { title = 'Python con Pokémon', active = '', description } = Astro.props;
const desc = description || 'Aprendé a programar desde cero — Linux y Python — con una aventura Pokémon: ejercicios que se corrigen solos en tu navegador, libro interactivo, Pokédex, batallas y liga. Gratis.';
const ogImg = new URL(u('/og.png'), Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const nav = [
  ['Inicio', '/'],
  ['Libro', '/libro'],
  ['Ejercicios', '/ejercicios'],
  ['Liga', '/liga'],
  ['Amigos', '/amigos'],
  ['Desafíos', '/desafios'],
  ['Pokédex', '/pokedex'],
];
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={desc} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Pokédex Codex — Python con Pokémon" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={desc} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImg} />
  <meta property="og:locale" content="es_AR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={desc} />
  <meta name="twitter:image" content={ogImg} />
  <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
  <link rel="icon" type="image/png" sizes="32x32" href={u('/favicon-32.png')} />
  <link rel="manifest" href={u('/manifest.webmanifest')} />
  <meta name="theme-color" content="#0b150e" />
  <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Pokédex Codex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=Press+Start+2P&family=VT323&family=Silkscreen:wght@400;700&display=swap" />
</head>
<body>
  <div class="bg-grid" aria-hidden="true"></div>

  <div class="boot-overlay" id="boot-overlay">
    <div class="boot-box" id="boot-loader">
      <div class="boot-spin" aria-hidden="true"></div>
      <p>Cargando tu progreso…</p>
    </div>
    <div class="boot-box" id="boot-login" hidden>
      <div class="auth-logo">☁️</div>
      <h2>Entrá para jugar</h2>
      <p>Tu progreso —ejercicios, Pokémon y medallas— se guarda en la nube. Iniciá sesión con Google para empezar. 🔄</p>
      <button type="button" class="btn-google" id="boot-google">
        <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/><path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/><path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/><path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/></svg>
        Entrar con Google
      </button>
      <p class="auth-msg err" id="boot-err" hidden></p>
    </div>
  </div>
  <script is:inline>
    // Si ya se hidrató en esta pestaña, revelar al toque (sin pantalla de carga entre páginas).
    // El cache está vigente y el realtime lo mantiene fresco; el boot igual corre en segundo plano.
    try { if (sessionStorage.getItem('nube:hidratado') === '1') { var _o = document.getElementById('boot-overlay'); if (_o) _o.hidden = true; } } catch (e) {}
  </script>

  <header class="topbar">
    <a class="brand-link" href={u('/')}><span class="pb"></span><span class="brand">Pokédex <b>Codex</b></span></a>
    <div class="tools">
      <nav class="navlinks" id="navlinks">
      {nav.map(([t, h]) => (
        <a class={'navlink' + (t === active ? ' activo' : '')} href={u(h)} data-nav={t}>{t}</a>
      ))}
      </nav>
      <button class="theme-toggle" id="pwa-install" type="button" title="Instalar como app" style="display:none">📲</button>
      <button class="theme-toggle" id="nube-btn" type="button" title="Guardar progreso en la nube" style="display:none">☁️</button>
      <button class="theme-toggle" id="sonido-toggle" type="button" title="Sonido on/off">🔊</button>
      <button class="theme-toggle" id="theme-toggle" type="button" title="Tema claro/oscuro">🌙</button>
      <button class="theme-toggle nav-burger" id="nav-burger" type="button" title="Menú" aria-label="Abrir menú" aria-expanded="false">☰</button>
    </div>
  </header>

  <div class="auth-modal" id="auth-modal" hidden>
    <div class="auth-card">
      <button class="auth-x" id="auth-x" type="button" aria-label="Cerrar">✕</button>
      <div class="auth-logo">☁️</div>
      <div class="auth-pane" id="auth-out">
        <h2>Guardá tu progreso</h2>
        <p>Entrá y llevá tu progreso —ejercicios, medallas y Pokémon— a cualquier dispositivo. 🔄</p>
        <button type="button" class="btn-google" id="auth-google">
          <svg viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/><path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/><path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/><path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571l6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/></svg>
          Entrar con Google
        </button>
        <p class="auth-msg err" id="auth-err" hidden></p>
        <p class="auth-fine">Si tu cuenta ya tiene progreso guardado, se carga ese al entrar.</p>
      </div>
      <div class="auth-pane" id="auth-in" hidden>
        <h2>✅ Sesión iniciada</h2>
        <p>Entraste como <b id="auth-in-email"></b>. Tu progreso se <b>sincroniza solo</b>. 🔄</p>
        <button class="btn-grande sec" id="auth-logout" type="button">Cerrar sesión</button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ base: import.meta.env.BASE_URL }}>window.__BASE = base;</script>

  <script is:inline>
    (function () {
      var base = window.__BASE || '/';
      var esLocal = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
      if ('serviceWorker' in navigator && !esLocal) {
        // si ya había un SW controlando y entra uno nuevo (deploy), recargar UNA vez para
        // tomar el HTML fresco (evita 404 de assets hasheados viejos del HTML cacheado).
        if (navigator.serviceWorker.controller) {
          var recargando = false;
          navigator.serviceWorker.addEventListener('controllerchange', function () {
            if (recargando) return; recargando = true; window.location.reload();
          });
        }
        window.addEventListener('load', function () {
          // updateViaCache:'none' → el browser nunca cachea sw.js (detecta updates al toque)
          navigator.serviceWorker.register(base + 'sw.js', { updateViaCache: 'none' }).then(function (reg) {
            reg.update();
          }).catch(function () {});
        });
      } else if ('serviceWorker' in navigator && esLocal) {
        // en dev el SW estanca el caché (504 Outdated Optimize Dep): desregistrarlo y limpiar sus caches
        navigator.serviceWorker.getRegistrations().then(function (rs) { rs.forEach(function (r) { r.unregister(); }); }).catch(function () {});
        if (window.caches && caches.keys) caches.keys().then(function (ks) { ks.forEach(function (k) { caches.delete(k); }); }).catch(function () {});
      }
      var btn = document.getElementById('pwa-install');
      if (!btn) return;
      var standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
      if (standalone) return;                 // ya está instalada
      var deferred = null;
      window.addEventListener('beforeinstallprompt', function (e) {
        e.preventDefault(); deferred = e; btn.style.display = '';
      });
      var isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
      if (isIOS) btn.style.display = '';       // iOS Safari no dispara el evento
      btn.addEventListener('click', async function () {
        if (deferred) {
          deferred.prompt();
          await deferred.userChoice;
          deferred = null; btn.style.display = 'none';
        } else if (isIOS) {
          alert('Para instalar: tocá el botón Compartir ⬆️ abajo y elegí “Agregar a pantalla de inicio”.');
        }
      });
      window.addEventListener('appinstalled', function () { btn.style.display = 'none'; });
    })();
  </script>

  <script>
    import { init, usuario, loginGoogle, logout } from '../lib/nube.js';
    import { haySupabase } from '../lib/supa.js';
    import { iniciarPresencia } from '../lib/presencia.js';
    const overlay = document.getElementById('boot-overlay');
    if (!haySupabase && overlay) overlay.hidden = true;   // sin Supabase configurado, sin gate (dev)
    const btn = document.getElementById('nube-btn');
    const modal = document.getElementById('auth-modal');
    if (haySupabase && btn && modal) {
      btn.style.display = '';
      init();
      // boot overlay: login obligatorio + esperar a que cargue el progreso
      if (overlay) {
        const bl = document.getElementById('boot-loader'), bi = document.getElementById('boot-login');
        // logueado → loader (hidratando); sin sesión → pantalla de login
        const verBoot = () => { const u = usuario(); if (bl) bl.hidden = !u; if (bi) bi.hidden = !!u; };
        window.addEventListener('nube:listo', () => { overlay.hidden = true; });
        window.addEventListener('nube:sinsesion', verBoot);
        window.addEventListener('nube:cambio', verBoot);
        // failsafe: si está logueado pero el boot no resolvió en 12s, revelar igual (no brickear)
        setTimeout(() => { if (!overlay.hidden && usuario()) overlay.hidden = true; }, 12000);
        const bg = document.getElementById('boot-google');
        if (bg) bg.addEventListener('click', async () => {
          const err = document.getElementById('boot-err'); err.hidden = true; bg.disabled = true;
          const { error } = await loginGoogle();
          if (error) { bg.disabled = false; err.textContent = error.message; err.hidden = false; }
        });
      }

      // presencia global: anunciarse en toda la app + recibir invitaciones de intercambio
      let presIniciada = false;
      const baseP = (window.__BASE || '/').replace(/\/$/, '');
      const avisarInvitacion = (inv) => {
        const d = document.createElement('div'); d.className = 'invite-toast';
        const t = document.createElement('span');
        t.textContent = '🔄 @' + (inv.de || 'alguien') + ' te invita a intercambiar';
        const ok = document.createElement('button'); ok.className = 'ok'; ok.textContent = 'Unirme';
        ok.addEventListener('click', () => { location.href = baseP + '/intercambio?codigo=' + encodeURIComponent(inv.codigo || ''); });
        const x = document.createElement('button'); x.className = 'x'; x.textContent = '✕';
        x.addEventListener('click', () => d.remove());
        d.appendChild(t); d.appendChild(ok); d.appendChild(x);
        document.body.appendChild(d);
        setTimeout(() => d.remove(), 30000);
      };
      const arrancarPresencia = () => {
        if (presIniciada || !usuario()) return;
        presIniciada = true;
        iniciarPresencia(usuario().id, localStorage.getItem('liga:nombre') || '', avisarInvitacion);
      };
      window.addEventListener('nube:cambio', arrancarPresencia);
      arrancarPresencia();

      const $ = (id) => document.getElementById(id);
      const panes = { out: $('auth-out'), in: $('auth-in') };
      const mostrar = (cual) => { for (const k in panes) panes[k].hidden = k !== cual; };

      const atrapados = () => { try { return JSON.parse(localStorage.getItem('col:atrapados')) || {}; } catch { return {}; } };
      const pintarBtn = () => {
        const u = usuario();
        btn.classList.toggle('nube-avatar', false);
        if (!u) { btn.textContent = '☁️'; btn.title = 'Iniciar sesión y guardar progreso'; return; }
        btn.title = `Sesión: ${u.email || ''}`;
        const id = localStorage.getItem('col:avatar');
        if (id && atrapados()[id]) {
          btn.classList.toggle('nube-avatar', true);
          btn.innerHTML = `<img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${id}.png" alt="perfil" />`;
        } else {
          btn.textContent = '👤';
        }
      };
      const cerrar = () => { modal.hidden = true; };
      const abrir = () => {
        const u = usuario();
        if (u) { $('auth-in-email').textContent = u.email || ''; mostrar('in'); }
        else { $('auth-err').hidden = true; mostrar('out'); }
        modal.hidden = false;
      };

      pintarBtn();
      window.addEventListener('nube:cambio', () => {
        pintarBtn();
        if (!modal.hidden && usuario()) { $('auth-in-email').textContent = usuario().email || ''; mostrar('in'); }
      });

      btn.addEventListener('click', abrir);
      $('auth-x').addEventListener('click', cerrar);
      modal.addEventListener('click', (e) => { if (e.target === modal) cerrar(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) cerrar(); });

      $('auth-google').addEventListener('click', async () => {
        const err = $('auth-err'); err.hidden = true;
        const g = $('auth-google'); g.disabled = true;
        const { error } = await loginGoogle();   // si va bien, redirige (cambia de página)
        if (error) { g.disabled = false; err.textContent = error.message; err.hidden = false; }
      });

      $('auth-logout').addEventListener('click', () => { cerrar(); logout(); });
    }
  </script>

  <slot />

  <script>
    import { pendientes, haySupabase } from '../lib/social.js';
    import { usuario } from '../lib/nube.js';
    if (haySupabase) {
      const link = document.querySelector('.navlink[data-nav="Amigos"]');
      const pintar = async () => {
        if (!link) return;
        if (!usuario()) { const b = link.querySelector('.nav-badge'); if (b) b.remove(); return; }
        const n = await pendientes().catch(() => 0);
        let b = link.querySelector('.nav-badge');
        if (n > 0) {
          if (!b) { b = document.createElement('span'); b.className = 'nav-badge'; link.appendChild(b); }
          b.textContent = n;
        } else if (b) { b.remove(); }
      };
      window.addEventListener('nube:listo', pintar);
      window.addEventListener('nube:cambio', pintar);
      setInterval(pintar, 60000);
      pintar();
    }
  </script>

  <script is:inline>
    (function () {
      var body = document.body;
      // por defecto: CRT oscuro. 'claro' = modo claro.
      if (localStorage.getItem('tema') === 'claro') body.classList.add('claro');
      var t = document.getElementById('theme-toggle');
      function refrescar() { if (t) t.textContent = body.classList.contains('claro') ? '🌙' : '☀️'; }
      refrescar();
      if (t) t.addEventListener('click', function () {
        body.classList.toggle('claro');
        localStorage.setItem('tema', body.classList.contains('claro') ? 'claro' : 'oscuro');
        refrescar();
      });
      var s = document.getElementById('sonido-toggle');
      function rs() { if (s) s.textContent = localStorage.getItem('sonido:off') === '1' ? '🔇' : '🔊'; }
      rs();
      if (s) s.addEventListener('click', function () {
        localStorage.setItem('sonido:off', localStorage.getItem('sonido:off') === '1' ? '0' : '1');
        rs();
      });
      // menú mobile (hamburguesa): abre/cierra el panel de navegación
      var burger = document.getElementById('nav-burger'), nlinks = document.getElementById('navlinks');
      if (burger && nlinks) {
        var cerrar = function () { nlinks.classList.remove('abierto'); burger.setAttribute('aria-expanded', 'false'); burger.textContent = '☰'; };
        burger.addEventListener('click', function (e) {
          e.stopPropagation();
          var abierto = nlinks.classList.toggle('abierto');
          burger.setAttribute('aria-expanded', String(abierto));
          burger.textContent = abierto ? '✕' : '☰';
        });
        nlinks.addEventListener('click', function (e) { if (e.target.closest('.navlink')) cerrar(); });
        document.addEventListener('click', function (e) { if (!nlinks.contains(e.target) && e.target !== burger) cerrar(); });
      }
    })();
  </script>
  <script is:inline>
    // Accesibilidad: Escape cierra el modal/overlay visible más reciente (excepto los de batalla).
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var sels = ['.av-modal', '.poke-modal', '.rar-modal'];
      for (var i = 0; i < sels.length; i++) {
        var ab = Array.prototype.filter.call(document.querySelectorAll(sels[i]), function (m) { return !m.hidden; });
        if (ab.length) { ab[ab.length - 1].hidden = true; return; }
      }
    });
  </script>
</body>
</html>
